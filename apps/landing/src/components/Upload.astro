    line-height: 1.15;
  }

  .up__code {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .up__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: paso;
  }

  .up__steps li {
    padding-top: 10px;
    border-top: 4px solid var(--linea);
    color: var(--ink-2);
    font-size: var(--step-small);
    font-weight: 700;
  }

  .up__steps li.is-done {
    border-color: var(--verde);
    color: var(--ink);
  }

  .up__steps li.is-now {
    border-color: var(--ocre);
    color: var(--ink);
  }

  .up__msg {
    margin: 0;
  }

  .up__sample-note {
    margin: 0;
    padding: 6px 10px;
    justify-self: start;
    border-radius: var(--r-s);
    background: var(--ocre-suave);
    font-size: var(--step-small);
    font-weight: 700;
  }

  .up__report {
    display: grid;
    gap: 18px;
  }

  .up__report:empty {
    display: none;
  }

  .up__report :global(h4) {
    margin: 0 0 6px;
    font-size: var(--step-body);
  }

  .up__report :global(.up__ficha) {
    display: grid;
    grid-template-columns: minmax(7.5em, auto) 1fr;
    gap: 8px 16px;
    margin: 0;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--fondo);
  }

  .up__report :global(.up__ficha dt) {
    color: var(--ink-2);
    font-size: var(--step-small);
  }

  .up__report :global(.up__ficha dd) {
    margin: 0;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .up__report :global(.up__quote) {
    margin: 0;
    padding: 12px 14px;
    border-left: 1px solid var(--linea-2);
    background: var(--fondo);
    font-style: italic;
  }

  .up__report :global(ul) {
    display: grid;
    gap: 6px;
    margin: 0;
    padding-left: 1.2em;
  }

  .up__result-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    align-items: center;
  }

  .up__result-actions .btn {
    gap: 10px;
  }

  .up__ghost {
    border: 1.5px solid var(--ink);
    background: none;
    color: var(--ink);
  }

  .up__danger {
    color: var(--alerta);
  }

  /* En el celular, cada dato de la ficha debajo de su nombre. */
  @media (max-width: 519px) {
    .up__report :global(.up__ficha) {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }

    .up__report :global(.up__ficha dd + dt) {
      margin-top: 10px;
    }
  }

  @media (min-width: 720px) {
    .up__sheet {
      padding: 32px 36px;
    }

    .up__more-grid,
    .up__pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 20px;
    }

    .up__field--full {
      grid-column: 1 / -1;
    }
  }

  /* En la computadora, el texto a la izquierda (se queda a la vista) y la hoja del formulario a la derecha. */
  @media (min-width: 1024px) {
    .up__text {
      position: sticky;
      top: 140px;
      grid-column: 1 / 6;
    }

    .up__sheet {
      grid-column: 6 / 13;
    }
  }
</style>

<script>
  import { stripJpegLocation } from "../../../../packages/shared/src/photo-location";

  type Kind = "audio" | "imagen" | "video" | "texto";
  type Item = {
    file: File;
    kind: Kind;
    mime: string;
    key: string;
    /** Las fotos JPG, ya sin la ubicación GPS: esto es lo que se sube. */
    prep?: Promise<Uint8Array<ArrayBuffer>>;
    noLocation?: boolean;
  };
  type Report = {
    case_id: string;
    code: string;
    status: "borrador" | "procesando" | "listo" | "error";
    hallazgos: string[];
    ficha: {
      sector: string | null;
      zona: string | null;
      amenaza: string | null;
      monto_soles: number | null;
      plazo: string | null;
      canal_pago: string | null;
      grupo_que_dice_ser: string | null;
      frases_firma: string[];
      identificadores: { tipo: string; valor: string }[];
      resumen: string | null;
    } | null;
    evidencia: { label: string; tipo: Kind; transcripcion: { text: string }[] | null }[];
    consejos: string[];
  };
  type Cfg = {
    api: string;
    t: {
      files: { remove: string; count: string; noLocation: string; kinds: Record<Kind, string> };
      sample: { loaded: string };
      errors: Record<
        "empty" | "tooMany" | "tooBig" | "badType" | "region" | "address" | "network" | "rateLimited" | "server",
        string
      >;
      progress: { start: string; uploading: string; submitting: string };
      story: { contact: string; since: string };
      contact: Record<string, string>;
      since: Record<string, string>;
      result: {
        code: string;
        processing: string;
        slow: string;
        ready: string;
        failed: string;
        ficha: Record<
          "amenaza" | "monto" | "plazo" | "canal" | "grupo" | "frases" | "zona" | "rubro" | "contactos" | "resumen",
          string
        >;
        transcript: string;
        findings: string;
        advice: string;
        pdf: string;
        pdfLoading: string;
        pdfFail: string;
        remove: string;
        removeConfirm: string;
        removing: string;
        removed: string;
      };
    };
    threats: Record<string, string>;
    sectors: Record<string, string>;
    regions: Record<string, string>;
    zones: Record<string, string>;
    sample: { audio: string; photo: string; text: string };
  };

  /** Lo que delata una dirección en vez de un distrito: calles, manzanas, lotes, números. */
  const ADDRESS = /\d|\b(av|avenida|jr|jir[oó]n|calle|ca|psje|pasaje|mz|manzana|lt|lote|urb|n[°º])\b/i;

  const MAX_FILES = 10;
  const MAX_BYTES = 50 * 1024 * 1024;
  const fill = (s: string, v: Record<string, string | number>) =>
    s.replace(/\{(\w+)\}/g, (m, k: string) => (k in v ? String(v[k]) : m));
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const hex = (buf: ArrayBuffer) => [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, "0")).join("");
  const size = (n: number) =>
    n < 1024 * 1024 ? `${Math.max(1, Math.round(n / 1024))} KB` : `${(n / 1048576).toFixed(1)} MB`;

  /** El tipo de evidencia y el MIME, por el tipo que da el navegador o, si no lo da, por la extensión. */
  const EXT: [RegExp, Kind, string][] = [
    [/\.(opus|ogg|oga)$/i, "audio", "audio/ogg"],
    [/\.m4a$/i, "audio", "audio/mp4"],
    [/\.mp3$/i, "audio", "audio/mpeg"],
    [/\.aac$/i, "audio", "audio/aac"],
    [/\.amr$/i, "audio", "audio/amr"],
    [/\.wav$/i, "audio", "audio/wav"],
    [/\.jpe?g$/i, "imagen", "image/jpeg"],
    [/\.png$/i, "imagen", "image/png"],
    [/\.webp$/i, "imagen", "image/webp"],
    [/\.hei[cf]$/i, "imagen", "image/heic"],
    [/\.mp4$/i, "video", "video/mp4"],
    [/\.3gp$/i, "video", "video/3gpp"],
    [/\.mov$/i, "video", "video/quicktime"],
    [/\.txt$/i, "texto", "text/plain"],
  ];
  const classify = (f: File): { kind: Kind; mime: string } | null => {
    const ty = f.type.toLowerCase();
    if (ty.startsWith("audio/")) return { kind: "audio", mime: ty };
    if (ty.startsWith("image/")) return { kind: "imagen", mime: ty };
    if (ty.startsWith("video/")) return { kind: "video", mime: ty };
    if (ty === "text/plain") return { kind: "texto", mime: ty };
    const hit = EXT.find(([re]) => re.test(f.name));
    return hit ? { kind: hit[1], mime: hit[2] } : null;
  };

  /** Un error que ya sabe qué mensaje mostrar. */
  class UpError extends Error {
    constructor(public key: keyof Cfg["t"]["errors"]) {
      super(key);
    }
  }

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-upload]")) {
    const cfg = JSON.parse(form.dataset.config ?? "{}") as Cfg;
    const T = cfg.t;
    const sheet = form.parentElement!;
    const $ = <E extends Element>(sel: string, root: ParentNode = sheet) => root.querySelector<E>(sel)!;
    const input = $<HTMLInputElement>("[data-files]");
    const drop = $<HTMLElement>("[data-drop]");
    const list = $<HTMLUListElement>("[data-list]");
    const count = $<HTMLElement>("[data-count]");
    const filesErr = $<HTMLElement>("[data-files-err]");
    const pasted = $<HTMLTextAreaElement>("[data-pasted]");
    const narrative = $<HTMLTextAreaElement>("[data-narrative]");
    const region = $<HTMLSelectElement>("[data-region]");
    const regionErr = $<HTMLElement>("[data-region-err]");
    const whereBoxes = [...sheet.querySelectorAll<HTMLElement>("[data-where]")];
    const districtText = $<HTMLInputElement>("[data-district-text]");
    const districtErr = $<HTMLElement>("[data-district-err]");
    const contactBoxes = [...sheet.querySelectorAll<HTMLInputElement>("[data-contact]")];
    const since = $<HTMLSelectElement>("[data-since]");
    const sector = $<HTMLSelectElement>("[data-sector]");
    const consent = $<HTMLInputElement>("[data-consent]");
    const submit = $<HTMLButtonElement>("[data-submit]");
    const bar = $<HTMLElement>("[data-bar]");
    const status = $<HTMLElement>("[data-status]");
    const result = $<HTMLElement>("[data-result]");
    const rCode = $<HTMLElement>("[data-r-code]");
    const rSteps = [...$<HTMLElement>("[data-r-steps]").children] as HTMLElement[];
    const rMsg = $<HTMLElement>("[data-r-msg]");
    const rSample = $<HTMLElement>("[data-r-sample]");
    const rBody = $<HTMLElement>("[data-r-body]");
    const rPdf = $<HTMLButtonElement>("[data-r-pdf]");
    const rAgain = $<HTMLButtonElement>("[data-r-again]");
    const rDelete = $<HTMLButtonElement>("[data-r-delete]");

    let items: Item[] = [];
    let isSample = false;
    let busy = false;
    // La sesión del navegador (solo en memoria) y el caso abierto; lo ya subido no se vuelve a subir.
    let token = "";
    let caseId = "";
    let caseCode = "";
    const sent = new Set<string>();
    let pollRun = 0;

    const say = (msg: string, error = false) => {
      status.textContent = msg;
      status.classList.toggle("is-error", error);
    };
    const showFilesError = (msg: string) => {
      filesErr.textContent = msg;
      filesErr.hidden = !msg;
      drop.classList.toggle("is-invalid", Boolean(msg));
    };
    const showFieldError = (field: HTMLElement, box: HTMLElement, msg: string) => {
      box.textContent = msg;
      box.hidden = !msg;
      if (msg) field.setAttribute("aria-invalid", "true");
      else field.removeAttribute("aria-invalid");
    };

    // ---------- Dónde pasó: la región y, según la región, el distrito ----------
    const districtBox = () => whereBoxes.find((b) => !b.hidden);
    const showWhere = () => {
      const r = region.value;
      const which = r === "lima-metropolitana" || r === "callao" ? r : r && r !== "none" ? "other" : "";
      for (const b of whereBoxes) b.hidden = b.dataset.where !== which;
    };
    region.addEventListener("change", () => {
      showWhere();
      if (region.value) showFieldError(region, regionErr, "");
    });
    districtText.addEventListener("input", () => showFieldError(districtText, districtErr, ""));
    /**
     * La zona del caso: el id del distrito en Lima y el Callao; fuera de Lima, "Distrito, Región" en
     * texto (la API lo guarda tal cual). Solo la región si no dijo el distrito; nada si prefiere no decirlo.
     */
    const zone = () => {
      const r = region.value;
      if (!r || r === "none") return "";
      const box = districtBox();
      if (box?.dataset.where === "other") {
        const place = districtText.value.replace(/\s+-\s+|\s+/g, " ").trim();
        return place ? `${place}, ${cfg.regions[r]}` : cfg.regions[r]!;
      }
      const id = box?.querySelector<HTMLSelectElement>("[data-district]")?.value;
      // "Callao" a secas es también un distrito: la región va con su nombre completo.
      return id || (r === "callao" ? "Región Callao" : cfg.regions[r]!);
    };

    // ---------- Los archivos elegidos ----------
    const render = () => {
      list.replaceChildren(
        ...items.map((it, i) => {
          const li = document.createElement("li");
          li.className = "up__item";
          if (sent.has(it.key)) li.classList.add("is-done");
          const kind = document.createElement("span");
          kind.className = "up__kind";
          kind.dataset.kind = it.kind;
          kind.textContent = T.files.kinds[it.kind];
          const name = document.createElement("span");
          name.className = "up__name";
          name.textContent = it.file.name;
          const sz = document.createElement("span");
          sz.className = "up__size";
          sz.textContent = it.noLocation ? `${size(it.file.size)}, ${T.files.noLocation}` : size(it.file.size);
          name.append(sz);
          li.append(kind, name);
          if (sent.has(it.key)) {
            const ok = document.createElement("span");
            ok.className = "up__item-ok";
            ok.innerHTML =
              '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
            li.append(ok);
          } else {
            const rm = document.createElement("button");
            rm.type = "button";
            rm.className = "up__remove";
            rm.setAttribute("aria-label", fill(T.files.remove, { name: it.file.name }));
            rm.innerHTML =
              '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg>';
            rm.addEventListener("click", () => {
              items.splice(i, 1);
              render();
              (
                list.querySelector<HTMLButtonElement>(".up__remove") ?? (input.previousElementSibling as HTMLElement)
              )?.focus();
            });
            li.append(rm);
          }
          return li;
        }),
      );
      count.hidden = items.length === 0;
      count.textContent = fill(T.files.count, { n: items.length });
    };
    const add = (files: Iterable<File>) => {
      let problem = "";
      for (const f of files) {
        if (items.length >= MAX_FILES) {
          problem = T.errors.tooMany;
          break;
        }
        const c = classify(f);
        if (!c) {
          problem = fill(T.errors.badType, { name: f.name });
          continue;
        }
        if (f.size > MAX_BYTES) {
          problem = fill(T.errors.tooBig, { name: f.name });
          continue;
        }
        const key = `${f.name}:${f.size}:${f.lastModified}`;
        if (items.some((x) => x.key === key)) continue;
        const it: Item = { file: f, kind: c.kind, mime: c.mime, key };
        // Las fotos JPG del celular guardan dónde se tomaron: se borra antes de subir nada.
        if (c.mime === "image/jpeg" || c.mime === "image/jpg") {
          const prep = f.arrayBuffer().then((buf) => {
            const out = stripJpegLocation(new Uint8Array(buf));
            if (out.removed) {
              it.noLocation = true;
              if (items.includes(it)) render();
            }
            return out.bytes;
          });
          prep.catch(() => {}); // si falla, el error sale al subir
          it.prep = prep;
        }
        items.push(it);
      }
      showFilesError(problem);
      render();
    };

    $<HTMLButtonElement>("[data-choose]").addEventListener("click", () => input.click());
    input.addEventListener("change", () => {
      if (input.files) add(input.files);
      input.value = "";
    });
    for (const ev of ["dragenter", "dragover"])
      drop.addEventListener(ev, (e) => {
        e.preventDefault();
        drop.classList.add("is-over");
      });
    for (const ev of ["dragleave", "drop"]) drop.addEventListener(ev, () => drop.classList.remove("is-over"));
    drop.addEventListener("drop", (e) => {
      e.preventDefault();
      if (e.dataTransfer?.files.length) add(e.dataTransfer.files);
    });

    // ---------- El caso de ejemplo (ficticio) ----------
    $<HTMLButtonElement>("[data-sample]").addEventListener("click", async () => {
      try {
        const [a, p] = await Promise.all([fetch(cfg.sample.audio), fetch(cfg.sample.photo)]);
        if (!a.ok || !p.ok) throw new Error("sample");
        const audio = new File([await a.blob()], "audio-caso-A.m4a", { type: "audio/mp4" });
        const photo = new File([await p.blob()], "foto-caso-A.jpg", { type: "image/jpeg" });
        items = items.filter((x) => !x.key.includes("caso-A"));
        add([audio, photo]);
        if (!pasted.value.trim()) pasted.value = cfg.sample.text;
        // El caso A es una bodega de San Juan de Lurigancho.
        if (!region.value) {
          region.value = "lima-metropolitana";
          region.dispatchEvent(new Event("change"));
          $<HTMLSelectElement>("#up-district-lima").value = "san-juan-de-lurigancho";
        }
        if (!sector.value) sector.value = "bodega";
        isSample = true;
        say(T.sample.loaded);
      } catch {
        say(T.errors.network, true);
      }
    });

    // ---------- La API ----------
    const call = async (path: string, init: RequestInit = {}) => {
      let res: Response;
      try {
        res = await fetch(cfg.api + path, init);
      } catch {
        throw new UpError("network");
      }
      if (res.status === 429) throw new UpError("rateLimited");
      if (res.status === 413) throw new UpError("tooBig");
      if (!res.ok) throw new UpError("server");
      return res;
    };
    const auth = () => ({ authorization: `Bearer ${token}` });

    const register = async () => {
      const keys = await crypto.subtle.generateKey({ name: "ECDSA", namedCurve: "P-256" }, true, ["sign", "verify"]);
      const jwk = await crypto.subtle.exportKey("jwk", keys.publicKey);
      const res = await call("/v1/auth/device/register", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ public_key: { kty: "EC", crv: "P-256", x: jwk.x, y: jwk.y }, platform: "web" }),
      });
      token = ((await res.json()) as { access_token: string }).access_token;
    };
    const openCase = async () => {
      const body: Record<string, string> = { consent_mode: consent.checked ? "comunitario" : "solo_denuncia" };
      const zona = zone();
      if (zona) body.zona = zona;
      if (sector.value) body.sector = sector.value;
      const res = await call("/v1/cases", {
        method: "POST",
        headers: { ...auth(), "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      const cs = (await res.json()) as { id: string; code: string };
      caseId = cs.id;
      caseCode = cs.code;
    };
    const upload = async (
      bytes: Uint8Array<ArrayBuffer>,
      kind: Kind,
      mime: string,
      source: string,
      capturedAt?: number,
    ) => {
      const headers: Record<string, string> = {
        ...auth(),
        "content-type": mime,
        "x-evidence-type": kind,
        "x-content-sha256": hex(await crypto.subtle.digest("SHA-256", bytes)),
        "x-source": source,
      };
      if (capturedAt) headers["x-captured-at"] = new Date(capturedAt).toISOString();
      await call(`/v1/cases/${caseId}/evidence`, { method: "POST", headers, body: bytes });
    };

    const progress = (done: number, total: number) => {
      bar.hidden = false;
      bar.style.setProperty("--p", String(total ? done / total : 0));
    };
    const setBusy = (on: boolean) => {
      busy = on;
      submit.setAttribute("aria-disabled", String(on));
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (busy) return;
      const text = pasted.value.trim();
      // Todo lo que falta a la vez, y el foco en lo primero.
      const invalid: HTMLElement[] = [];
      const noFiles = !items.length && !text;
      showFilesError(noFiles ? T.errors.empty : "");
      if (noFiles) invalid.push($<HTMLButtonElement>("[data-choose]"));
      showFieldError(region, regionErr, region.value ? "" : T.errors.region);
      if (!region.value) invalid.push(region);
      const looksLikeAddress = !districtText.closest("[hidden]") && ADDRESS.test(districtText.value);
      showFieldError(districtText, districtErr, looksLikeAddress ? T.errors.address : "");
      if (looksLikeAddress) invalid.push(districtText);
      if (invalid.length) {
        invalid[0]!.focus();
        return;
      }
      setBusy(true);
      const steps = items.length + (text ? 1 : 0) + 1;
      let done = 0;
      try {
        say(T.progress.start);
        progress(0, steps);
        if (!token) await register();
        if (!caseId) await openCase();
        for (const [i, it] of items.entries()) {
          if (sent.has(it.key)) {
            progress(++done, steps);
            continue;
          }
          say(fill(T.progress.uploading, { n: i + 1, total: items.length, name: it.file.name }));
          await upload(
            it.prep ? await it.prep : new Uint8Array(await it.file.arrayBuffer()),
            it.kind,
            it.mime,
            it.kind === "imagen" ? "galeria" : "compartido",
            it.file.lastModified,
          );
          sent.add(it.key);
          render();
          progress(++done, steps);
        }
        if (text && !sent.has(`pegado:${text}`)) {
          await upload(new TextEncoder().encode(text), "texto", "text/plain; charset=utf-8", "pegado", Date.now());
          sent.add(`pegado:${text}`);
        }
        progress(++done, steps);
        say(T.progress.submitting);
        // El relato, con lo que marcó arriba (cómo la contactaron, cuándo empezó) delante.
        const midSentence = (s: string) =>
          /^(WhatsApp|[A-Z]{2,})/.test(s) ? s : s.charAt(0).toLowerCase() + s.slice(1);
        const channels = contactBoxes.filter((x) => x.checked).map((x) => midSentence(T.contact[x.value]!));
        const story = [
          channels.length ? fill(T.story.contact, { list: channels.join(", ") }) : "",
          since.value ? fill(T.story.since, { when: T.since[since.value]!.toLowerCase() }) : "",
          narrative.value.trim(),
        ]
          .filter(Boolean)
          .join("\n\n");
        await call(`/v1/cases/${caseId}/submit`, {
          method: "POST",
          headers: { ...auth(), "content-type": "application/json" },
          body: JSON.stringify(story ? { narrative: story } : {}),
        });
        progress(steps, steps);
        showResult();
      } catch (err) {
        say(T.errors[err instanceof UpError ? err.key : "server"], true);
      } finally {
        setBusy(false);
      }
    });

    // ---------- El resultado: el reporte propio, cuando la IA termina ----------
    const step = (n: number) =>
      rSteps.forEach((li, i) => {
        li.classList.toggle("is-done", i < n);
        li.classList.toggle("is-now", i === n);
      });
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, text?: string, cls?: string) => {
      const x = document.createElement(tag);
      if (text !== undefined) x.textContent = text;
      if (cls) x.className = cls;
      return x;
    };
    const block = (title: string, ...children: Node[]) => {
      const div = el("div");
      div.append(el("h4", title), ...children);
      return div;
    };
    const renderReport = (r: Report) => {
      const R = T.result;
      const parts: Node[] = [];
      const f = r.ficha;
      if (f) {
        const dl = el("dl", undefined, "up__ficha");
        const row = (k: string, v: string | null | undefined) => {
          if (!v) return;
          dl.append(el("dt", k), el("dd", v));
        };
        row(R.ficha.amenaza, f.amenaza ? (cfg.threats[f.amenaza] ?? f.amenaza.replace(/_/g, " ")) : null);
        row(R.ficha.monto, f.monto_soles ? `S/ ${f.monto_soles.toLocaleString("en-US")}` : null);
        row(R.ficha.plazo, f.plazo);
        row(R.ficha.canal, f.canal_pago ? f.canal_pago.charAt(0).toUpperCase() + f.canal_pago.slice(1) : null);
        row(R.ficha.grupo, f.grupo_que_dice_ser);
        row(R.ficha.frases, f.frases_firma.length ? f.frases_firma.map((x) => `«${x}»`).join("  ") : null);
        row(R.ficha.contactos, f.identificadores.map((x) => x.valor).join(", ") || null);
        row(R.ficha.zona, f.zona ? (cfg.zones[f.zona] ?? f.zona) : null);
        row(R.ficha.rubro, f.sector ? (cfg.sectors[f.sector] ?? f.sector) : null);
        row(R.ficha.resumen, f.resumen);
        if (dl.childElementCount) parts.push(dl);
      }
      // Solo audios y videos: el texto pegado ya lo escribió la persona.
      for (const ev of r.evidencia
        .filter((x) => (x.tipo === "audio" || x.tipo === "video") && x.transcripcion?.length)
        .slice(0, 3)) {
        const said = ev.transcripcion!.map((x) => x.text.trim()).join(" ");
        parts.push(block(fill(R.transcript, { label: ev.label }), el("blockquote", `«${said}»`, "up__quote")));
      }
      if (r.hallazgos.length) {
        const ul = el("ul");
        ul.append(...r.hallazgos.map((x) => el("li", x)));
        parts.push(block(R.findings, ul));
      }
      if (r.consejos.length) {
        const ul = el("ul");
        ul.append(...r.consejos.map((x) => el("li", x)));
        parts.push(block(R.advice, ul));
      }
      rBody.replaceChildren(...parts);
    };
    const poll = async () => {
      const run = ++pollRun;
      const t0 = Date.now();
      while (Date.now() - t0 < 5 * 60_000) {
        await sleep(4000);
        if (run !== pollRun) return;
        let r: Report;
        try {
          r = (await (await call(`/v1/cases/${caseId}/report`, { headers: auth() })).json()) as Report;
        } catch {
          continue;
        }
        if (run !== pollRun) return;
        if (r.status === "listo") {
          step(3);
          rMsg.textContent = T.result.ready;
          renderReport(r);
          rPdf.hidden = false;
          return;
        }
        if (r.status === "error") {
          step(1);
          rMsg.textContent = fill(T.result.failed, { code: caseCode });
          return;
        }
      }
      if (run === pollRun) rMsg.textContent = fill(T.result.slow, { code: caseCode });
    };
    const showResult = () => {
      form.hidden = true;
      result.hidden = false;
      rCode.textContent = fill(T.result.code, { code: caseCode });
      rSample.hidden = !isSample;
      rBody.replaceChildren();
      rPdf.hidden = true;
      rDelete.hidden = false;
      rDelete.textContent = T.result.remove;
      delete rDelete.dataset.armed;
      step(1);
      rMsg.textContent = T.result.processing;
      result.focus();
      void poll();
    };

    rPdf.addEventListener("click", async () => {
      const label = rPdf.querySelector("span")!;
      label.textContent = T.result.pdfLoading;
      rPdf.setAttribute("aria-disabled", "true");
      try {
        const res = await call(`/v1/cases/${caseId}/report.pdf`, { headers: auth() });
        const url = URL.createObjectURL(await res.blob());
        const a = document.createElement("a");
        a.href = url;
        a.download = `denuncia-${caseCode}.pdf`;
        document.body.append(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 10_000);
        label.textContent = T.result.pdf;
      } catch {
        label.textContent = T.result.pdfFail;
      } finally {
        rPdf.removeAttribute("aria-disabled");
      }
    });

    const reset = () => {
      pollRun++;
      items = [];
      sent.clear();
      caseId = "";
      caseCode = "";
      isSample = false;
      pasted.value = "";
      narrative.value = "";
      // Lo del caso se limpia; la región, el distrito y el rubro se quedan (suele ser la misma persona).
      for (const x of contactBoxes) x.checked = false;
      since.value = "";
      bar.hidden = true;
      bar.style.setProperty("--p", "0");
      say("");
      render();
      result.hidden = true;
      form.hidden = false;
      $<HTMLButtonElement>("[data-choose]").focus();
    };
    rAgain.addEventListener("click", reset);

    // Borrar: el primer toque pide confirmar; el segundo borra el caso y todos sus archivos.
    rDelete.addEventListener("click", async () => {
      if (!rDelete.dataset.armed) {
        rDelete.dataset.armed = "1";
        rDelete.textContent = T.result.removeConfirm;
        return;
      }
      if (rDelete.getAttribute("aria-disabled") === "true") return;
      rDelete.setAttribute("aria-disabled", "true");
      rMsg.textContent = T.result.removing;
      try {
        await call(`/v1/cases/${caseId}`, { method: "DELETE", headers: auth() });
        pollRun++;
        rBody.replaceChildren();
        rPdf.hidden = true;
        rDelete.hidden = true;
        rSample.hidden = true;
        step(0);
        rMsg.textContent = T.result.removed;
        caseId = "";
      } catch (err) {
        rMsg.textContent = T.errors[err instanceof UpError ? err.key : "server"];
      } finally {
        rDelete.removeAttribute("aria-disabled");
      }
    });
  }
</script>
