  .up__link {
    min-height: 40px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--terracota-2);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }

  .up__link:hover {
