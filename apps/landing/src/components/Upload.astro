  }

  .up__noscript {
    margin: 0;
    font-weight: 700;
  }

  .up__actions {
    display: grid;
    gap: 10px;
  }

  .up__actions .btn {
    width: 100%;
    gap: 10px;
  }

  .up__actions :global(.icon),
  .up__result-actions :global(.icon) {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .up__actions .btn[aria-disabled="true"] {
    cursor: progress;
  }

  /* El avance de la subida: una barra terracota que crece con cada archivo. */
  .up__bar {
    height: 6px;
    overflow: hidden;
    border-radius: 3px;
    background: var(--linea);
  }

  .up__bar span {
    display: block;
    height: 100%;
    background: var(--terracota);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }

  .up__status:empty {
    display: none;
  }

  .up__status {
    padding: 10px 14px;
    border-radius: var(--r-s);
    background: var(--fondo-2);
    color: var(--ink);
  }

  .up__status.is-error {
    background: var(--alerta-suave);
    color: var(--alerta);
    font-weight: 700;
  }

  /* ---------- El resultado ---------- */
  .up__result {
    display: grid;
    gap: 16px;
  }

  .up__result:focus {
    outline: none;
  }

  .up__result-title {
    margin: 0;
