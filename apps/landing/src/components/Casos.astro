---
/**
 * Los casos: tres celulares con lo que recibió cada víctima ficticia del demo (casos A, B y C de
 * eval/demo): audios que se pueden escuchar, la foto de la bala y los mensajes que piden Yape. Primero
 * llegan los mensajes, uno por uno; después Blindaje marca lo que tienen en común: la misma voz en A y
 * B (coseno real 0.79, el del índice de voces de Flow.astro), la misma cuenta en B y C, lo que lee Muse
 * Spark y lo que encuentra SAM. En pantallas anchas, una línea une los mensajes que coinciden.
 * Debajo, las cifras reales: no son tres casos, son miles.
 *
 * Datos: src/data/casos-demo.json y public/casos/*.m4a (eval/py/blindaje_eval/casos_landing.py).
 * Sin JavaScript o con movimiento reducido, todo se ve completo y marcado desde el principio. El texto
 * nunca se atenúa: los mensajes aparecen con visibility y transform.
 */
import { Image } from "astro:assets";
import type { Dict } from "../i18n";
import casos from "../data/casos-demo.json";
import indice from "../data/flujo-vectores.json";
import foto from "../assets/casos/foto-A.jpg";
import { DISTRICTS } from "../../../../packages/shared/src/zones";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const c = d.lp.cases;
const p = d.problem;
const es = d.lang === "es";
const newTab = es ? " (se abre en otra pestaña)" : " (opens in a new tab)";

const fill = (s: string, t: Record<string, string | number>) =>
  s.replace(/\{(\w+)\}/g, (m, k: string) => (k in t ? String(t[k]) : m));
const zona = (id: string) => DISTRICTS.find((x) => x.id === id)?.name ?? id;
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, "0")}`;
const cosAB = (indice.indice.find((x) => x.caso_a)?.coseno ?? 0).toFixed(2);
const CUENTA = "900 000 202";

/** Lo que Blindaje marca en cada pieza (el tipo de coincidencia y su texto). */
type Tag = { kind: "voz" | "id" | "frase" | "img" | "none"; text: string; link?: string };
const tagFor = (caso: string, tipo: string): Tag | null => {
  if (tipo === "audio") {
    if (caso === "A") return { kind: "voz", text: fill(c.tags.voice, { k: "B", cos: cosAB }), link: "voz" };
    if (caso === "B") return { kind: "voz", text: fill(c.tags.voice, { k: "A", cos: cosAB }), link: "voz" };
    return { kind: "none", text: c.tags.otherVoice };
  }
  if (tipo === "texto") {
    if (caso === "A") return { kind: "frase", text: c.tags.spark };
    if (caso === "B") return { kind: "id", text: fill(c.tags.account, { k: "C" }), link: "cuenta" };
    return { kind: "id", text: fill(c.tags.account, { k: "B" }), link: "cuenta" };
  }
  return { kind: "img", text: c.tags.sam };
};

/** El texto del mensaje con lo que coincide marcado: la cuenta compartida y la firma del grupo. */
const parts = (caso: string, texto: string) => {
  const mark = caso === "A" ? "Los X" : CUENTA;
  const i = texto.indexOf(mark);
  if (i < 0) return [{ t: texto, m: false }];
  return [
    { t: texto.slice(0, i), m: false },
    { t: mark, m: true },
    { t: texto.slice(i + mark.length), m: false },
  ];
};

/** Una pieza del chat: audio (con su onda), texto o imagen. */
type Pieza = {
  tipo: "audio" | "texto" | "imagen";
  dia: number;
  hora: string;
  id?: string;
  segundos?: number;
  onda?: number[];
  texto?: string;
};
const phones = casos.casos.map((caso) => {
  let lastDay = -1;
  const items = (caso.piezas as Pieza[]).flatMap((pz) => {
    const out: ({ day: number } | { pz: Pieza; tag: Tag | null })[] = [];
    if (pz.dia !== lastDay) {
      out.push({ day: pz.dia });
      lastDay = pz.dia;
    }
    out.push({ pz, tag: tagFor(caso.caso, pz.tipo) });
    return out;
  });
  return { caso, items };
});

/** Orden de llegada de todos los mensajes (del más antiguo al más nuevo), para la animación. */
const order = casos.casos
  .flatMap((caso) => caso.piezas.map((pz, i) => ({ id: `${caso.caso}${i}`, dia: pz.dia, hora: pz.hora })))
  .sort((a, b) => b.dia - a.dia || a.hora.localeCompare(b.hora))
  .map((x) => x.id);
---

<section class="section cs-sec" id="casos" aria-labelledby="casos-title">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <h2 id="casos-title" class="head">
        {c.title}
      </h2>
      <p class="lead soft">{c.lead}</p>
    </div>

    <div class="cs" data-casos data-order={order.join(",")}>
      <ol class="cs__phones hs" role="list" aria-label={c.phonesLabel} data-phones>
        {phones.map(({ caso, items }) => (
          <li class="cs__case">
            <p class="cs__who">
              <strong>{fill(c.caseLabel, { k: caso.caso })}</strong>
              <span>
                {c.sectors[caso.sector] ?? caso.sector}, {zona(caso.zona)}
              </span>
            </p>
            <div class="cs__phone">
              <div class="cs__bar">
                <span class="cs__avatar" aria-hidden="true">
                  ?
                </span>
                <span class="cs__from">
                  <strong class="num">{caso.contacto}</strong>
                  <span>{c.unknown}</span>
                </span>
              </div>
              <ol class="cs__chat" role="list" lang="es">
                {items.map((it) =>
                  "day" in it ? (
                    <li class="cs__day" lang={d.htmlLang}>
                      {fill(c.daysAgo, { n: it.day })}
                    </li>
                  ) : (
                    <li
                      class:list={["cs__msg", `cs__msg--${it.pz.tipo}`]}
                      data-msg={`${caso.caso}${(caso.piezas as Pieza[]).indexOf(it.pz)}`}
                    >
                      {it.pz.tipo === "audio" && it.pz.id && it.pz.onda && it.pz.segundos && (
                        <div class="cs__audio">
                          <button
                            type="button"
                            class="cs__play"
                            data-play={`${it.pz.id}`}
                            aria-pressed="false"
                            lang={d.htmlLang}
                          >
                            <Icon name="play" class="icon cs__icon cs__icon--play" />
                            <Icon name="pause" class="icon cs__icon cs__icon--pause" />
                            <span class="sr-only">
                              {fill(c.listen, { k: caso.caso, s: Math.round(it.pz.segundos) })}
                            </span>
                          </button>
                          <span class="cs__wave" aria-hidden="true">
                            {it.pz.onda.map((h, j) => (
                              <span style={`--h:${Math.max(0.12, h)};--j:${j}`} />
                            ))}
                          </span>
                          <span class="cs__dur num">{mmss(it.pz.segundos)}</span>
                          <audio preload="none" src={`/casos/${it.pz.id.toLowerCase()}.m4a`} data-audio={it.pz.id} />
                        </div>
                      )}
                      {it.pz.tipo === "texto" && it.pz.texto && (
                        <p class="cs__text">
                          {parts(caso.caso, it.pz.texto).map((x) =>
                            x.m ? (
                              <mark class={`cs__mark cs__mark--${caso.caso === "A" ? "frase" : "id"}`}>{x.t}</mark>
                            ) : (
                              x.t
                            ),
                          )}
                        </p>
                      )}
                      {it.pz.tipo === "imagen" && (
                        <Image
                          class="cs__img"
                          src={foto}
                          alt={c.photoAlt}
                          widths={[280, 560]}
                          sizes="280px"
                          lang={d.htmlLang}
                        />
                      )}
                      <time class="cs__time num">{it.pz.hora}</time>
                      {it.tag && (
                        <span class={`cs__tag cs__tag--${it.tag.kind}`} lang={d.htmlLang} data-link={it.tag.link}>
                          {it.tag.text}
                        </span>
                      )}
                    </li>
                  ),
                )}
              </ol>
            </div>
          </li>
        ))}
      </ol>
      <svg class="cs__links" aria-hidden="true" data-links>
        <path class="cs__link cs__link--voz" data-path="voz" />
        <path class="cs__link cs__link--id" data-path="cuenta" />
      </svg>

      <div class="cs__now">
        <div class="cs__caps" aria-hidden="true">
          {c.steps.map((s, i) => (
            <p class:list={["cs__cap", i === c.steps.length - 1 && "is-on"]} data-cap>
              <span class="cs__cap-n num">{i + 1}</span>
              {s}
            </p>
          ))}
        </div>
        <button type="button" class="cs__replay" data-replay>
          <Icon name="restart" />
          {c.replay}
        </button>
      </div>
      <p class="cs__verdict">{c.verdict}</p>
    </div>

    <div class="cs-scale">
      <h3 class="cs-scale__title">{c.scaleTitle}</h3>
      <ul class="cs-scale__figs hs" role="list" aria-label={c.scaleTitle}>
        {p.figures.slice(0, 3).map((f) => (
          <li>
            <span class="cs-scale__value num">{f.value}</span>
            <p class="cs-scale__text">{f.text}</p>
            <a class="cs-scale__src small" href={f.source.url} rel="noopener noreferrer" target="_blank">
              {p.sourcePrefix} {f.source.name}
              <Icon name="external" />
              <span class="sr-only">{newTab}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="cap">{c.note}</p>
    </div>
  </div>
</section>

<style>
  .cs-sec {
    --voz-c: #c59711;
    --voz-t: #f8eed8;
    --voz-b: #815d00;
    --id-c: #21763c;
    --id-t: #e3f4e5;
    --id-b: #045725;
    --frase-t: #fbe8f4;
    --frase-b: #793d67;
    --img-t: #e3f0fd;
    --img-b: #003860;
  }

  .cs {
    position: relative;
    display: grid;
    gap: 18px;
  }

  /* ---------- Los tres celulares ---------- */

  .cs__phones {
    display: grid;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cs__case {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 10px;
    min-width: 0;
  }

  .cs__who {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    margin: 0;
  }

  .cs__who span {
    color: var(--ink-2);
    font-size: var(--step-small);
  }

  .cs__phone {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border: 7px solid var(--noche);
    border-radius: 30px;
    background: var(--fondo-2);
    box-shadow: var(--sombra-2);
  }

  .cs__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 12px;
    background: var(--noche);
    color: var(--fondo);
  }

  .cs__avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #5b4a3f;
    font-weight: 700;
  }

  .cs__from {
    display: grid;
    line-height: 1.25;
  }

  .cs__from span {
    color: var(--claro-tenue);
    font-size: 0.8125rem;
  }

  .cs__chat {
    display: grid;
    align-content: start;
    gap: 8px;
    height: 100%;
    margin: 0;
    padding: 12px 10px 16px;
    list-style: none;
  }

  .cs__day {
    justify-self: center;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--papel);
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .cs__msg {
    position: relative;
    display: grid;
    gap: 4px;
    justify-self: start;
    width: fit-content;
    max-width: 92%;
    padding: 8px 10px 6px;
    border: 1px solid var(--linea);
    border-radius: 4px 14px 14px 14px;
    background: var(--papel);
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }

  .cs__msg--audio {
    width: 92%;
  }

  .cs__msg--imagen {
    padding: 4px 4px 6px;
  }

  .cs__text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .cs__time {
    justify-self: end;
    color: var(--ink-2);
    font-size: 0.6875rem;
  }

  .cs__img {
    display: block;
    width: 100%;
    max-width: 210px;
    height: auto;
    border-radius: 10px;
  }

  /* El audio: botón, onda (las barras ya escuchadas se pintan) y duración. */
  .cs__audio {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
  }

  .cs__play {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--noche);
    color: var(--fondo);
    cursor: pointer;
  }

  .cs__play:focus-visible {
    outline: 3px solid var(--terracota);
    outline-offset: 2px;
  }

  .cs__play :global(.icon) {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cs__play :global(.cs__icon--pause),
  .cs__play[aria-pressed="true"] :global(.cs__icon--play) {
    display: none;
  }

  .cs__play[aria-pressed="true"] :global(.cs__icon--pause) {
    display: block;
  }

  .cs__wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 30px;
  }

  .cs__wave span {
    flex: 1;
    height: calc(var(--h) * 100%);
    min-width: 2px;
    border-radius: 2px;
    background: var(--linea-2);
  }

  .cs__dur {
    color: var(--ink-2);
    font-size: 0.75rem;
  }

  /* Lo que Blindaje marca. */
  .cs__tag {
    justify-self: start;
    margin-top: 2px;
    padding: 2px 8px;
    border: 1px solid var(--linea-2);
    border-radius: 6px;
    background: var(--fondo-2);
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .cs__tag--voz {
    border-color: var(--voz-b);
    background: var(--voz-t);
    color: var(--voz-b);
  }

  .cs__tag--id {
    border-color: var(--id-b);
    background: var(--id-t);
    color: var(--id-b);
  }

  .cs__tag--frase {
    border-color: var(--frase-b);
    background: var(--frase-t);
    color: var(--frase-b);
  }

  .cs__tag--img {
    border-color: var(--img-b);
    background: var(--img-t);
    color: var(--img-b);
  }

  .cs__mark {
    padding: 0 2px;
    border-radius: 3px;
    background: none;
    color: inherit;
    font-weight: 700;
    transition: background-color 0.3s;
  }

  .cs:not(.is-armed) .cs__mark--id,
  .cs.is-found .cs__mark--id {
    background: var(--id-t);
    box-shadow: 0 0 0 1px var(--id-b);
  }

  .cs:not(.is-armed) .cs__mark--frase,
  .cs.is-found .cs__mark--frase {
    background: var(--frase-t);
    box-shadow: 0 0 0 1px var(--frase-b);
  }

  /* Los mensajes que coinciden se marcan con el color de su señal. */
  .cs:not(.is-armed) .cs__msg:has(.cs__tag--voz),
  .cs.is-found .cs__msg:has(.cs__tag--voz) {
    border-color: var(--voz-b);
    box-shadow: 0 0 0 2px var(--voz-t);
  }

  .cs:not(.is-armed) .cs__msg:has(.cs__tag--id),
  .cs.is-found .cs__msg:has(.cs__tag--id) {
    border-color: var(--id-b);
    box-shadow: 0 0 0 2px var(--id-t);
  }

  /* ---------- La animación ---------- */

  /* Armado: los mensajes y las marcas esperan ocultos (visibility, nunca opacidad sobre el texto). */
  .cs.is-armed .cs__msg {
    visibility: hidden;
    transform: translateY(12px) scale(0.96);
  }

  .cs.is-armed .cs__msg.is-in {
    visibility: visible;
    transform: none;
    transition: transform 0.45s cubic-bezier(0.2, 0.9, 0.25, 1.15);
  }

  .cs.is-armed .cs__day {
    visibility: hidden;
  }

  .cs.is-armed .cs__day.is-in {
    visibility: visible;
  }

  .cs.is-armed .cs__tag {
    visibility: hidden;
    transform: translateY(-4px);
  }

  .cs.is-armed.is-found .cs__tag {
    visibility: visible;
    transform: none;
    transition: transform 0.4s cubic-bezier(0.2, 0.9, 0.25, 1.15);
    transition-delay: calc(var(--k, 0) * 120ms);
  }

  /* Blindaje revisa: una luz recorre cada celular de arriba abajo. */
  .cs__phone {
    position: relative;
  }

  .cs__phone::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, rgb(231 173 69 / 0.28) 48%, transparent 52%);
    background-size: 100% 260%;
    background-position: 0 100%;
    opacity: 0;
    pointer-events: none;
  }

  .cs.is-scan .cs__phone::after {
    animation: cs-scan 1.1s ease-in-out;
  }

  @keyframes cs-scan {
    0% {
      background-position: 0 100%;
      opacity: 1;
    }

    100% {
      background-position: 0 0%;
      opacity: 1;
    }
  }

  /* Las líneas entre celulares (solo con los tres a la vista). */
  .cs__links {
    display: none;
  }

  .cs__link {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .cs__link--voz {
    stroke: var(--voz-c);
  }

  .cs__link--id {
    stroke: var(--id-c);
  }

  .cs.is-armed .cs__link {
    stroke-dasharray: var(--len, 1000);
    stroke-dashoffset: var(--len, 1000);
  }

  .cs.is-armed.is-found .cs__link {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.9s ease-in-out 0.35s;
  }

  /* El texto de cada momento y volver a ver. */
  .cs__now {
    display: none;
  }

  :global(.js) .cs__now {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
  }

  .cs__caps {
    display: grid;
    flex: 1 1 26rem;
  }

  .cs__cap {
    display: flex;
    gap: 10px;
    grid-area: 1 / 1;
    margin: 0;
    font-weight: 700;
    visibility: hidden;
  }

  .cs__cap.is-on {
    visibility: visible;
  }

  .cs__cap-n {
    flex: none;
    color: var(--terracota);
  }

  .cs__replay {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--linea-2);
    border-radius: 999px;
    background: var(--papel);
    color: var(--tinta);
    font: inherit;
    font-size: var(--step-small);
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    visibility: hidden;
  }

  .cs__replay.is-on {
    visibility: visible;
  }

  .cs__replay:hover {
    border-color: var(--tinta);
  }

  .cs__replay:focus-visible {
    outline: 3px solid var(--terracota);
    outline-offset: 2px;
  }

  .cs__replay :global(.icon) {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cs__verdict {
    max-width: 62ch;
    margin: 0;
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 650;
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .cs__replay {
      display: none;
    }
  }

  @media (min-width: 720px) {
    .cs__phones {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
  }

  @media (min-width: 1100px) {
    .cs__phones {
      gap: 56px;
    }

    .cs__links {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
      pointer-events: none;
    }
  }

  /* ---------- Las cifras reales ---------- */

  .cs-scale {
    display: grid;
    gap: 16px;
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  .cs-scale__title {
    margin: 0;
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 650;
  }

  .cs-scale__figs {
    display: grid;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cs-scale__figs li {
    display: grid;
    gap: 6px;
    align-content: start;
  }

  .cs-scale__value {
    font-family: var(--display);
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.75rem);
    font-weight: 700;
    line-height: 1;
  }

  .cs-scale__text {
    margin: 0;
  }

  .cs-scale__src {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--ink-2);
  }

  .cs-scale__src :global(.icon) {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  @media (min-width: 720px) {
    .cs-scale__figs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
    }
  }
</style>

<script>
  /**
   * Los mensajes llegan en el orden en que llegaron (del más antiguo al más nuevo), después una luz
   * revisa cada celular y aparecen las marcas y las líneas. Los audios suenan de a uno y su onda se
   * pinta mientras suenan.
   */
  for (const root of document.querySelectorAll<HTMLElement>("[data-casos]")) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const order = (root.dataset.order ?? "").split(",");
    const msgs = new Map([...root.querySelectorAll<HTMLElement>("[data-msg]")].map((m) => [m.dataset.msg!, m]));
    const caps = [...root.querySelectorAll<HTMLElement>("[data-cap]")];
    const replay = root.querySelector<HTMLButtonElement>("[data-replay]");
    const svg = root.querySelector<SVGSVGElement>("[data-links]");
    const phones = root.querySelector<HTMLElement>("[data-phones]");
    let timers: number[] = [];

    // Las marcas de cada celular aparecen una tras otra.
    root.querySelectorAll<HTMLElement>(".cs__tag").forEach((t, i) => t.style.setProperty("--k", String(i % 3)));

    /** Las líneas: del borde derecho de una marca al borde izquierdo de su pareja en el otro celular. */
    const drawLinks = () => {
      if (!svg || getComputedStyle(svg).display === "none") return;
      const box = root.getBoundingClientRect();
      for (const path of svg.querySelectorAll<SVGPathElement>("[data-path]")) {
        const tags = [...root.querySelectorAll<HTMLElement>(`.cs__tag[data-link="${path.dataset.path}"]`)];
        if (tags.length < 2) continue;
        const [a, b] = tags.map((t) => t.getBoundingClientRect());
        const x0 = a!.right - box.left + 4;
        const y0 = a!.top + a!.height / 2 - box.top;
        const x1 = b!.left - box.left - 4;
        const y1 = b!.top + b!.height / 2 - box.top;
        const dx = Math.max(30, (x1 - x0) / 2);
        path.setAttribute("d", `M${x0},${y0} C${x0 + dx},${y0} ${x1 - dx},${y1} ${x1},${y1}`);
        path.style.setProperty("--len", String(Math.ceil(path.getTotalLength())));
      }
    };

    const caption = (i: number) => caps.forEach((c, k) => c.classList.toggle("is-on", k === i));

    const play = () => {
      timers.forEach(clearTimeout);
      timers = [];
      root.classList.add("is-armed");
      root.classList.remove("is-found", "is-scan");
      msgs.forEach((m) => m.classList.remove("is-in"));
      root.querySelectorAll(".cs__day").forEach((x) => x.classList.remove("is-in"));
      caption(0);
      drawLinks();
      const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
      // Cada mensaje llega con su separador de día, si es el primero de ese día.
      const arrive = (m: HTMLElement | undefined) => {
        if (!m) return;
        m.classList.add("is-in");
        const prev = m.previousElementSibling;
        if (prev?.classList.contains("cs__day")) prev.classList.add("is-in");
      };
      order.forEach((id, i) => at(250 + i * 520, () => arrive(msgs.get(id))));
      const found = 250 + order.length * 520 + 300;
      at(found, () => root.classList.add("is-scan"));
      at(found + 900, () => {
        drawLinks();
        root.classList.add("is-found");
        caption(1);
      });
      at(found + 2200, () => root.classList.remove("is-scan"));
      replay?.classList.add("is-on");
    };

    // Audios: uno a la vez; la onda se pinta mientras suena.
    const audios = [...root.querySelectorAll<HTMLAudioElement>("audio[data-audio]")];
    for (const btn of root.querySelectorAll<HTMLButtonElement>("[data-play]")) {
      const a = root.querySelector<HTMLAudioElement>(`audio[data-audio="${btn.dataset.play}"]`);
      const wave = btn.parentElement?.querySelector<HTMLElement>(".cs__wave");
      if (!a || !wave) continue;
      const bars = [...wave.children] as HTMLElement[];
      let raf = 0;
      const paint = () => {
        const n = a.duration ? Math.round((a.currentTime / a.duration) * bars.length) : 0;
        bars.forEach((b, i) => (b.style.background = i < n ? "var(--noche)" : ""));
        if (!a.paused) raf = requestAnimationFrame(paint);
      };
      a.addEventListener("play", () => {
        btn.setAttribute("aria-pressed", "true");
        raf = requestAnimationFrame(paint);
      });
      const stop = () => {
        btn.setAttribute("aria-pressed", "false");
        cancelAnimationFrame(raf);
        paint();
      };
      a.addEventListener("pause", stop);
      a.addEventListener("ended", () => {
        stop();
        a.currentTime = 0;
        bars.forEach((b) => (b.style.background = ""));
      });
      btn.addEventListener("click", () => {
        if (!a.paused) {
          a.pause();
          return;
        }
        audios.forEach((o) => o !== a && o.pause());
        void a.play();
      });
    }

    replay?.addEventListener("click", play);
    if (phones) new ResizeObserver(() => drawLinks()).observe(phones);
    window.addEventListener("load", drawLinks, { once: true });

    if (reduce || !("IntersectionObserver" in window)) {
      drawLinks();
      continue;
    }
    // Cerca de la vista se arma (los mensajes esperan ocultos); al verse, empieza.
    const near = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          near.disconnect();
          root.classList.add("is-armed");
          caption(0);
        }
      },
      { rootMargin: "300px 0px" },
    );
    near.observe(root);
    const seen = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          seen.disconnect();
          play();
        }
      },
      { threshold: 0.3 },
    );
    seen.observe(phones ?? root);
  }
</script>
