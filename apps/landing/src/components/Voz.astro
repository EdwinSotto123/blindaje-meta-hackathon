---
/**
 * Aunque disfracen la voz, queda huella. Con la voz 1 ficticia del demo (MMS-TTS), un <canvas> dibuja
 * cinco pasos: 1) los primeros 7 s de la nota en píxeles (espectrograma en semitonos), 2) su huella
 * ECAPA de 192 números comparada casilla por casilla con la guardada del caso A, 3) el disfraz de +4
 * semitonos (la imagen sube y el parecido cae), 4) el barrido de −8 a +8 y 5) lo que queda: una pista,
 * no un vínculo. Abajo, las 28 voces de SLR73 en tres matrices de parecido (limpia, disfrazada y
 * revertida).
 *
 * Datos: src/data/voz-huella.json (eval/py/blindaje_eval/voz_huella.py), el tono de cada versión de
 * src/data/voz-demo.json (voz_landing.py) y las cifras de eval/results/voz_distorsion.json; sin ese
 * reporte la sección no se muestra. Las cifras del texto se llenan aquí; el dibujo carga el JSON aparte
 * cuando la sección se acerca.
 *
 * Sin JavaScript se ven los pasos y las cifras. Con movimiento reducido, el estado final sin animación;
 * los pasos, el barrido y los audios siguen funcionando.
 */
import type { Dict } from "../i18n";
import { readVoiceReport } from "../lib/voice-report";
import demo from "../data/voz-demo.json";
import huella from "../data/voz-huella.json";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const v = d.lp.voice;
const r = readVoiceReport();
const es = d.lang === "es";

const dec = (x: number) => x.toFixed(2);
const pct = (x: number) => `${Math.round(x * 100)}${es ? " %" : "%"}`;
const minus = (x: number) => (x < 0 ? `−${Math.abs(x)}` : String(x));
const per100 = (x: number) => (x === 0 ? "0" : x.toFixed(2));

const h = huella.huella;
const at = (k: number) => h.barrido.find((b) => b.k === k)!;
const tokens: Record<string, string> = r
  ? {
      speakers: String(r.speakers),
      semitones: String(r.semitones),
      sweepMin: minus(r.sweep[0]),
      sweepMax: String(r.sweep[1]),
      top1Disguised: pct(r.disguised.top1),
      top1Reverted: pct(r.reverted.top1),
      demoClean: dec(h.coseno_limpia),
      demoDisguised: dec(at(0).coseno),
      bestK: minus(h.mejor_k),
      demoBest: dec(at(h.mejor_k).coseno),
      exactK: minus(-huella.disfraz),
      demoExact: dec(at(-huella.disfraz).coseno),
      hzClean: String(demo.tono.limpia.hz),
      hzDisguised: String(demo.tono.disfrazada.hz),
      threshold: dec(r.thresholdCosine),
    }
  : {};
const fill = (s: string) => s.replace(/\{(\w+)\}/g, (m, k: string) => tokens[k] ?? m);

/** Lo que el dibujo necesita del servidor: umbral, tono medido de cada versión y rótulos. */
const config = r
  ? JSON.stringify({
      thr: r.thresholdCosine,
      hz: [demo.tono.limpia.hz, demo.tono.disfrazada.hz, demo.tono.revertida.hz],
      labels: v.canvas,
    })
  : "";

const clips = ["limpia", "disfrazada", "revertida"] as const;
const conds = r ? [r.clean, r.disguised, r.reverted] : [];
---

{r && (
  <section class="section on-paper-2" id="voz" aria-labelledby="voz-title">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <h2 id="voz-title" class="head">
          {v.title}
        </h2>
        <p class="lead soft">{fill(v.lead)}</p>
      </div>

      <div class="vz" data-voz data-config={config}>
        <div class="vz__stage">
          <div class="vz__viz" data-viz>
            <canvas class="vz__canvas" aria-hidden="true" data-canvas></canvas>
          </div>

          <div class="vz__player">
            <ol class="vz__steps" aria-label={v.stepsLabel}>
              {v.steps.map((s, i) => (
                <li>
                  <button type="button" class="vz__step" data-step={i} disabled>
                    <span class="vz__prog" aria-hidden="true" />
                    <span class="vz__n num">{i + 1}</span>
                    <span class="vz__step-title">{fill(s.title)}</span>
                  </button>
                  <p class="vz__step-text">{fill(s.text)}</p>
                </li>
              ))}
            </ol>
            <div class="vz__now">
              <div class="vz__caption" aria-hidden="true">
                {v.steps.map((s, i) => (
                  <p class:list={["vz__cap", i === 0 && "is-on"]} data-cap>
                    <strong>{fill(s.title)}</strong>
                    {fill(s.text)}
                  </p>
                ))}
              </div>
              <button type="button" class="vz__replay" data-replay>
                <Icon name="restart" />
                {v.replay}
              </button>
            </div>
          </div>

          <div class="vz__listen" role="group" aria-label={v.listen}>
            <span class="vz__listen-label" aria-hidden="true">
              {v.listen}
            </span>
            {clips.map((c, i) => (
              <button type="button" class="vz__play" data-clip={c} aria-pressed="false">
                <Icon name="play" class="icon vz__icon vz__icon--play" />
                <Icon name="pause" class="icon vz__icon vz__icon--pause" />
                {v.versions[i]}
                <span class="sr-only">, {v.audioLabels[i]}</span>
              </button>
            ))}
          </div>
        </div>

        <p class="vz__hint cap" data-hint hidden>
          {v.hover}
        </p>

        {clips.map((c) => (
          <audio preload="none" src={`/voz/b1-${c}.m4a`} data-audio={c} />
        ))}
      </div>

      <div class="vm">
        <div class="vm__text">
          <h3 class="vm__title">{fill(v.measured.title)}</h3>
          <p class="vm__explain">{fill(v.measured.explain)}</p>
        </div>
        <ul class="vm__figs hs" role="list" aria-label={fill(v.measured.title)} data-matrices>
          {conds.map((c, i) => (
            <li class="vm__fig">
              <div class="vm__square">
                <canvas class="vm__canvas" aria-hidden="true" data-matrix={clips[i]} />
              </div>
              <p class="vm__name">{v.measured.figures[i]}</p>
              <dl class="vm__stats">
                <div>
                  <dt>{v.measured.top1}</dt>
                  <dd class="num">{pct(c.top1)}</dd>
                </div>
                <div>
                  <dt>{v.measured.similarity}</dt>
                  <dd class="num">{dec(c.cosine)}</dd>
                </div>
                <div>
                  <dt>{v.measured.falseLinks}</dt>
                  <dd class="num">{per100(c.falsePer100)}</dd>
                </div>
              </dl>
            </li>
          ))}
        </ul>
        <div class="vm__foot">
          <p class="vm__note">{fill(v.note)}</p>
          <p class="cap">{v.source}</p>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .vz {
    display: grid;
    gap: 12px;
  }

  /* ---------- El escenario ---------- */

  .vz__stage {
    padding: 14px 12px;
    border-radius: var(--r-l);
    background: var(--noche);
    color: var(--fondo);
  }

  .vz__viz {
    display: none;
  }

  :global(.js) .vz__viz {
    position: relative;
    display: block;
    height: 560px;
  }

  .vz__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  @media (min-width: 720px) {
    .vz__stage {
      padding: 22px 24px 18px;
    }
  }

  /* ---------- Los pasos ---------- */

  .vz__player {
    display: grid;
    gap: 6px;
  }

  :global(.js) .vz__player {
    margin-top: 18px;
  }

  .vz__steps {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vz__step {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 8px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 700;
    text-align: start;
  }

  .vz__n {
    flex: none;
    color: var(--ocre);
  }

  .vz__step-text {
    margin: 2px 0 0;
    color: var(--claro-tenue);
  }

  .vz__prog,
  .vz__now {
    display: none;
  }

  :global(.js) .vz__steps {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }

  :global(.js) .vz__step {
    padding: 12px 0 6px;
    color: var(--claro-tenue);
    font-size: var(--step-small);
    line-height: 1.25;
    cursor: pointer;
  }

  :global(.js) .vz__step:hover,
  :global(.js) .vz__step[aria-current="step"] {
    color: var(--fondo);
  }

  :global(.js) .vz__step:focus-visible {
    outline: 3px solid var(--ocre);
    outline-offset: 2px;
    border-radius: 4px;
  }

  :global(.js) .vz__prog {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    display: block;
    height: 3px;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.16);
  }

  :global(.js) .vz__prog::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--ocre);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }

  :global(.js) .vz__step-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  :global(.js) .vz__now {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px 20px;
  }

  .vz__caption {
    display: grid;
    flex: 1 1 32rem;
    max-width: 76ch;
    color: var(--claro-tenue);
  }

  .vz__cap {
    grid-area: 1 / 1;
    margin: 0;
    visibility: hidden;
  }

  .vz__cap.is-on {
    visibility: visible;
  }

  .vz__caption strong {
    margin-right: 0.4em;
    color: var(--fondo);
  }

  .vz__replay,
  .vz__play {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 999px;
    background: none;
    color: var(--fondo);
    font: inherit;
    font-size: var(--step-small);
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
  }

  .vz__replay {
    /* Ocupa su lugar desde el principio: al aparecer no empuja nada. */
    visibility: hidden;
  }

  .vz__replay.is-on {
    visibility: visible;
  }

  .vz__replay :global(.icon),
  .vz__play :global(.icon) {
    flex: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .vz__replay:hover,
  .vz__play:hover {
    border-color: var(--fondo);
  }

  .vz__replay:focus-visible,
  .vz__play:focus-visible {
    outline: 3px solid var(--ocre);
    outline-offset: 2px;
  }

  /* El ícono viene de Icon.astro: sus clases no llevan el alcance de este componente. */
  .vz__play :global(.vz__icon--pause),
  .vz__play[aria-pressed="true"] :global(.vz__icon--play) {
    display: none;
  }

  .vz__play[aria-pressed="true"] :global(.vz__icon--pause) {
    display: block;
  }

  .vz__play[aria-pressed="true"] {
    border-color: var(--ocre);
    background: var(--ocre);
    color: var(--noche);
  }

  /* Escuchar: sin JavaScript no hay botones que funcionen. */
  .vz__listen {
    display: none;
  }

  :global(.js) .vz__listen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }

  .vz__listen-label {
    margin-right: 4px;
    color: var(--claro-tenue);
    font-size: var(--step-small);
    font-weight: 700;
  }

  @media (max-width: 719px) {
    :global(.js) .vz__step-title {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    :global(.js) .vz__step {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vz__replay {
      display: none;
    }
  }

  .vz__hint {
    margin: 0;
  }

  /* ---------- Las 28 voces ---------- */

  .vm {
    display: grid;
    gap: 20px;
    margin-top: 44px;
  }

  .vm__title {
    margin: 0 0 8px;
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 650;
  }

  .vm__explain {
    max-width: 75ch;
    margin: 0;
  }

  .vm__figs {
    display: grid;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vm__fig {
    display: grid;
    gap: 8px;
    align-content: start;
    min-width: 0;
  }

  .vm__square {
    position: relative;
    aspect-ratio: 1;
    padding: 8px;
    border-radius: var(--r-m);
    background: var(--noche);
  }

  .vm__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .vm__name {
    margin: 4px 0 0;
    font-weight: 700;
  }

  .vm__stats {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--linea);
  }

  .vm__stats > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 5px 0;
    border-bottom: 1px solid var(--linea);
  }

  .vm__stats dt {
    color: var(--ink-2);
    font-size: var(--step-small);
    line-height: 1.3;
  }

  .vm__stats dd {
    margin: 0;
    font-family: var(--display);
    font-weight: 650;
  }

  .vm__foot {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .vm__note {
    max-width: 75ch;
    margin: 0;
  }

  @media (min-width: 720px) {
    .vm__figs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* En pantallas anchas, el texto a la izquierda y los tres cuadros a la derecha. */
  @media (min-width: 1100px) {
    .vm {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      grid-template-areas:
        "text figs"
        "foot figs";
      grid-template-rows: auto 1fr;
      column-gap: 48px;
      row-gap: 18px;
    }

    .vm__text {
      grid-area: text;
    }

    .vm__figs {
      grid-area: figs;
      column-gap: 28px;
    }

    .vm__foot {
      grid-area: foot;
    }
  }
</style>

<script>
  type Sweep = { k: number; coseno: number; v: string };
  type Data = {
    disfraz: number;
    espectro: {
      filas: number;
      columnas: number;
      f_min: number;
      por_semitono: number;
      hop_s: number;
      limpia: string;
      disfrazada: string;
      revertida: string;
    };
    huella: {
      dim: number;
      escala: number;
      guardada: string;
      limpia: string;
      coseno_limpia: number;
      barrido: Sweep[];
      mejor_k: number;
    };
    voces: { n: number; k: number[]; limpia: string; disfrazada: string; revertida: string };
  };
  type Labels = {
    spectrogram: string;
    versions: [string, string, string];
    shifted: string;
    stored: string;
    note: string;
    product: string;
    similarity: string;
    threshold: string;
    sweep: string;
    positive: string;
    negative: string;
  };
  type Config = { thr: number; hz: [number, number, number]; labels: Labels };
  type Version = "limpia" | "disfrazada" | "revertida";
  type Rect = { x: number; y: number; w: number; h: number };
  type Vec = Float32Array;
  type Prep = {
    spec: Record<Version, HTMLCanvasElement>;
    stored: Vec;
    clean: Vec;
    cosClean: number;
    sweep: { k: number; cos: number; v: Vec }[];
    best: number;
    exact: number;
    zero: number;
    scale: number;
    pscale: number;
    sparks: { r: number; c: number; k: number; d: number }[];
  };
  type Layout = {
    spec: Rect;
    grids: [Rect, Rect, Rect];
    cell: number;
    ops: { x: number; y: number }[];
    gauge: Rect;
    num: { x: number; y: number };
    legend: { x: number; y: number };
    bars: Rect;
    font: number;
    big: number;
    H: number;
  };

  /** Duración de cada paso (ms): la voz, la huella, el disfraz, el barrido y lo que queda. */
  const STEP_K = 165;
  const DUR = [2000, 2800, 2600, 400 + 17 * STEP_K + 700, 1500];
  const START = DUR.map((_, i) => DUR.slice(0, i).reduce((s, x) => s + x, 0));
  const END = START[4]! + DUR[4]!;
  /** Las chispas del paso 2: cuándo salen, en cuánto tiempo salen todas y cuánto viaja cada una. */
  const SPARK0 = 100;
  const SPARKS = 1000;
  const SPARK = 650;
  const GC = 16;
  const GR = 12;
  const CLIP_S = 7;

  const RAMP = [
    [36, 25, 19],
    [92, 42, 27],
    [168, 80, 38],
    [231, 173, 69],
    [255, 241, 214],
  ];
  const NOCHE = [42, 30, 23];
  const OCRE = [231, 173, 69];
  const AZUL = [126, 176, 216];

  const clamp = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x);
  const ease = (x: number) => 1 - (1 - x) ** 3;
  const inout = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - (-2 * x + 2) ** 3 / 2);
  const lerp = (a: number, b: number, u: number) => a + (b - a) * u;
  const rnd = (k: number) => (((k + 1) * 2654435761) >>> 0) / 4294967296;
  const ramp = (u: number) => {
    const x = clamp(u) * (RAMP.length - 1);
    const i = Math.min(RAMP.length - 2, Math.floor(x));
    const f = x - i;
    return RAMP[i]!.map((c, j) => c + (RAMP[i + 1]![j]! - c) * f);
  };
  const rgb = (c: number[], a = 1) => `rgb(${c[0]! | 0} ${c[1]! | 0} ${c[2]! | 0} / ${a.toFixed(3)})`;
  const fmt = (x: number) => x.toFixed(2);
  const signed = (k: number) => (k > 0 ? `+${k}` : k < 0 ? `−${-k}` : "0");

  const vec = (s: string, scale: number): Vec =>
    Float32Array.from({ length: s.length / 2 }, (_, i) => {
      let q = parseInt(s.slice(i * 2, i * 2 + 2), 16);
      if (q > 127) q -= 256;
      return (q / 127) * scale;
    });

  /** El espectrograma en un lienzo chico, un píxel por celda; la fila 0 (80 Hz) abajo. */
  const specCanvas = (hex: string, R: number, C: number) => {
    const c = document.createElement("canvas");
    c.width = C;
    c.height = R;
    const g = c.getContext("2d")!;
    const img = g.createImageData(C, R);
    const lut = Array.from({ length: 16 }, (_, i) => ramp((i / 15) ** 1.15));
    for (let r = 0; r < R; r++) {
      for (let col = 0; col < C; col++) {
        const color = lut[parseInt(hex[r * C + col]!, 16)]!;
        const i = ((R - 1 - r) * C + col) * 4;
        img.data[i] = color[0]!;
        img.data[i + 1] = color[1]!;
        img.data[i + 2] = color[2]!;
        img.data[i + 3] = 255;
      }
    }
    g.putImageData(img, 0, 0);
    return c;
  };

  /** Un valor de la huella como color: ocre si es positivo, azul si es negativo. */
  const cellColor = (x: number, scale: number) => {
    const u = Math.min(1, Math.abs(x) / scale) ** 0.75;
    const to = x >= 0 ? OCRE : AZUL;
    return NOCHE.map((c, j) => c + (to[j]! - c) * u);
  };

  for (const root of document.querySelectorAll<HTMLElement>("[data-voz]")) {
    const viz = root.querySelector<HTMLElement>("[data-viz]")!;
    const canvas = root.querySelector<HTMLCanvasElement>("[data-canvas]")!;
    const ctx = canvas.getContext("2d");
    if (!ctx) continue;
    const cfg = JSON.parse(root.dataset.config ?? "{}") as Config;
    const L = cfg.labels;
    const steps = [...root.querySelectorAll<HTMLButtonElement>("[data-step]")];
    const caps = [...root.querySelectorAll<HTMLElement>("[data-cap]")];
    const replay = root.querySelector<HTMLButtonElement>("[data-replay]")!;
    const hint = root.querySelector<HTMLElement>("[data-hint]")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const section = root.closest("section")!;
    const matrices = [...section.querySelectorAll<HTMLCanvasElement>("[data-matrix]")];

    let data: Data | null = null;
    let prep: Prep | null = null;
    let lay: Layout | null = null;
    let t = 0;
    let raf = 0;
    let playing = false;
    let from = 0;
    let to = END;
    let t0 = 0;
    let hoverK: number | null = null;
    let listening: { v: Version; a: HTMLAudioElement } | null = null;
    let cssW = 0;
    let font = "sans-serif";
    let lastStep = -1;

    steps.forEach((b) => (b.disabled = false));

    const prepare = () => {
      if (!data) return;
      const e = data.espectro;
      const h = data.huella;
      const spec = {
        limpia: specCanvas(e.limpia, e.filas, e.columnas),
        disfrazada: specCanvas(e.disfrazada, e.filas, e.columnas),
        revertida: specCanvas(e.revertida, e.filas, e.columnas),
      };
      const stored = vec(h.guardada, h.escala);
      const clean = vec(h.limpia, h.escala);
      const sweep = h.barrido.map((b) => ({ k: b.k, cos: b.coseno, v: vec(b.v, h.escala) }));
      const scale = Math.max(...stored.map(Math.abs)) * 0.8;
      const prods = stored.map((x, i) => Math.abs(x * clean[i]!)).sort();
      // Chispas del paso 2: celdas claras de la nota que viajan a la huella.
      const bright: { r: number; c: number }[] = [];
      for (let r = 0; r < e.filas; r++) {
        for (let c = 0; c < e.columnas; c++) {
          if (parseInt(e.limpia[r * e.columnas + c]!, 16) >= 12) bright.push({ r, c });
        }
      }
      const sparks = Array.from({ length: GC * GR }, (_, k) => {
        const b = bright[Math.floor(rnd(k * 7 + 3) * bright.length)] ?? { r: 0, c: 0 };
        return { ...b, k, d: rnd(k * 3 + 1) };
      });
      prep = {
        spec,
        stored,
        clean,
        cosClean: h.coseno_limpia,
        sweep,
        best: sweep.findIndex((s) => s.k === h.mejor_k),
        exact: sweep.findIndex((s) => s.k === -data!.disfraz),
        zero: sweep.findIndex((s) => s.k === 0),
        scale,
        pscale: prods[Math.floor(prods.length * 0.92)]! || 1e-3,
        sparks,
      };
    };

    /** Dónde va cada cosa: en pantallas anchas, la nota a la izquierda y la huella a la derecha. */
    const measure = () => {
      cssW = viz.clientWidth;
      const W = cssW;
      const wide = W >= 860;
      const fontPx = W < 600 ? 12 : 13;
      const big = W < 600 ? 26 : 32;
      let spec: Rect;
      let fx: number;
      let fy: number;
      let fw: number;
      // A la izquierda de la nota, la escala de tonos (100 a 800 Hz).
      const gut = W < 600 ? 44 : 54;
      if (wide) {
        const sw = Math.round(W * 0.56);
        spec = { x: gut, y: 24, w: sw - gut, h: Math.round(Math.min(330, sw * 0.46)) };
        fx = sw + 44;
        fy = 0;
        fw = W - fx;
      } else {
        spec = { x: gut, y: 22, w: W - gut, h: Math.round(Math.min(300, W * 0.52)) };
        fx = 0;
        fy = spec.y + spec.h + 26;
        fw = W;
      }
      const opW = W < 600 ? 18 : 26;
      const cell = Math.max(5, Math.floor(Math.min((fw - opW * 2 - 8) / (GC * 3), wide ? 10 : 9)));
      const gw = cell * GC;
      const gh = cell * GR;
      const used = gw * 3 + opW * 2;
      const gx = fx + Math.max(0, Math.floor((fw - used) / 2) * (wide ? 0 : 1));
      const labelH = fontPx * 2 + 10;
      const gy = fy + labelH;
      const grids: [Rect, Rect, Rect] = [0, 1, 2].map((i) => ({
        x: gx + i * (gw + opW),
        y: gy,
        w: gw,
        h: gh,
      })) as [Rect, Rect, Rect];
      const ops = [0, 1].map((i) => ({ x: gx + gw * (i + 1) + opW * i + opW / 2, y: gy + gh / 2 }));
      const ny = gy + gh + 30;
      const num = { x: gx, y: ny + big * 0.5 + 14 };
      const gauge = { x: gx, y: ny + big + 26, w: Math.min(used, fw), h: 10 };
      const legend = { x: gx, y: gauge.y + gauge.h + fontPx * 2 + 22 };
      const fpBottom = legend.y + 8;
      const barsY = Math.max(spec.y + spec.h, fpBottom) + (wide ? 34 : 28);
      const bars = { x: 0, y: barsY, w: W, h: wide ? 150 : 140 };
      const H = bars.y + bars.h;
      lay = { spec, grids, cell, ops, gauge, num, legend, bars, font: fontPx, big, H };
      viz.style.height = `${H}px`;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      font = getComputedStyle(root).fontFamily;
    };

    const text = (
      s: string,
      x: number,
      y: number,
      size: number,
      color: string,
      weight = 400,
      align: CanvasTextAlign = "left",
    ) => {
      ctx.font = `${weight} ${size}px ${font}`;
      ctx.fillStyle = color;
      ctx.textAlign = align;
      ctx.textBaseline = "alphabetic";
      ctx.fillText(s, x, y);
    };

    /** Texto en una línea o, si no entra, en dos líneas parejas; la última línea va en y. */
    const label = (s: string, x: number, y: number, maxW: number, size: number, color: string, weight = 700) => {
      ctx.font = `${weight} ${size}px ${font}`;
      let lines = [s];
      if (ctx.measureText(s).width > maxW) {
        const words = s.split(" ");
        let best = Infinity;
        for (let i = 1; i < words.length; i++) {
          const a = words.slice(0, i).join(" ");
          const b = words.slice(i).join(" ");
          const w = Math.max(ctx.measureText(a).width, ctx.measureText(b).width);
          if (w < best) {
            best = w;
            lines = [a, b];
          }
        }
      }
      lines.forEach((l, i) => text(l, x, y - (lines.length - 1 - i) * (size + 3), size, color, weight));
    };

    /** El estado del dibujo en el tiempo t (o con el puntero sobre el barrido, o con un audio). */
    const view = () => {
      const p = prep!;
      const n = p.sweep.length;
      const s3 = START[3]! + 400;
      const sweepEnd = s3 + n * STEP_K;
      // El barrido: qué tono mira en cada momento.
      let ki = -1;
      if (t >= s3) ki = Math.min(n - 1, Math.floor((t - s3) / STEP_K));
      const settle = clamp((t - sweepEnd - 120) / 520);
      // Con un audio, se marca su barra: la disfrazada (0) o la revertida (el disfraz exacto).
      const heard = listening ? { limpia: null, disfrazada: p.zero, revertida: p.exact }[listening.v] : undefined;
      const sel = hoverK ?? (heard !== undefined ? heard : t >= sweepEnd ? p.best : ki >= 0 ? ki : null);
      return { ki, settle, sel, sweepEnd, s3 };
    };

    const drawSpec = (src: HTMLCanvasElement, r: Rect, offSemis: number, alpha: number, reveal = 1) => {
      if (!data || alpha <= 0) return;
      const e = data.espectro;
      const rowH = r.h / e.filas;
      const off = offSemis * e.por_semitono * rowH;
      ctx.save();
      ctx.beginPath();
      ctx.rect(r.x, r.y, r.w * reveal, r.h);
      ctx.clip();
      ctx.globalAlpha = alpha;
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(src, r.x, r.y - off, r.w, r.h);
      ctx.restore();
    };

    const rowY = (hz: number, r: Rect) => {
      const e = data!.espectro;
      const row = 12 * e.por_semitono * Math.log2(hz / e.f_min);
      return r.y + r.h - ((row + 0.5) / e.filas) * r.h;
    };

    const drawGrid = (r: Rect, values: (k: number) => number | null, scale: number, cell: number) => {
      for (let k = 0; k < GC * GR; k++) {
        const x = r.x + (k % GC) * cell;
        const y = r.y + Math.floor(k / GC) * cell;
        const val = values(k);
        if (val === null) {
          ctx.fillStyle = "rgb(255 255 255 / 0.06)";
        } else {
          ctx.fillStyle = rgb(cellColor(val, scale));
        }
        ctx.fillRect(x + 0.5, y + 0.5, cell - 1, cell - 1);
      }
    };

    const draw = () => {
      if (!lay) return;
      const W = cssW;
      ctx.clearRect(0, 0, W, lay.H);
      if (!data || !prep) return;
      const p = prep;
      const { spec: S, grids, cell, bars: B } = lay;
      const fs = lay.font;
      const dim = "rgb(214 209 202 / 1)";
      const { ki, settle, sel, sweepEnd, s3 } = view();
      const n = p.sweep.length;

      // ---------- La nota en píxeles ----------
      ctx.fillStyle = rgb(RAMP[0]!);
      ctx.fillRect(S.x, S.y, S.w, S.h);
      let specLabel = `${L.spectrogram}, ${L.versions[0]}`;
      let guideHz: number | null = null;
      let guideY = 0;
      let playhead: number | null = null;
      const hzC = cfg.hz[0];
      const hzD = cfg.hz[1];

      if (listening) {
        const v = listening.v;
        drawSpec(p.spec[v], S, 0, 1);
        specLabel = `${L.spectrogram}, ${L.versions[["limpia", "disfrazada", "revertida"].indexOf(v)]}`;
        guideHz = cfg.hz[["limpia", "disfrazada", "revertida"].indexOf(v)]!;
        guideY = rowY(guideHz, S);
        playhead = clamp(listening.a.currentTime / CLIP_S);
      } else if (hoverK !== null || t >= START[3]!) {
        const idx = sel ?? p.zero;
        let k = p.sweep[idx]!.k;
        if (hoverK === null && t < sweepEnd + 640) {
          // Durante el barrido, el corrimiento llega suave al tono que toca.
          if (ki < 0) k = 0;
          else {
            const prevK = ki > 0 ? p.sweep[ki - 1]!.k : 0;
            const u = ease(clamp((t - s3 - ki * STEP_K) / 110));
            k = lerp(prevK, p.sweep[ki]!.k, u);
            if (t >= sweepEnd) k = lerp(p.sweep[n - 1]!.k, p.sweep[p.best]!.k, inout(settle));
          }
        }
        drawSpec(p.spec.disfrazada, S, k, 1);
        const kr = Math.round(k);
        specLabel =
          kr === 0 ? `${L.spectrogram}, ${L.versions[1]}` : `${L.spectrogram}, ${L.shifted.replace("{k}", signed(kr))}`;
        guideHz = hzD * 2 ** (k / 12);
        guideY = rowY(hzD, S) - k * data.espectro.por_semitono * (S.h / data.espectro.filas);
      } else if (t >= START[2]!) {
        const u = inout(clamp((t - START[2]! - 100) / 700));
        const mix = ease(clamp((t - START[2]! - 800) / 500));
        // La limpia sube 4 semitonos y se funde con la disfrazada de verdad.
        drawSpec(p.spec.limpia, S, data.disfraz * u, 1);
        drawSpec(p.spec.disfrazada, S, 0, mix);
        specLabel = `${L.spectrogram}, ${mix > 0.5 ? L.versions[1] : L.versions[0]}`;
        guideHz = lerp(hzC, hzC * 2 ** (data.disfraz / 12), u);
        guideY = lerp(
          rowY(hzC, S),
          rowY(hzC, S) - data.disfraz * data.espectro.por_semitono * (S.h / data.espectro.filas),
          u,
        );
        if (mix > 0) {
          guideHz = lerp(guideHz, hzD, mix);
          guideY = lerp(guideY, rowY(hzD, S), mix);
        }
      } else {
        const reveal = clamp((t - 100) / 1700);
        drawSpec(p.spec.limpia, S, 0, 1, reveal);
        if (reveal > 0 && reveal < 1) {
          const xs = S.x + reveal * S.w;
          const g = ctx.createLinearGradient(xs - 46, 0, xs, 0);
          g.addColorStop(0, "rgb(231 173 69 / 0)");
          g.addColorStop(1, "rgb(231 173 69 / 0.45)");
          ctx.fillStyle = g;
          ctx.fillRect(Math.max(S.x, xs - 46), S.y, Math.min(46, xs - S.x), S.h);
          ctx.fillStyle = "rgb(255 236 200 / 0.9)";
          ctx.fillRect(xs - 1, S.y, 2, S.h);
        }
        if (t > 1500) {
          guideHz = hzC;
          guideY = rowY(hzC, S);
        }
      }

      // Escala de tonos a la izquierda y el tono medido de la nota.
      for (const hz of [100, 200, 400, 800]) {
        const y = rowY(hz, S);
        ctx.fillStyle = "rgb(255 255 255 / 0.4)";
        ctx.fillRect(S.x - 5, y, 5, 1);
        text(`${hz} Hz`, S.x - 8, y + 4, fs - 1, dim, 400, "right");
      }
      ctx.save();
      ctx.beginPath();
      ctx.rect(S.x, S.y, S.w, S.h);
      ctx.clip();
      if (guideHz !== null) {
        ctx.setLineDash([4, 4]);
        ctx.strokeStyle = "rgb(255 255 255 / 0.85)";
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(S.x, guideY);
        ctx.lineTo(S.x + S.w, guideY);
        ctx.stroke();
        ctx.setLineDash([]);
        const tag = `${Math.round(guideHz)} Hz`;
        ctx.font = `700 ${fs}px ${font}`;
        const tw = ctx.measureText(tag).width + 12;
        const ty = Math.min(S.y + S.h - 4, Math.max(S.y + fs + 6, guideY - 6));
        ctx.fillStyle = "rgb(18 12 9 / 0.85)";
        ctx.fillRect(S.x + S.w - tw - 4, ty - fs - 2, tw, fs + 8);
        text(tag, S.x + S.w - 10, ty + 1, fs, "#fff", 700, "right");
      }
      if (playhead !== null) {
        const xs = S.x + playhead * S.w;
        ctx.fillStyle = "rgb(255 236 200 / 0.95)";
        ctx.fillRect(xs - 1, S.y, 2, S.h);
      }
      ctx.restore();
      text(specLabel, S.x, S.y - 8, fs, dim, 700);

      // ---------- La huella ----------
      const [G0, G1, G2] = grids;
      const top = G0.y - 8;
      const lw = G1.x - G0.x - 6;
      label(L.stored, G0.x, top, lw, fs, dim);
      label(L.note, G1.x, top, lw, fs, dim);
      label(L.product, G2.x, top, Math.max(lw, W - G2.x), fs, dim);
      ctx.globalAlpha = 1;
      drawGrid(G0, (k) => p.stored[k]!, p.scale, cell);

      // La nota de ahora: limpia, mezclándose con la disfrazada o la del tono que mira el barrido.
      let note: (k: number) => number | null = () => null;
      let cos: number | null = null;
      let prodShown = 0;
      let cosGhost: number | null = null;
      const pick = (idx: number) => p.sweep[idx]!.v;
      if (listening) {
        const v = listening.v;
        const vv = v === "limpia" ? p.clean : pick(v === "disfrazada" ? p.zero : p.exact);
        note = (k) => vv[k]!;
        cos = v === "limpia" ? p.cosClean : p.sweep[v === "disfrazada" ? p.zero : p.exact]!.cos;
        prodShown = GC * GR;
      } else if (hoverK !== null || t >= START[3]!) {
        const idx = sel ?? p.zero;
        const vv = pick(idx);
        note = (k) => vv[k]!;
        cos = p.sweep[idx]!.cos;
        prodShown = GC * GR;
        cosGhost = p.cosClean;
      } else if (t >= START[2]!) {
        const m0 = START[2]! + 300;
        const vv = pick(p.zero);
        let sum = 0;
        note = (k) => {
          const u = ease(clamp((t - m0 - rnd(k + 11) * 900) / 380));
          return lerp(p.clean[k]!, vv[k]!, u);
        };
        for (let k = 0; k < GC * GR; k++) sum += ease(clamp((t - m0 - rnd(k + 11) * 900) / 380));
        cos = lerp(p.cosClean, p.sweep[p.zero]!.cos, sum / (GC * GR));
        prodShown = GC * GR;
        cosGhost = p.cosClean;
      } else if (t >= START[1]!) {
        const s1 = START[1]!;
        note = (k) => (t >= s1 + SPARK0 + p.sparks[k]!.d * SPARKS + SPARK ? p.clean[k]! : null);
        const pf = (t - s1 - 1850) / 850;
        prodShown = Math.round(clamp(pf) * GC * GR);
        if (prodShown > 0) {
          let sum = 0;
          let total = 0;
          for (let k = 0; k < GC * GR; k++) {
            const pr = p.stored[k]! * p.clean[k]!;
            total += pr;
            if (k < prodShown) sum += pr;
          }
          cos = (sum / total) * p.cosClean;
        }
      }
      drawGrid(G1, note, p.scale, cell);
      drawGrid(
        G2,
        (k) => {
          if (k >= prodShown) return null;
          const nv = note(k);
          return nv === null ? null : p.stored[k]! * nv;
        },
        p.pscale,
        cell,
      );
      // Mientras se llena casilla por casilla, la casilla de ahora se marca.
      if (prodShown > 0 && prodShown < GC * GR) {
        const k = prodShown - 1;
        ctx.strokeStyle = "#fff";
        ctx.lineWidth = 1.5;
        ctx.strokeRect(G2.x + (k % GC) * cell, G2.y + Math.floor(k / GC) * cell, cell, cell);
        ctx.strokeRect(G0.x + (k % GC) * cell, G0.y + Math.floor(k / GC) * cell, cell, cell);
        ctx.strokeRect(G1.x + (k % GC) * cell, G1.y + Math.floor(k / GC) * cell, cell, cell);
      }
      for (const [i, o] of lay.ops.entries()) text(i === 0 ? "×" : "=", o.x, o.y + 7, 20, dim, 400, "center");

      // Chispas: la nota viaja a sus 192 números; cada una llega a su casilla y toma su color.
      if (!listening && hoverK === null && t > START[1]! && t < START[1]! + SPARK0 + SPARKS + SPARK) {
        const e = data.espectro;
        const lift = Math.min(60, S.h * 0.25);
        for (const s of p.sparks) {
          const life = (t - START[1]! - SPARK0 - s.d * SPARKS) / SPARK;
          if (life <= 0 || life >= 1) continue;
          const x0 = S.x + ((s.c + 0.5) / e.columnas) * S.w;
          const y0 = S.y + S.h - ((s.r + 0.5) / e.filas) * S.h;
          const x1 = G1.x + ((s.k % GC) + 0.5) * cell;
          const y1 = G1.y + (Math.floor(s.k / GC) + 0.5) * cell;
          const to = cellColor(p.clean[s.k]!, p.scale);
          for (let j = 2; j >= 0; j--) {
            const u = inout(clamp(life - j * 0.05));
            const x = lerp(x0, x1, u);
            const y = lerp(y0, y1, u) - Math.sin(u * Math.PI) * lift;
            const c = [255, 236, 200].map((v, i) => lerp(v, to[i]!, u));
            const size = j === 0 ? 4 : 3 - j * 0.6;
            ctx.fillStyle = rgb(c, j === 0 ? 1 : 0.45 / j);
            ctx.fillRect(x - size / 2, y - size / 2, size, size);
          }
        }
      }

      // El parecido: el número y su barra con el umbral de revisión.
      const Gg = lay.gauge;
      text(L.similarity, lay.num.x, lay.num.y - lay.big + 2, fs, dim, 700);
      if (cos !== null) {
        const strong = cos >= cfg.thr;
        text(fmt(cos), lay.num.x, lay.num.y + 6, lay.big, strong ? "#e7ad45" : "#fff", 700);
      }
      ctx.fillStyle = "rgb(255 255 255 / 0.12)";
      ctx.fillRect(Gg.x, Gg.y, Gg.w, Gg.h);
      if (cos !== null) {
        ctx.fillStyle = cos >= cfg.thr ? "#e7ad45" : "rgb(255 236 200 / 0.9)";
        ctx.fillRect(Gg.x, Gg.y, Math.max(0, cos) * Gg.w, Gg.h);
      }
      // Lo que queda: también la disfrazada, para ver cuánto volvió.
      let ghostY = Gg.y - 6;
      if (!listening && hoverK === null && t >= START[4]!) {
        const u = ease(clamp((t - START[4]!) / 400));
        const c0 = p.sweep[p.zero]!.cos;
        const x0 = Gg.x + c0 * Gg.w;
        const col = `rgb(255 255 255 / ${(0.9 * u).toFixed(3)})`;
        const tag = `${L.versions[1]} ${fmt(c0)}`;
        ctx.fillStyle = col;
        ctx.fillRect(x0 - 1, Gg.y - 4, 2, Gg.h + 8);
        text(tag, x0, Gg.y - 6, fs - 1, col, 700, "left");
        ctx.font = `700 ${fs - 1}px ${font}`;
        const end0 = x0 + ctx.measureText(tag).width;
        if (cosGhost !== null) {
          const start1 = Gg.x + cosGhost * Gg.w - ctx.measureText(`${L.versions[0]} ${fmt(cosGhost)}`).width;
          if (start1 < end0 + 8) ghostY -= fs + 4;
        }
      }
      if (cosGhost !== null) {
        const gx = Gg.x + cosGhost * Gg.w;
        ctx.setLineDash([3, 3]);
        ctx.strokeStyle = "rgb(231 173 69 / 0.9)";
        ctx.lineWidth = 1.5;
        ctx.strokeRect(Gg.x, Gg.y, cosGhost * Gg.w, Gg.h);
        ctx.setLineDash([]);
        if (ghostY < Gg.y - 6) {
          ctx.fillStyle = "rgb(231 173 69 / 0.9)";
          ctx.fillRect(gx - 0.75, ghostY + 3, 1.5, Gg.y - ghostY - 3);
        }
        text(`${L.versions[0]} ${fmt(cosGhost)}`, gx, ghostY, fs - 1, "#e7ad45", 700, "right");
      }
      const tx = Gg.x + cfg.thr * Gg.w;
      ctx.fillStyle = "#fff";
      ctx.fillRect(tx - 1, Gg.y - 5, 2, Gg.h + 10);
      text(
        `${L.threshold} ${fmt(cfg.thr)}`,
        Math.min(tx, Gg.x + Gg.w),
        Gg.y + Gg.h + fs + 6,
        fs - 1,
        dim,
        400,
        tx > Gg.x + Gg.w * 0.6 ? "right" : "left",
      );

      // Qué quiere decir cada color.
      {
        const { x, y } = lay.legend;
        const sw = Math.max(9, Math.min(12, cell));
        ctx.fillStyle = rgb(OCRE);
        ctx.fillRect(x, y - sw + 1, sw, sw);
        text(L.positive, x + sw + 6, y, fs - 1, dim);
        ctx.font = `400 ${fs - 1}px ${font}`;
        const x2 = x + sw + 6 + ctx.measureText(L.positive).width + 18;
        ctx.fillStyle = rgb(AZUL);
        ctx.fillRect(x2, y - sw + 1, sw, sw);
        text(L.negative, x2 + sw + 6, y, fs - 1, dim);
      }

      // ---------- El barrido ----------
      const showBars = listening || hoverK !== null || t >= s3;
      text(L.sweep, B.x, B.y + fs, fs, dim, 700);
      const chartTop = B.y + fs + 14;
      const chartBottom = B.y + B.h - fs - 8;
      const ch = chartBottom - chartTop;
      const maxV = 0.8;
      const slot = B.w / n;
      const yv = (c: number) => chartBottom - clamp(c / maxV) * ch;
      // Las líneas de referencia: el umbral y la limpia.
      for (const [c, name, color] of [
        [cfg.thr, `${L.threshold} ${fmt(cfg.thr)}`, "rgb(255 255 255 / 0.7)"],
        [p.cosClean, `${L.versions[0]} ${fmt(p.cosClean)}`, "rgb(231 173 69 / 0.85)"],
      ] as [number, string, string][]) {
        const y = yv(c);
        ctx.setLineDash([4, 4]);
        ctx.strokeStyle = color;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(B.x, y);
        ctx.lineTo(B.x + B.w, y);
        ctx.stroke();
        ctx.setLineDash([]);
        text(name, B.x + B.w, y - 4, fs - 1, color, 700, "right");
      }
      ctx.fillStyle = "rgb(255 255 255 / 0.25)";
      ctx.fillRect(B.x, chartBottom, B.w, 1);
      p.sweep.forEach((s, i) => {
        const cx = B.x + (i + 0.5) * slot;
        const every = slot < 24 ? 4 : slot < 34 ? 2 : 1;
        if (i % every === 0 || i === p.best || i === sel) {
          text(
            signed(s.k),
            cx,
            chartBottom + fs + 6,
            fs - 1,
            i === sel ? "#fff" : dim,
            i === sel ? 700 : 400,
            "center",
          );
        }
        if (!showBars) return;
        let g = 1;
        if (!listening && hoverK === null && t < sweepEnd + 200)
          g = i > ki ? 0 : ease(clamp((t - s3 - i * STEP_K) / 160));
        if (g <= 0) return;
        const bw = Math.max(4, Math.min(22, slot * 0.56));
        const y = yv(s.cos * g);
        const isSel = i === sel;
        const isBest = i === p.best && (hoverK !== null || t >= sweepEnd);
        ctx.fillStyle = isBest ? "#e7ad45" : isSel ? "#fff" : "rgb(214 209 202 / 0.55)";
        ctx.fillRect(cx - bw / 2, y, bw, chartBottom - y);
        if (isSel || isBest) text(fmt(s.cos), cx, y - 6, fs - 1, isBest ? "#e7ad45" : "#fff", 700, "center");
      });
    };

    /** Los pasos, el texto del paso y las cifras, según el tiempo. */
    const ui = () => {
      let step = 0;
      START.forEach((s, i) => {
        if (t >= s) step = i;
      });
      steps.forEach((b, i) => {
        b.style.setProperty("--p", String(clamp((t - START[i]!) / DUR[i]!)));
        if (i === step) b.setAttribute("aria-current", "step");
        else b.removeAttribute("aria-current");
      });
      if (step !== lastStep) {
        lastStep = step;
        caps.forEach((c, i) => c.classList.toggle("is-on", i === step));
      }
    };

    const render = () => {
      draw();
      ui();
    };

    const frame = (now: number) => {
      if (playing) {
        t = Math.min(to, from + (now - t0));
        if (t >= to) playing = false;
      }
      render();
      raf = playing || listening ? requestAnimationFrame(frame) : 0;
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };
    const play = (a: number, b: number) => {
      if (reduce.matches) {
        playing = false;
        t = b;
        render();
        return;
      }
      from = a;
      to = b;
      t0 = performance.now();
      playing = true;
      kick();
    };

    // ---------- Las 28 voces: una matriz por versión ----------
    let matricesSeen = false;
    const drawMatrices = (u: number) => {
      if (!data) return;
      const V = data.voces;
      const N = V.n;
      for (const c of matrices) {
        const key = c.dataset.matrix as Version;
        const s = V[key];
        const size = c.clientWidth;
        if (!size) continue;
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        c.width = Math.round(size * dpr);
        c.height = Math.round(size * dpr);
        const g = c.getContext("2d");
        if (!g) continue;
        g.setTransform(dpr, 0, 0, dpr, 0, 0);
        g.clearRect(0, 0, size, size);
        const cs = size / N;
        const val = (i: number, j: number) => Number(s.slice((i * N + j) * 2, (i * N + j) * 2 + 2)) / 100;
        for (let i = 0; i < N; i++) {
          const ri = clamp(u * 1.35 - (i / N) * 0.35);
          if (ri <= 0) continue;
          let best = 0;
          for (let j = 0; j < N; j++) {
            const x = val(i, j);
            if (x > val(i, best)) best = j;
            g.fillStyle = rgb(ramp(x / 0.85), ri);
            g.fillRect(j * cs + 0.5, i * cs + 0.5, cs - 1, cs - 1);
          }
          // La diagonal: la misma persona.
          g.strokeStyle = `rgb(255 255 255 / ${(0.28 * ri).toFixed(3)})`;
          g.lineWidth = 1;
          g.strokeRect(i * cs + 0.5, i * cs + 0.5, cs - 1, cs - 1);
          // El punto: la voz más parecida de la fila.
          const dot = clamp((u - 0.75) / 0.25);
          if (dot > 0) {
            g.fillStyle = `rgb(255 255 255 / ${dot.toFixed(3)})`;
            g.beginPath();
            g.arc((best + 0.5) * cs, (i + 0.5) * cs, Math.max(1.8, cs * 0.24), 0, Math.PI * 2);
            g.fill();
            g.strokeStyle = `rgb(18 12 9 / ${dot.toFixed(3)})`;
            g.lineWidth = 1.5;
            g.stroke();
          }
        }
      }
    };
    const animateMatrices = () => {
      if (reduce.matches) {
        drawMatrices(1);
        return;
      }
      const t1 = performance.now();
      const step = (now: number) => {
        const u = clamp((now - t1) / 1400);
        drawMatrices(u);
        if (u < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const load = async () => {
      if (data) return;
      data = (await import("../data/voz-huella.json")).default as unknown as Data;
      prepare();
      measure();
      render();
      drawMatrices(reduce.matches || matricesSeen ? 1 : 0);
    };

    const start = async () => {
      await load();
      replay.classList.add("is-on");
      hint.hidden = false;
      play(0, END);
    };

    steps.forEach((b, i) =>
      b.addEventListener("click", async () => {
        await load();
        replay.classList.add("is-on");
        hint.hidden = false;
        play(START[i]!, START[i]! + DUR[i]!);
      }),
    );
    replay.addEventListener("click", () => play(0, END));

    // El puntero sobre el barrido: muestra ese tono.
    const pickBar = (e: PointerEvent) => {
      if (!lay || !prep) return;
      const box = canvas.getBoundingClientRect();
      const x = e.clientX - box.left;
      const y = e.clientY - box.top;
      const B = lay.bars;
      let next: number | null = null;
      if (y >= B.y && y <= B.y + B.h && x >= B.x && x <= B.x + B.w) {
        next = Math.min(prep.sweep.length - 1, Math.max(0, Math.floor(((x - B.x) / B.w) * prep.sweep.length)));
      }
      if (next === hoverK) return;
      hoverK = next;
      if (!raf) render();
    };
    canvas.addEventListener("pointermove", pickBar);
    canvas.addEventListener("pointerdown", pickBar);
    canvas.addEventListener("pointerleave", (e) => {
      if (e.pointerType === "touch") return;
      hoverK = null;
      if (!raf) render();
    });

    // Audios: uno a la vez; el botón dice si suena y el dibujo sigue al audio.
    const audios = new Map<string, HTMLAudioElement>();
    root.querySelectorAll<HTMLAudioElement>("audio[data-audio]").forEach((a) => audios.set(a.dataset.audio!, a));
    for (const b of root.querySelectorAll<HTMLButtonElement>(".vz__play")) {
      const v = b.dataset.clip as Version;
      const a = audios.get(v);
      if (!a) continue;
      const stop = () => {
        b.setAttribute("aria-pressed", "false");
        if (listening?.a === a) {
          listening = null;
          if (!raf) render();
        }
      };
      a.addEventListener("ended", stop);
      a.addEventListener("pause", stop);
      a.addEventListener("play", () => {
        b.setAttribute("aria-pressed", "true");
        listening = { v, a };
        void load().then(kick);
      });
      b.addEventListener("click", () => {
        if (!a.paused) {
          a.pause();
          return;
        }
        audios.forEach((o) => o !== a && o.pause());
        a.currentTime = 0;
        void a.play();
      });
    }

    new ResizeObserver(() => {
      if (!data) return;
      measure();
      render();
      if (matricesSeen) drawMatrices(1);
    }).observe(viz);

    if (reduce.matches) t = END;
    if (!("IntersectionObserver" in window)) {
      void start().then(() => {
        matricesSeen = true;
        drawMatrices(1);
      });
      continue;
    }
    const near = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          near.disconnect();
          void load();
        }
      },
      { rootMargin: "600px 0px" },
    );
    near.observe(section);
    const seen = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          seen.disconnect();
          void start();
        }
      },
      { threshold: 0.45 },
    );
    seen.observe(viz);
    const seenM = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          seenM.disconnect();
          void load().then(() => {
            matricesSeen = true;
            animateMatrices();
          });
        }
      },
      { threshold: 0.35 },
    );
    const figs = section.querySelector("[data-matrices]");
    if (figs) seenM.observe(figs);
  }
</script>
