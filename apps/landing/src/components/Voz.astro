<script>
  document.querySelectorAll<HTMLElement>("[data-voz]").forEach((root) => {
    // Audios: uno a la vez; el botón dice si suena.
    const audios = new Map<string, HTMLAudioElement>();
    root.querySelectorAll<HTMLAudioElement>("audio[data-audio]").forEach((a) => audios.set(a.dataset.audio!, a));
    const buttons = [...root.querySelectorAll<HTMLButtonElement>(".va__play")];
    // El nombre no cambia ("Escuchar…"): aria-pressed dice si suena y el ícono pasa a pausa.
    const setPressed = (b: HTMLButtonElement, on: boolean) => b.setAttribute("aria-pressed", String(on));
    for (const b of buttons) {
      const a = audios.get(b.dataset.clip!);
      if (!a) continue;
      a.addEventListener("ended", () => setPressed(b, false));
      a.addEventListener("pause", () => setPressed(b, false));
      a.addEventListener("play", () => setPressed(b, true));
      b.addEventListener("click", () => {
        if (!a.paused) {
          a.pause();
          return;
        }
        audios.forEach((o) => o !== a && o.pause());
        a.currentTime = 0;
        void a.play();
      });
    }

    // Animación: con movimiento reducido o sin IntersectionObserver se queda el estado final.
    if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;
    const replay = root.querySelector<HTMLButtonElement>("[data-replay]");
    const play = () => {
      root.classList.remove("is-playing");
      root.classList.add("is-armed");
      void root.offsetWidth;
      requestAnimationFrame(() => {
        root.classList.remove("is-armed");
        root.classList.add("is-playing");
      });
    };
    root.classList.add("is-armed");
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          play();
          if (replay) replay.hidden = false;
        }
      },
      { threshold: 0.3 },
    );
    io.observe(root);
    replay?.addEventListener("click", play);
  });
</script>
