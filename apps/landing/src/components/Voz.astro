      border-bottom: 1px solid var(--linea);
      padding-block: 10px;
    }

    .vt tbody th,
    .vt tbody td {
      border: 0;
      padding: 4px 0;
    }

    .vt tbody th,
    .vt tbody td:nth-child(2) {
      grid-column: 1 / -1;
