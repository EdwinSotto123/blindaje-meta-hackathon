---
/**
 * Beneficios por actor. La víctima en una fila con imagen: una bodega de Lima y la app por fuera (el
 * disfraz de cuaderno) y por dentro (el recorrido de una nota), en capturas reales del emulador. La
 * comunidad y la autoridad, en dos columnas de texto: sus capturas ya están en el mapa y en el recorrido
 * del producto.
 */
import { getImage } from "astro:assets";
import type { Dict } from "../i18n";
import { productShot } from "../lib/screenshots";
import Icon from "./Icon.astro";
import bodega from "../assets/fotos/bodega.jpg";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const b = d.lp.benefits;
const il = d.actors.victim.illo;
const [outsideLabel] = il.outside.split(":");
const [insideLabel] = il.inside.split(":");

const bodegaImg = await getImage({ src: bodega, widths: [360, 540, 768], format: "webp", quality: 76 });
/** La app de la víctima por fuera (el disfraz de cuaderno) y por dentro (las notas), del emulador. */
const appShots = await Promise.all(
  (
    [
      ["app-disfraz-cuaderno", d.actors.victim.shotOutsideAlt],
      ["app-audio-recorrido", d.actors.victim.shotInsideAlt],
    ] as const
  ).map(async ([name, alt]) => {
    const image = productShot(name);
    if (!image) return null;
    const img = await getImage({
      src: image,
      widths: [200, 300, 400, 600].filter((w) => w <= image.width),
      format: "webp",
      quality: 80,
    });
    return { image, img, alt };
  }),
);
const [victim, ...others] = b.audiences;
---

<section class="section on-paper-2" id="beneficios" aria-labelledby="beneficios-title">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <h2 id="beneficios-title" class="head">
        {b.title}
      </h2>
      <p class="lead soft">{b.lead}</p>
    </div>

    {victim && (
      <article class="row" aria-labelledby={`aud-${victim.id}`} data-reveal>
        <div class="row__text">
          <h3 id={`aud-${victim.id}`} class="head row__name">
            {victim.name}
          </h3>
          <p class="lead row__title">{victim.title}</p>
          <ul class="checks" role="list">
            {victim.points.map((p) => (
              <li>
                <Icon name="check" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="row__visual">
          <figure class="ill" aria-label={il.label}>
            <div class="ill__stage">
              <div class="foto ill__photo">
                <img
                  src={bodegaImg.src}
                  srcset={bodegaImg.srcSet.attribute}
                  sizes="(min-width: 960px) 320px, 56vw"
                  width={bodega.width}
                  height={bodega.height}
                  alt={b.victimPhotoAlt}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="ill__phones">
                {appShots.map((shot, k) =>
                  shot ? (
                    <div class:list={["mp", k === 1 && "mp--inside"]}>
                      <div class="mp__shot">
                        <img
                          src={shot.img.src}
                          srcset={shot.img.srcSet.attribute}
                          sizes="(min-width: 960px) 220px, 42vw"
                          width={shot.image.width}
                          height={shot.image.height}
                          alt={shot.alt}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      {k === 0 ? (
                        <p class="mp__label">{outsideLabel}</p>
                      ) : (
                        <p class="mp__label">
                          <Icon name="key" />
                          {insideLabel}
                        </p>
                      )}
                    </div>
                  ) : null,
                )}
              </div>
            </div>
            <figcaption class="cap">
              {b.illustration} {b.victimPhotoCredit}
            </figcaption>
          </figure>
        </div>
      </article>
    )}

    <div class="pair">
      {others.map((a) => (
        <article class="pair__item" aria-labelledby={`aud-${a.id}`} data-reveal>
          <h3 id={`aud-${a.id}`} class="head row__name">
            {a.name}
          </h3>
          <p class="lead row__title">{a.title}</p>
          <ul class="checks" role="list">
            {a.points.map((p) => (
              <li>
                <Icon name="check" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Comunidad y autoridad: dos columnas de texto, separadas de la víctima por una línea. */
  .pair {
    display: grid;
    gap: 48px;
    margin-top: 88px;
    padding-top: 64px;
    border-top: 1px solid var(--linea);
  }

  .pair__item {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  @media (min-width: 960px) {
    .pair {
      grid-template-columns: 1fr 1fr;
      gap: 72px;
    }
  }

  .row {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .row__text {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .row__title {
    margin-bottom: 8px;
    color: var(--ink-2);
  }

  @media (min-width: 960px) {
    .row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 72px;
    }
  }

  /* ---------- Víctima: la app por fuera y por dentro (capturas reales) ---------- */

  .ill {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  /* La bodega y, a su lado, la app por fuera y por dentro: tres piezas en fila, sin encimarse. */
  .ill__stage {
    display: grid;
    gap: 16px;
    max-width: 680px;
  }

  /* En el celular la bodega es una franja baja: los dos teléfonos son los que explican la app. */
  .ill__photo {
    aspect-ratio: 16 / 7;
  }

  .ill__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  .ill__phones {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    align-items: start;
  }

  @media (min-width: 640px) {
    .ill__stage {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
      align-items: start;
    }

    .ill__photo {
      aspect-ratio: auto;
      height: 100%;
      min-height: 360px;
    }
  }

  .mp {
    display: grid;
    gap: 10px;
  }

  .mp--inside {
    margin-top: 40px;
  }

  /* El marco de celular de la landing con la captura real; abajo se funde con el papel de la app. */
  .mp__shot {
    position: relative;
    overflow: hidden;
    border: 7px solid var(--noche);
    border-radius: 28px;
    background: #fbfcfe;
    box-shadow: var(--lift);
  }

  .mp__shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .mp__shot::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 14%;
    background: linear-gradient(to bottom, rgb(251 252 254 / 0), #fbfcfe 85%);
    pointer-events: none;
  }

  .mp__label :global(.icon) {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mp__label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-weight: 700;
    color: var(--ink-2);
  }

  @media (max-width: 639px) {
    .ill__phones {
      gap: 8px;
    }

    .mp--inside {
      margin-top: 24px;
    }

    .mp__shot {
      border-width: 5px;
      border-radius: 22px;
    }
  }
</style>
