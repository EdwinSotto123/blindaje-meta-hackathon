---
/**
 * Beneficios por actor, en tres filas que alternan lado: la víctima (una bodega de Lima y la app por
 * fuera y por dentro, en capturas reales del emulador), la comunidad y los negocios (el portal real y una alerta aprobada) y
 * la autoridad (el perfil real de una red y el índice del expediente). Cada fila: el actor, lo que gana
 * y sus vistos.
 */
import { getImage } from "astro:assets";
import type { Dict } from "../i18n";
import { productShot } from "../lib/screenshots";
import Icon from "./Icon.astro";
import bodega from "../assets/fotos/bodega.jpg";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const b = d.lp.benefits;
const il = d.actors.victim.illo;
const [outsideLabel] = il.outside.split(":");
const [insideLabel] = il.inside.split(":");

const bodegaImg = await getImage({ src: bodega, widths: [360, 540, 768], format: "webp", quality: 76 });
/** La app de la víctima por fuera (el disfraz de cuaderno) y por dentro (las notas), del emulador. */
const appShots = await Promise.all(
  (
    [
      ["app-disfraz-cuaderno", d.actors.victim.shotOutsideAlt],
      ["app-notas-privadas", d.actors.victim.shotInsideAlt],
    ] as const
  ).map(async ([name, alt]) => {
    const image = productShot(name);
    if (!image) return null;
    const img = await getImage({
      src: image,
      widths: [200, 300, 400, 600].filter((w) => w <= image.width),
      format: "webp",
      quality: 80,
    });
    return { image, img, alt };
  }),
);
const portal = productShot("portal-mapa-movil");
const profile = productShot("consola-perfil-cartografo");
const portalImg = portal
  ? await getImage({
      src: portal,
      widths: [280, 420, 560].filter((w) => w <= portal.width),
      format: "webp",
      quality: 80,
    })
  : null;
const profileImg = profile
  ? await getImage({
      src: profile,
      widths: [560, 840, 1120].filter((w) => w <= profile.width),
      format: "webp",
      quality: 80,
    })
  : null;
---

<section class="section on-paper-2" id="beneficios" aria-labelledby="beneficios-title">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <h2 id="beneficios-title" class="head">
        {b.title}
      </h2>
      <p class="lead soft">{b.lead}</p>
    </div>

    <div class="rows">
      {b.audiences.map((a, i) => (
        <article class:list={["row", i % 2 === 1 && "row--flip"]} aria-labelledby={`aud-${a.id}`} data-reveal>
          <div class="row__text">
            <h3 id={`aud-${a.id}`} class="head row__name">
              {a.name}
            </h3>
            <p class="lead row__title">{a.title}</p>
            <ul class="checks" role="list">
              {a.points.map((p) => (
                <li>
                  <Icon name="check" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="row__visual">
            {a.id === "victim" && (
              <figure class="ill" aria-label={il.label}>
                <div class="ill__stage">
                  <div class="foto ill__photo">
                    <img
                      src={bodegaImg.src}
                      srcset={bodegaImg.srcSet.attribute}
                      sizes="(min-width: 960px) 320px, 56vw"
                      width={bodega.width}
                      height={bodega.height}
                      alt={b.victimPhotoAlt}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="ill__phones">
                    {appShots.map((shot, k) =>
                      shot ? (
                        <div class:list={["mp", k === 1 && "mp--inside"]}>
                          <div class="mp__shot">
                            <img
                              src={shot.img.src}
                              srcset={shot.img.srcSet.attribute}
                              sizes="(min-width: 960px) 220px, 42vw"
                              width={shot.image.width}
                              height={shot.image.height}
                              alt={shot.alt}
                              loading="lazy"
                              decoding="async"
                            />
                          </div>
                          {k === 0 ? (
                            <p class="mp__label">{outsideLabel}</p>
                          ) : (
                            <p class="mp__label">
                              <Icon name="key" />
                              {insideLabel}
                            </p>
                          )}
                        </div>
                      ) : null,
                    )}
                  </div>
                </div>
                <figcaption class="cap">
                  {b.illustration} {b.victimPhotoCredit}
                </figcaption>
              </figure>
            )}

            {a.id === "community" && portal && portalImg && (
              <figure class="duo">
                <div class="duo__phone">
                  <img
                    src={portalImg.src}
                    srcset={portalImg.srcSet.attribute}
                    sizes="(min-width: 960px) 280px, 60vw"
                    width={portal.width}
                    height={portal.height}
                    alt={d.actors.community.shot.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="alert-card" data-ui>
                  <p class="alert-card__title">
                    <Icon name="alert" />
                    {d.intel.alert.cardTitle}
                  </p>
                  <p>{d.intel.alert.card}</p>
                  <p class="alert-card__meta">{d.intel.alert.cardMeta}</p>
                </div>
                <figcaption class="cap duo__cap">{d.actors.community.shot.caption}</figcaption>
              </figure>
            )}

            {a.id === "authority" && profile && profileImg && (
              <figure class="duo duo--doc">
                <div class="duo__win">
                  <img
                    src={profileImg.src}
                    srcset={profileImg.srcSet.attribute}
                    sizes="(min-width: 960px) 560px, 92vw"
                    width={profile.width}
                    height={profile.height}
                    alt={d.actors.authority.shot.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="doc-card" data-ui>
                  <p class="doc-card__title">
                    <Icon name="file" />
                    {d.lang === "es" ? "Expediente R-001.pdf" : "Case file R-001.pdf"}
                  </p>
                  <ul role="list">
                    {d.actors.authority.dossier.map((x) => (
                      <li>
                        <Icon name="check" />
                        {x.title}
                      </li>
                    ))}
                  </ul>
                </div>
                <figcaption class="cap duo__cap">{d.actors.authority.shot.caption}</figcaption>
              </figure>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .rows {
    display: grid;
    gap: 88px;
  }

  .row {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .row__text {
    display: grid;
    gap: 16px;
    align-content: start;
  }

  .row__title {
    margin-bottom: 8px;
    color: var(--ink-2);
  }

  @media (min-width: 960px) {
    .row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 72px;
    }

    .row--flip .row__text {
      order: 2;
    }

    .row--flip {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  /* ---------- Víctima: la app por fuera y por dentro (capturas reales) ---------- */

  .ill {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  /* La bodega y, a su lado, la app por fuera y por dentro: tres piezas en fila, sin encimarse. */
  .ill__stage {
    display: grid;
    gap: 16px;
    max-width: 680px;
  }

  /* En el celular la bodega es una franja baja: los dos teléfonos son los que explican la app. */
  .ill__photo {
    aspect-ratio: 16 / 7;
  }

  .ill__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  .ill__phones {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    align-items: start;
  }

  @media (min-width: 640px) {
    .ill__stage {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
      align-items: start;
    }

    .ill__photo {
      aspect-ratio: auto;
      height: 100%;
      min-height: 360px;
    }
  }

  .mp {
    display: grid;
    gap: 10px;
  }

  .mp--inside {
    margin-top: 40px;
  }

  /* El marco de celular de la landing con la captura real; abajo se funde con el papel de la app. */
  .mp__shot {
    position: relative;
    overflow: hidden;
    border: 7px solid var(--noche);
    border-radius: 28px;
    background: #fbfcfe;
    box-shadow: var(--lift);
  }

  .mp__shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .mp__shot::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 14%;
    background: linear-gradient(to bottom, rgb(251 252 254 / 0), #fbfcfe 85%);
    pointer-events: none;
  }

  .mp__label :global(.icon) {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mp__label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-weight: 700;
    color: var(--ink-2);
  }

  /* ---------- Gremio y autoridad: captura real y una tarjeta encima ---------- */

  .duo {
    position: relative;
    display: grid;
    max-width: 620px;
    margin: 0;
  }

  .duo__phone {
    width: min(62%, 300px);
    aspect-ratio: 9 / 15;
    padding: 7px;
    border-radius: 30px;
    background: var(--noche);
    box-shadow: var(--lift);
  }

  .duo__phone img {
    width: 100%;
    height: 100%;
    border-radius: 23px;
    object-fit: cover;
    object-position: top;
  }

  .alert-card,
  .doc-card {
    position: absolute;
    display: grid;
    gap: 8px;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: var(--papel);
    color: var(--tinta);
    font-size: 0.9375rem;
    line-height: 1.45;
    box-shadow: var(--lift);
  }

  .alert-card {
    right: 0;
    top: 22%;
    width: min(56%, 340px);
  }

  /* La alerta lleva el ocre en su ícono, como en el portal. */
  .alert-card__title :global(.icon) {
    width: 26px;
    height: 26px;
    padding: 4px;
    border-radius: 50%;
    background: var(--ocre-suave);
  }

  .alert-card__title,
  .doc-card__title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
  }

  .alert-card :global(.icon),
  .doc-card :global(.icon) {
    flex: none;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .alert-card__meta {
    color: var(--tinta-2);
    font-size: var(--step-small);
  }

  .duo__cap {
    margin-top: 16px;
  }

  .duo__win {
    width: 88%;
    max-height: 460px;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--papel);
    box-shadow: var(--lift);
  }

  .duo__win img {
    width: 100%;
  }

  .doc-card {
    right: 0;
    bottom: 40px;
    width: min(52%, 300px);
  }

  .doc-card ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .doc-card li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .doc-card li :global(.icon) {
    width: 18px;
    height: 18px;
    padding: 3px;
    border-radius: 50%;
    background: var(--num-bg);
    stroke: var(--num-ink);
    stroke-width: 3;
  }

  @media (max-width: 639px) {
    .alert-card,
    .doc-card {
      position: static;
      width: auto;
      margin-top: 16px;
    }

    .duo__phone {
      width: 72%;
    }

    .duo__win {
      width: 100%;
      max-height: 320px;
    }

    .ill__phones {
      gap: 8px;
    }

    .mp--inside {
      margin-top: 24px;
    }

    .mp__shot {
      border-width: 5px;
      border-radius: 22px;
    }
  }
</style>
