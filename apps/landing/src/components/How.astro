---
/**
 * Cómo funciona: el recorrido completo animado con el scroll (Flow.astro, seis escenas del audio al
 * distrito) y la demo de revisión, donde el visitante hace de revisora.
 */
import type { Dict } from "../i18n";
import Flow from "./Flow.astro";
import LinkDemo from "./LinkDemo.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const h = d.lp.how;
---

<section class="section how" id="como-funciona" aria-labelledby="como-title">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <h2 id="como-title" class="head">
        {h.title}
      </h2>
      <p class="lead soft">{h.lead}</p>
    </div>

    <Flow dict={d} />

    <div class="demo" data-reveal>
      <div class="demo__text">
        <h3 class="head">{h.demoTitle}</h3>
        <p class="lead soft">{h.demoLead}</p>
        <p class="small soft demo__rules">{d.intel.rules}</p>
      </div>
      <LinkDemo dict={d} />
    </div>
  </div>
</section>

<style>
  .demo {
    display: grid;
    gap: 32px;
    margin-top: 80px;
    padding-top: 64px;
    border-top: 1px solid var(--linea);
  }

  .demo__text {
    display: grid;
    gap: 14px;
    align-content: center;
  }

  .demo__rules {
    max-width: 36em;
  }

  @media (min-width: 960px) {
    .demo {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 64px;
      align-items: center;
    }
  }
</style>
