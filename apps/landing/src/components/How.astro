---
/** Cómo funciona: el recorrido completo animado con el scroll (Flow.astro, seis escenas del audio al distrito). */
import type { Dict } from "../i18n";
import Flow from "./Flow.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const h = d.lp.how;
---

<section class="section how" id="como-funciona" aria-labelledby="como-title">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <h2 id="como-title" class="head">
        {h.title}
      </h2>
      <p class="lead soft">{h.lead}</p>
    </div>

    <Flow dict={d} />
  </div>
</section>
