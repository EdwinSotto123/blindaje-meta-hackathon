---
/**
 * Cómo se unen los casos, animado con el scroll: cuatro escenas, de las piezas sueltas a la red.
 *
 *  1. Analiza    Muse Voice Transcribe, SAM 3.1 (las cajas reales de la foto del demo) y Muse Spark
 *  2. Compara    FAISS busca la voz de B en el índice: la de A (0.79) gana a siete voces de SLR73
 *                (huellas reales, src/data/flujo-vectores.json); voz 0.85 y guion 0.40 se combinan en
 *                0.91 (par A–B del demo, eval/report.json)
 *  3. Revisa     una revisora confirma; la auditoría queda encadenada
 *  4. Muestra    B–C por la cuenta …202 (p 0.95), la red R-001 y la alerta aprobada
 *
 * La historia completa está en el pitch (Pitch.astro); la voz en detalle en Voz.astro, las fotos en
 * Fotos.astro y el mapa en Where.astro: aquí no se repite.
 *
 * Sin JavaScript o con movimiento reducido, las escenas se ven quietas y completas, una debajo de
 * otra. Con movimiento, GSAP ScrollTrigger fija la sección y el scroll arma cada escena; la barra de
 * pasos salta a cada una. Solo se animan transform, opacity y trazos de SVG.
 */
import { getImage } from "astro:assets";
import type { Dict } from "../i18n";
import vec from "../data/flujo-vectores.json";
import mostrador from "../assets/flujo/mostrador.jpg";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const f = d.lp.how.flow;

const mostradorImg = await getImage({ src: mostrador, widths: [360, 540, 720], format: "webp", quality: 78 });

/** Cajas reales de SAM 3.1 sobre la foto del demo, en % del recorte del mostrador (1000 × 506). */
const BOXES = [
  { x: 29.5, y: 63.2, w: 9.1, h: 10.3, label: f.s2.bullet, below: true },
  { x: 40.6, y: 53.0, w: 35.5, h: 38.1, label: f.s2.note, below: false },
];

const transcript = f.s2.transcript.split(f.s2.highlight);
const audit = ["a91f…07c2", "77c0…e5d1", "e3d2…4b90"];
---

<div class="fl" data-flow>
  <nav class="fl__rail" aria-label={f.railLabel}>
    <ol role="list">
      {f.scenes.map((s, i) => (
        <li>
          <button type="button" class="fl__railbtn" data-goto={i} aria-current={i === 0 ? "step" : undefined}>
            <span class="fl__railbar" aria-hidden="true">
              <span class="fl__railfill" />
            </span>
            <span class="fl__raillabel">{s.label}</span>
          </button>
        </li>
      ))}
    </ol>
  </nav>

  <ol class="fl__body" role="list">
    {f.scenes.map((s, i) => (
      <li class="fl__scene" data-scene={i}>
        <div class="fl__copy">
          <p class="fl__step">
            <span class="fl__n num" aria-hidden="true">
              {i + 1}
            </span>
            {s.label}
          </p>
          <h3 class="fl__title">{s.title}</h3>
          <p class="fl__text soft">{s.text}</p>
          <ul class="fl__tags" role="list">
            {s.tags.map((t) => (
              <li class="tag" translate="no">
                {t}
              </li>
            ))}
          </ul>
        </div>

        <div class="fl__box" aria-hidden="true">
          {i === 0 && (
            <div class="sc s2">
              <div class="s2__lane">
                <span class="s2__in">
                  <Icon name="mic" />
                </span>
                <span class="s2__arrow" />
                <span class="s2__model">Muse Voice Transcribe</span>
                <span class="s2__arrow" />
                <p class="s2__out s2__quote">
                  <span class="s2__spk">A</span>
                  <span class="s2__words">
                    «{transcript[0]}
                    <mark>{f.s2.highlight}</mark>
                    {transcript[1]}»
                  </span>
                </p>
              </div>
              <div class="s2__lane">
                <span class="s2__in">
                  <Icon name="camera" />
                </span>
                <span class="s2__arrow" />
                <span class="s2__model">SAM 3.1</span>
                <span class="s2__arrow" />
                <div class="s2__out s2__photo">
                  <img
                    src={mostradorImg.src}
                    srcset={mostradorImg.srcSet.attribute}
                    sizes="320px"
                    width={mostrador.width}
                    height={mostrador.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  {BOXES.map((b) => (
                    <span
                      class:list={["s2__box", b.below && "s2__box--below"]}
                      style={`left:${b.x}%;top:${b.y}%;width:${b.w}%;height:${b.h}%`}
                    >
                      <span class="s2__boxlabel">{b.label}</span>
                    </span>
                  ))}
                </div>
              </div>
              <div class="s2__lane">
                <span class="s2__in">
                  <Icon name="clipboard" />
                </span>
                <span class="s2__arrow" />
                <span class="s2__model">Muse Spark 1.3</span>
                <span class="s2__arrow" />
                <dl class="s2__out s2__ficha">
                  {f.s2.fields.map((x) => (
                    <div class="s2__field">
                      <dt>{x.k}</dt>
                      <dd>{x.v}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
          )}

          {i === 1 && (
            <div class="sc s4">
              <div class="s4__grid">
                <p class="s4__case s4__case--a">
                  <strong>{f.s4.caseA}</strong>
                  <span>{f.s4.whereA}</span>
                </p>
                <p class="s4__case s4__case--b">
                  <strong>{f.s4.caseB}</strong>
                  <span>{f.s4.whereB}</span>
                </p>

                <span class="s4__k s4__k--voz">{f.s4.voice}</span>
                <span class="s4__v s4__a s4__v--voz">V-3</span>
                <span class="s4__link s4__link--voz">
                  <span class="s4__line" />
                  <span class="s4__why">{f.s4.voiceMatch}</span>
                </span>
                <span class="s4__v s4__b s4__v--voz s4__probe">V-7</span>

                <span class="s4__k s4__k--tel">{f.s4.phone}</span>
                <span class="s4__v s4__a s4__v--tel">…111</span>
                <span class="s4__link s4__link--tel">
                  <span class="s4__why s4__why--no">≠ {f.s4.phoneMismatch}</span>
                </span>
                <span class="s4__v s4__b s4__v--tel">…222</span>

                <span class="s4__k s4__k--mo">{f.s4.script}</span>
                <span class="s4__v s4__a s4__v--mo">«Habla con el jefe»</span>
                <span class="s4__link s4__link--mo">
                  <span class="s4__line" />
                  <span class="s4__why">{f.s4.scriptMatch}</span>
                </span>
                <span class="s4__v s4__b s4__v--mo">«Habla con el jefe»</span>

                <span class="s4__k s4__k--img">{f.s4.photo}</span>
                <span class="s4__v s4__a s4__v--img">IMG-1</span>
                <span class="s4__link s4__link--img">
                  <span class="s4__why s4__why--no">—</span>
                </span>
                <span class="s4__v s4__b s4__v--none">—</span>

                <div class="s4__index">
                  <p>
                    <img class="s4__px" src={vec.sonda.png} width="16" height="12" alt="" />
                    {f.s4.index}
                  </p>
                  <ul role="list">
                    {vec.indice.map((x) => (
                      <li class:list={[x.caso_a && "is-hit"]}>
                        <img class="s4__px" src={x.png} width="16" height="12" alt="" />
                        <span class="s4__vid">{x.id}</span>
                        <span class="s4__cos num">{x.coseno.toFixed(2)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="s4__meter">
                <div class="s4__track">
                  <span class="s4__fill" />
                  <span class="s4__tick" style="--x:0.6">
                    <span>{f.s4.review} 0.60</span>
                  </span>
                  <span class="s4__tick s4__tick--hi" style="--x:0.9">
                    <span>{f.s4.probable} 0.90</span>
                  </span>
                </div>
                <p class="s4__formula">
                  <code translate="no">1 − (1 − 0.85) × (1 − 0.40) =</code>
                  <strong class="s4__score num" data-score="0.91">
                    0.91
                  </strong>
                  <span class="s4__status">{f.s4.probable}</span>
                </p>
              </div>
            </div>
          )}

          {i === 2 && (
            <div class="sc s5">
              <div class="s5__card">
                <p class="s5__head">
                  <strong>{f.s5.title}</strong>
                  <span class="s5__status">{f.s5.status}</span>
                </p>
                <p class="s5__explain">{f.s5.explain}</p>
                <ul class="s5__cites" role="list">
                  {["EV-A1", "EV-A2", "EV-B1", "V-3", "V-7"].map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
                <div class="s5__actions">
                  <span class="s5__btn s5__btn--ok">
                    <Icon name="check" />
                    {f.s5.confirm}
                  </span>
                  <span class="s5__btn">{f.s5.dismiss}</span>
                  <span class="s5__done">
                    <Icon name="check" />
                    {f.s5.confirmed}
                  </span>
                </div>
                <svg class="s5__cursor" viewBox="0 0 24 24">
                  <path d="M5 3l14 8-6 1.5L10 19z" />
                </svg>
              </div>
              <div class="s5__audit">
                <p>{f.s5.audit}</p>
                <ol role="list">
                  {audit.map((h) => (
                    <li>
                      <code translate="no">{h}</code>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          )}

          {i === 3 && (
            <div class="sc s6">
              <svg class="s6__graph" viewBox="0 0 300 250">
                <ellipse class="s6__ring" cx="150" cy="128" rx="138" ry="108" pathLength="1" />
                <text class="s6__ringlabel" x="150" y="14" text-anchor="middle">
                  {f.s6.network}
                </text>
                <line class="s6__edge s6__edge--voz" x1="76" y1="78" x2="224" y2="78" pathLength="1" />
                <line class="s6__edge s6__edge--id" x1="224" y1="78" x2="150" y2="190" pathLength="1" />
                <text class="s6__elabel" x="150" y="68" text-anchor="middle">
                  {f.s6.sameVoice}
                </text>
                <text class="s6__elabel" x="204" y="148" text-anchor="start">
                  {f.s6.sameAccount}
                </text>
                {[
                  { k: "A", sub: "SJL", x: 76, y: 78 },
                  { k: "B", sub: "Comas", x: 224, y: 78 },
                  { k: "C", sub: "SJL", x: 150, y: 190 },
                ].map((n) => (
                  <g class="s6__node" transform={`translate(${n.x} ${n.y})`}>
                    <rect x="-30" y="-20" width="60" height="40" rx="10" />
                    <text y="-2" text-anchor="middle" class="s6__nk">
                      {n.k}
                    </text>
                    <text y="13" text-anchor="middle" class="s6__ns">
                      {n.sub}
                    </text>
                  </g>
                ))}
              </svg>

              <div class="s6__map">
                <div class="s6__alert">
                  <p class="s6__alerttitle">
                    <Icon name="alert" />
                    {f.s6.alertTitle}
                  </p>
                  <p>{f.s6.alert}</p>
                </div>
              </div>
            </div>
          )}
        </div>
      </li>
    ))}
  </ol>

  <p class="cap fl__note">{f.note}</p>
</div>

<style>
  /* ============ Base: escenas quietas y completas, una debajo de otra ============ */

  .fl {
    --voz: #c59711;
    --voz-borde: #815d00;
    --voz-tinte: #f8eed8;
    --id: #21763c;
    --id-borde: #045725;
    --id-tinte: #e3f4e5;
    --mo: #bf71a6;
    --mo-borde: #793d67;
    --mo-tinte: #fbe8f4;
    --img: #105483;
    --img-borde: #003860;
    --img-tinte: #e3f0fd;
    position: relative;
  }

  .fl__rail {
    display: none;
  }

  .fl__body {
    display: grid;
    gap: 56px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl__scene {
    display: grid;
    gap: 20px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .fl__scene {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 48px;
    }
  }

  .fl__copy {
    display: grid;
    gap: 12px;
    align-content: start;
    max-width: 30em;
  }

  .fl__step {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-weight: 700;
  }

  .fl__n {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--terracota);
    color: #fff;
    font-family: var(--display);
    font-weight: 700;
  }

  .fl__title {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem);
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .fl__text {
    margin: 0;
  }

  .fl__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .fl__note {
    margin-top: 32px;
  }

  /* El escenario: hoja de papel con borde; todo adentro se mide contra él (container queries). */
  .fl__box {
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border: 1px solid var(--linea);
    border-radius: 16px;
    background: var(--papel);
  }

  @media (max-width: 899px) {
    .fl__box {
      aspect-ratio: 4 / 5;
    }
  }

  .sc {
    position: absolute;
    inset: 0;
    container-type: size;
    display: grid;
    padding: 5cqmin;
    color: var(--tinta);
    font-size: clamp(11px, 2.4cqmin, 16px);
    line-height: 1.35;
  }

  .sc :global(.icon) {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.45em 0.85em;
    border: 1px solid var(--linea-2);
    border-radius: 999px;
    background: var(--papel);
    font-weight: 700;
    white-space: nowrap;
  }

  code {
    font-size: 0.92em;
  }

  /* ---------- 2. Analiza ---------- */

  /* Los tres carriles comparten columnas: entrada, modelo y salida alineados. */
  .s2 {
    grid-template-columns: auto 2.5cqi auto 2.5cqi minmax(0, 1fr);
    align-content: center;
    align-items: center;
    column-gap: 1cqi;
    row-gap: 5cqmin;
  }

  .s2__lane {
    display: contents;
  }

  .s2__in {
    display: grid;
    place-items: center;
    width: 2.4em;
    height: 2.4em;
    border: 1.5px solid var(--linea-2);
    border-radius: 50%;
    background: var(--papel);
  }

  .s2__arrow {
    height: 2px;
    background: var(--linea-2);
    transform-origin: left;
  }

  .s2__model {
    padding: 0.45em 0.8em;
    border-radius: 10px;
    background: var(--noche);
    color: #fff;
    font-weight: 700;
    white-space: nowrap;
  }

  .s2__quote {
    display: flex;
    gap: 0.6em;
    margin: 0;
  }

  .s2__spk {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.8em;
    height: 1.8em;
    border-radius: 50%;
    background: var(--voz-tinte);
    border: 1.5px solid var(--voz-borde);
    font-weight: 700;
  }

  .s2__quote mark {
    padding: 0 0.15em;
    border-radius: 3px;
    background: var(--ocre-suave);
    color: var(--tinta);
    font-weight: 700;
  }

  .s2__photo {
    position: relative;
    aspect-ratio: 1000 / 506;
  }

  .s2__photo img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 10px;
    object-fit: cover;
  }

  .s2__box {
    position: absolute;
    border: 2px solid #fff;
    border-radius: 4px;
    box-shadow:
      0 0 0 2px var(--img),
      inset 0 0 0 1px var(--img);
  }

  .s2__boxlabel {
    position: absolute;
    right: -2px;
    bottom: calc(100% + 4px);
    padding: 0.15em 0.5em;
    border-radius: 6px;
    background: var(--img);
    color: #fff;
    font-size: 0.82em;
    font-weight: 700;
    white-space: nowrap;
  }

  .s2__box--below .s2__boxlabel {
    top: calc(100% + 4px);
    right: auto;
    bottom: auto;
    left: -2px;
  }

  .s2__ficha {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5em;
    margin: 0;
  }

  .s2__field {
    padding: 0.4em 0.6em;
    border-radius: 8px;
    background: var(--fondo-2);
  }

  .s2__field dt {
    font-size: 0.85em;
    color: var(--tinta-2);
  }

  .s2__field dd {
    margin: 0;
    font-weight: 700;
  }

  /* ---------- 4. Compara ---------- */

  .s4 {
    grid-template-rows: 1fr auto;
    gap: 4cqmin;
  }

  .s4__grid {
    position: relative;
    display: grid;
    grid-template-columns: 4.6em minmax(0, 1fr) minmax(0, 1.05fr) minmax(0, 1fr);
    grid-template-rows: auto repeat(4, 1fr);
    align-items: center;
    column-gap: 1.2cqi;
    row-gap: 1.6cqmin;
  }

  .s4__case {
    display: grid;
    gap: 0.1em;
    margin: 0;
    line-height: 1.2;
  }

  .s4__case span {
    font-size: 0.8em;
    color: var(--tinta-2);
  }

  .s4__case--a {
    grid-column: 2;
    grid-row: 1;
  }

  .s4__case--b {
    grid-column: 4;
    grid-row: 1;
    text-align: end;
  }

  .s4__k {
    grid-column: 1;
    font-weight: 700;
    color: var(--tinta-2);
  }

  .s4__k--voz,
  .s4__v--voz,
  .s4__link--voz {
    grid-row: 2;
  }

  .s4__k--tel,
  .s4__v--tel,
  .s4__link--tel {
    grid-row: 3;
  }

  .s4__k--mo,
  .s4__v--mo,
  .s4__link--mo {
    grid-row: 4;
  }

  .s4__k--img,
  .s4__v--img,
  .s4__v--none,
  .s4__link--img {
    grid-row: 5;
  }

  .s4__v {
    justify-self: start;
    max-width: 100%;
    overflow: hidden;
    padding: 0.35em 0.7em;
    border: 1.5px solid var(--linea-2);
    border-radius: 999px;
    background: var(--papel);
    font-weight: 700;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .s4__a {
    grid-column: 2;
  }

  .s4__b {
    grid-column: 4;
    justify-self: end;
  }

  .s4__v--voz {
    border-color: var(--voz-borde);
    background: var(--voz-tinte);
  }

  .s4__v--tel {
    border-color: var(--id-borde);
    background: var(--id-tinte);
  }

  .s4__v--mo {
    border-color: var(--mo-borde);
    border-radius: 10px;
    background: var(--mo-tinte);
    font-size: 0.88em;
    line-height: 1.2;
    white-space: normal;
  }

  .s4__v--img {
    border-color: var(--img-borde);
    background: var(--img-tinte);
  }

  .s4__v--none {
    border-style: dashed;
    color: var(--tinta-2);
  }

  .s4__link {
    position: relative;
    grid-column: 3;
    display: grid;
    place-items: center;
    height: 100%;
  }

  .s4__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 3px;
    border-radius: 2px;
    transform: translateY(-50%);
  }

  .s4__link--voz .s4__line {
    background: var(--voz);
  }

  .s4__link--mo .s4__line {
    background: var(--mo);
  }

  .s4__why {
    position: relative;
    padding: 0.2em 0.6em;
    border-radius: 6px;
    background: var(--papel);
    font-size: 0.86em;
    font-weight: 700;
    text-align: center;
    box-shadow: 0 0 0 1px var(--linea);
  }

  .s4__why--no {
    color: var(--tinta-2);
    font-weight: 400;
  }

  /* El índice de FAISS: aparece sobre el medio, encuentra V-3 y deja paso a las líneas. */
  /* Mientras busca, el índice ocupa el lugar del caso A (que todavía no aparece). */
  .s4__index {
    grid-column: 2 / span 2;
    grid-row: 2 / span 4;
    align-self: stretch;
    display: grid;
    align-content: center;
    gap: 0.6em;
    padding: 0.8em;
    border: 1px dashed var(--linea-2);
    border-radius: 12px;
    background: var(--papel);
    opacity: 0;
  }

  .s4__index p {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    margin: 0;
    font-weight: 700;
  }

  .s4__index p .s4__px {
    width: 2.6em;
  }

  /* Las huellas en el orden de la de B (V-7): la que se le parece repite su degradado. */
  .s4__px {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border-radius: 3px;
    image-rendering: pixelated;
  }

  .s4__index ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .s4__index li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25em 0.3em;
    padding: 0.3em;
    border-radius: 6px;
    background: var(--fondo-2);
    font-size: 0.8em;
    font-weight: 700;
  }

  .s4__index li .s4__px {
    grid-column: 1 / -1;
  }

  .s4__vid,
  .s4__cos {
    white-space: nowrap;
  }

  .s4__cos {
    color: var(--ink-2);
    font-weight: 400;
    text-align: end;
  }

  .s4__index li.is-hit .s4__cos {
    color: var(--voz-borde);
    font-weight: 700;
  }

  .s4__index li.is-hit {
    background: var(--voz-tinte);
    box-shadow: 0 0 0 1.5px var(--voz-borde);
  }

  .s4__meter {
    display: grid;
    gap: 1.2em;
    padding-top: 1.6em;
  }

  .s4__track {
    position: relative;
    height: 12px;
    border-radius: 6px;
    background: var(--fondo-2);
  }

  .s4__fill {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    background: var(--terracota);
    transform-origin: left;
    transform: scaleX(0.91);
  }

  .s4__tick {
    position: absolute;
    top: -6px;
    bottom: -6px;
    left: calc(var(--x) * 100%);
    border-left: 2px dashed var(--tinta);
  }

  .s4__tick span {
    position: absolute;
    bottom: calc(100% + 2px);
    left: 0;
    transform: translateX(-50%);
    font-size: 0.82em;
    color: var(--tinta-2);
    white-space: nowrap;
  }

  .s4__tick--hi span {
    transform: translateX(-80%);
    color: var(--tinta);
    font-weight: 700;
  }

  .s4__formula {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em 0.7em;
    margin: 0;
  }

  .s4__score {
    font-family: var(--display);
    font-size: 1.6em;
    color: var(--terracota-2);
  }

  .s4__status {
    padding: 0.2em 0.7em;
    border-radius: 999px;
    background: var(--terracota);
    color: #fff;
    font-weight: 700;
  }

  /* ---------- 5. Revisa ---------- */

  .s5 {
    align-content: center;
    justify-items: center;
    gap: 5cqmin;
  }

  .s5__card {
    position: relative;
    display: grid;
    gap: 0.8em;
    width: min(100%, 34em);
    padding: 1.2em 1.3em;
    border: 1px solid var(--linea);
    border-radius: 14px;
    background: var(--papel);
    box-shadow: var(--lift);
  }

  .s5__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5em;
    margin: 0;
  }

  .s5__status {
    padding: 0.15em 0.7em;
    border: 1.5px solid var(--terracota);
    border-radius: 999px;
    color: var(--terracota-2);
    font-weight: 700;
  }

  .s5__explain {
    margin: 0;
  }

  .s5__cites {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .s5__cites li {
    padding: 0.1em 0.55em;
    border: 1px solid var(--linea-2);
    border-radius: 6px;
    font-size: 0.86em;
    font-weight: 700;
  }

  .s5__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
  }

  .s5__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.55em 1em;
    border: 1.5px solid var(--linea-2);
    border-radius: 10px;
    font-weight: 700;
  }

  .s5__btn--ok {
    border-color: var(--terracota);
    background: var(--terracota);
    color: #fff;
  }

  /* El estado final: confirmado. Al animar, primero se ven los botones y la revisora elige. */
  .s5__done {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0 1em;
    border-radius: 10px;
    background: var(--verde);
    color: #fff;
    font-weight: 700;
  }

  .s5__cursor {
    position: absolute;
    left: 24%;
    bottom: 1.1em;
    width: 1.6em;
    height: 1.6em;
    fill: var(--noche);
    stroke: #fff;
    stroke-width: 1.5;
    opacity: 0;
  }

  .s5__audit {
    display: grid;
    gap: 0.5em;
    justify-items: center;
  }

  .s5__audit p {
    margin: 0;
    font-weight: 700;
    color: var(--tinta-2);
  }

  .s5__audit ol {
    display: flex;
    gap: 1.6em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .s5__audit li {
    position: relative;
    padding: 0.35em 0.6em;
    border: 1px solid var(--linea-2);
    border-radius: 8px;
    background: var(--fondo);
  }

  .s5__audit li + li::before {
    content: "";
    position: absolute;
    right: 100%;
    top: 50%;
    width: 1.6em;
    height: 2px;
    background: var(--linea-2);
  }

  /* ---------- 6. Muestra ---------- */

  .s6 {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: 4cqmin;
  }

  .s6__graph {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .s6__ring {
    fill: none;
    stroke: var(--tinta-2);
    stroke-width: 1.5;
    stroke-dasharray: 0.01 0.012;
  }

  .s6__ringlabel {
    fill: var(--tinta);
    font-size: 13px;
    font-weight: 700;
  }

  .s6__edge {
    stroke-width: 4;
    stroke-linecap: round;
  }

  .s6__edge--voz {
    stroke: var(--voz);
  }

  .s6__edge--id {
    stroke: var(--id);
  }

  .s6__elabel {
    fill: var(--tinta);
    font-size: 11px;
    font-weight: 700;
  }

  .s6__node rect {
    fill: var(--noche);
  }

  .s6__nk {
    fill: #fff;
    font-size: 15px;
    font-weight: 700;
  }

  .s6__ns {
    fill: #fff;
    font-size: 10px;
  }

  .s6__map {
    position: relative;
    display: grid;
    gap: 0.8em;
  }

  .s6__alert {
    display: grid;
    gap: 0.3em;
    padding: 0.8em 0.9em;
    border: 1px solid var(--linea);
    border-radius: 12px;
    background: var(--papel);
    box-shadow: var(--lift);
  }

  .s6__alert p {
    margin: 0;
  }

  .s6__alerttitle {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-weight: 700;
    color: var(--verde);
  }

  /* ============ En vivo: la sección se fija y el scroll arma cada escena ============ */

  .fl.is-live {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 20px;
    height: calc(100svh - var(--fl-top, 0px) - 32px);
    min-height: 520px;
  }

  .fl.is-live .fl__rail {
    display: block;
  }

  .fl.is-live .fl__note {
    display: none;
  }

  .fl__rail ol {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fl__railbtn {
    display: grid;
    gap: 6px;
    width: 100%;
    min-height: 44px;
    padding: 4px 0;
    border: 0;
    background: none;
    color: var(--tinta-2);
    font: inherit;
    font-size: var(--step-small);
    font-weight: 700;
    text-align: start;
    cursor: pointer;
  }

  .fl__railbtn[aria-current="step"] {
    color: var(--tinta);
  }

  .fl__railbtn:focus-visible {
    outline: 3px solid var(--terracota);
    outline-offset: 2px;
    border-radius: 6px;
  }

  .fl__railbar {
    position: relative;
    height: 4px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--linea);
  }

  .fl__railfill {
    position: absolute;
    inset: 0;
    background: var(--terracota);
    transform: scaleX(0);
    transform-origin: left;
  }

  .fl__raillabel {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .fl.is-live .fl__body {
    position: relative;
    display: block;
  }

  .fl.is-live .fl__scene {
    display: block;
  }

  .fl.is-live .fl__copy {
    position: absolute;
    left: 0;
    top: 0;
    width: 38%;
  }

  .fl.is-live .fl__box {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 58%;
    aspect-ratio: auto;
  }

  @media (max-width: 899px) {
    .fl.is-live .fl__copy {
      width: 100%;
      gap: 6px;
    }

    .fl.is-live .fl__text {
      font-size: var(--step-small);
    }

    .fl.is-live .fl__tags {
      display: none;
    }

    .fl.is-live .fl__box {
      top: auto;
      left: 0;
      width: 100%;
      height: 64%;
    }

    .fl.is-live .fl__raillabel {
      font-size: 0.75rem;
    }
  }

  /* Escenarios angostos: la salida de cada carril baja a su propio renglón y la tabla se aprieta. */
  @container (max-width: 520px) {
    .s2 {
      grid-template-columns: 2.4em 3cqi max-content minmax(0, 1fr);
      row-gap: 1.6cqmin;
    }

    /* La segunda flecha (entre el modelo y la salida): la salida baja a su renglón. */
    .s2__lane > .s2__arrow:nth-child(4) {
      display: none;
    }

    .s2__out {
      grid-column: 1 / -1;
      margin-bottom: 2.4cqmin;
    }

    .s2__photo {
      width: 82%;
    }

    .s4__grid {
      grid-template-columns: 0 minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 1cqi;
    }

    .s4__k {
      visibility: hidden;
    }
  }
</style>

<script>
  import type { gsap as GsapType } from "gsap";
  import type { ScrollTrigger as ScrollTriggerType } from "gsap/ScrollTrigger";

  type Gsap = typeof GsapType;
  type ST = typeof ScrollTriggerType;

  /** Lo que tapa arriba al fijar la sección: la franja de ayuda y, en escritorio, la cabecera. */
  function topOffset(): number {
    let h = 0;
    for (const el of document.querySelectorAll<HTMLElement>(".help, .top")) {
      const pos = getComputedStyle(el).position;
      if (pos === "sticky" || pos === "fixed") h += el.offsetHeight;
    }
    return h;
  }

  function setup(root: HTMLElement, gsap: Gsap, ScrollTrigger: ST) {
    const mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      root.classList.add("is-live");
      root.style.setProperty("--fl-top", `${topOffset()}px`);
      const q = (sel: string, scope: ParentNode = root) => Array.from(scope.querySelectorAll<HTMLElement>(sel));
      const copies = q(".fl__copy");
      const boxes = q(".fl__box");
      const fills = q(".fl__railfill");
      const btns = q(".fl__railbtn");
      const n = copies.length;

      gsap.set(copies.slice(1), { autoAlpha: 0, y: 24 });
      gsap.set(boxes.slice(1), { autoAlpha: 0, scale: 0.97 });

      const tl = gsap.timeline({ defaults: { ease: "power3.out", duration: 1 } });
      const starts: number[] = [];
      const done: number[] = [];
      const change = (from: number) => {
        tl.to(copies[from]!, { autoAlpha: 0, y: -24, duration: 0.6, ease: "power2.in" }, ">+0.4")
          .to(boxes[from]!, { autoAlpha: 0, scale: 0.97, duration: 0.6, ease: "power2.in" }, "<")
          .to(copies[from + 1]!, { autoAlpha: 1, y: 0, duration: 0.8 }, ">-0.1")
          .to(boxes[from + 1]!, { autoAlpha: 1, scale: 1, duration: 0.8 }, "<");
      };

      // 1. Analiza: cada carril se enciende y su salida aparece.
      starts.push(0);
      gsap.set(q(".s2__arrow"), { scaleX: 0 });
      gsap.set(q(".s2__model"), { autoAlpha: 0, scale: 0.92 });
      gsap.set(q(".s2__out"), { autoAlpha: 0, y: 10 });
      gsap.set(q(".s2__box"), { autoAlpha: 0, scale: 1.25 });
      q(".s2__lane").forEach((lane, k) => {
        const s = (sel: string) => q(sel, lane);
        const at = k === 0 ? ">" : "<+0.55";
        tl.to(s(".s2__arrow")[0]!, { scaleX: 1, duration: 0.4 }, at)
          .to(s(".s2__model"), { autoAlpha: 1, scale: 1, duration: 0.5 }, ">-0.1")
          .to(s(".s2__arrow")[1]!, { scaleX: 1, duration: 0.4 }, ">-0.1")
          .to(s(".s2__out"), { autoAlpha: 1, y: 0, duration: 0.6 }, ">-0.1");
        if (k === 1) tl.to(s(".s2__box"), { autoAlpha: 1, scale: 1, duration: 0.5, stagger: 0.25 }, ">-0.2");
        if (k === 2) tl.from(s(".s2__field"), { autoAlpha: 0, y: 8, duration: 0.4, stagger: 0.15 }, "<");
      });
      tl.addLabel("s0");
      done.push(tl.duration());
      change(0);

      // 2. Compara: FAISS encuentra la voz, las líneas unen lo que coincide y el puntaje se combina.
      starts.push(tl.duration());
      const score = q(".s4__score")[0]!;
      const sc = { v: 0 };
      const paint = () => {
        score.textContent = sc.v.toFixed(2);
      };
      gsap.set(q(".s4__index"), { autoAlpha: 0 });
      gsap.set(q(".s4__a, .s4__case--a"), { autoAlpha: 0, x: -14 });
      gsap.set(q(".s4__line"), { scaleX: 0 });
      gsap.set(q(".s4__why"), { autoAlpha: 0, y: 6 });
      gsap.set(q(".s4__fill"), { scaleX: 0 });
      gsap.set(q(".s4__formula code, .s4__status, .s4__score"), { autoAlpha: 0 });
      paint();
      tl.to(q(".s4__probe"), { scale: 1.12, duration: 0.3, yoyo: true, repeat: 1, ease: "power1.inOut" }, ">")
        .to(q(".s4__index"), { autoAlpha: 1, duration: 0.5 }, "<")
        .from(q(".s4__index li"), { autoAlpha: 0, y: 6, duration: 0.3, stagger: 0.06 }, "<")
        .to(q(".s4__index li.is-hit"), { scale: 1.15, duration: 0.35, yoyo: true, repeat: 1 }, ">+0.1")
        .to(q(".s4__index"), { autoAlpha: 0, duration: 0.5 }, ">+0.3")
        .to(q(".s4__a, .s4__case--a"), { autoAlpha: 1, x: 0, duration: 0.5, stagger: 0.08 }, "<")
        .to(q(".s4__link--voz .s4__line"), { scaleX: 1, duration: 0.6 }, ">")
        .to(q(".s4__link--voz .s4__why"), { autoAlpha: 1, y: 0, duration: 0.4 }, ">-0.2")
        .to(score, { autoAlpha: 1, duration: 0.3 }, "<")
        .to(q(".s4__fill"), { scaleX: 0.85, duration: 0.8 }, "<")
        .to(sc, { v: 0.85, duration: 0.8, onUpdate: paint }, "<")
        .to(q(".s4__link--tel .s4__why"), { autoAlpha: 1, y: 0, duration: 0.4 }, ">")
        .to(q(".s4__link--mo .s4__line"), { scaleX: 1, duration: 0.6 }, ">")
        .to(q(".s4__link--mo .s4__why"), { autoAlpha: 1, y: 0, duration: 0.4 }, ">-0.2")
        .to(q(".s4__link--img .s4__why"), { autoAlpha: 1, y: 0, duration: 0.4 }, "<")
        .to(q(".s4__formula code"), { autoAlpha: 1, duration: 0.4 }, ">")
        .to(q(".s4__fill"), { scaleX: 0.91, duration: 0.7 }, "<")
        .to(sc, { v: 0.91, duration: 0.7, onUpdate: paint }, "<")
        .to(q(".s4__status"), { autoAlpha: 1, duration: 0.4 }, ">");
      tl.addLabel("s1");
      done.push(tl.duration());
      change(1);

      // 3. Revisa: la revisora confirma y la auditoría se encadena.
      starts.push(tl.duration());
      gsap.set(q(".s5__done"), { autoAlpha: 0, scale: 0.96 });
      gsap.set(q(".s5__cursor"), { autoAlpha: 0, x: 160, y: 60 });
      gsap.set(q(".s5__audit li"), { autoAlpha: 0, x: -10 });
      gsap.set(q(".s5__audit p"), { autoAlpha: 0 });
      tl.to(q(".s5__cursor"), { autoAlpha: 1, duration: 0.3 }, ">")
        .to(q(".s5__cursor"), { x: 0, y: 0, duration: 0.9, ease: "power2.inOut" }, ">")
        .to(q(".s5__btn--ok"), { scale: 0.95, duration: 0.15, yoyo: true, repeat: 1, ease: "power1.inOut" }, ">")
        .to(q(".s5__done"), { autoAlpha: 1, scale: 1, duration: 0.5 }, ">")
        .to(q(".s5__cursor"), { autoAlpha: 0, duration: 0.3 }, "<")
        .to(q(".s5__audit p"), { autoAlpha: 1, duration: 0.4 }, ">")
        .to(q(".s5__audit li"), { autoAlpha: 1, x: 0, duration: 0.4, stagger: 0.25 }, "<");
      tl.addLabel("s2");
      done.push(tl.duration());
      change(2);

      // 4. Muestra: la red se dibuja y la alerta sale aprobada.
      starts.push(tl.duration());
      gsap.set(q(".s6__node"), { autoAlpha: 0, scale: 0.8, transformOrigin: "50% 50%" });
      gsap.set(q(".s6__edge"), { strokeDasharray: 1, strokeDashoffset: 1 });
      gsap.set(q(".s6__ring"), { autoAlpha: 0 });
      gsap.set(q(".s6__ringlabel, .s6__elabel"), { autoAlpha: 0 });
      gsap.set(q(".s6__alert"), { autoAlpha: 0, y: 12 });
      tl.to(q(".s6__node"), { autoAlpha: 1, scale: 1, duration: 0.4, stagger: 0.15 }, ">")
        .to(q(".s6__edge--voz"), { strokeDashoffset: 0, duration: 0.6 }, ">")
        .to(q(".s6__elabel")[0]!, { autoAlpha: 1, duration: 0.3 }, ">-0.2")
        .to(q(".s6__edge--id"), { strokeDashoffset: 0, duration: 0.6 }, ">")
        .to(q(".s6__elabel")[1]!, { autoAlpha: 1, duration: 0.3 }, ">-0.2")
        .to(q(".s6__ring, .s6__ringlabel"), { autoAlpha: 1, duration: 0.5 }, ">")
        .to(q(".s6__alert"), { autoAlpha: 1, y: 0, duration: 0.6 }, ">");
      tl.to({}, { duration: 0.6 });
      tl.addLabel("s3");
      done.push(tl.duration());

      const total = tl.duration();
      const sceneAt = (t: number) => {
        let i = 0;
        for (let k = 0; k < n; k++) if (t >= starts[k]! - 0.01) i = k;
        return i;
      };
      let current = 0;
      const st = ScrollTrigger.create({
        trigger: root,
        pin: true,
        start: () => `top top+=${topOffset() + 16}`,
        end: () => `+=${Math.round(window.innerHeight * (n - 0.5))}`,
        animation: tl,
        scrub: 0.6,
        snap: { snapTo: "labels", duration: { min: 0.2, max: 0.7 }, delay: 0.12, ease: "power1.inOut" },
        invalidateOnRefresh: true,
        onRefresh: () => root.style.setProperty("--fl-top", `${topOffset()}px`),
        onUpdate: (self) => {
          const t = self.progress * total;
          fills.forEach((el, k) => {
            const a = k === 0 ? 0 : done[k - 1]!;
            const b = done[k]!;
            gsap.set(el, { scaleX: gsap.utils.clamp(0, 1, (t - a) / (b - a)) });
          });
          const i = sceneAt(t);
          if (i !== current) {
            btns[current]?.removeAttribute("aria-current");
            btns[i]?.setAttribute("aria-current", "step");
            current = i;
          }
        },
      });

      // La barra de pasos lleva a cada escena ya armada.
      const go = (e: Event) => {
        const i = Number((e.currentTarget as HTMLElement).dataset.goto);
        const top = st.labelToScroll(`s${i}`);
        window.scrollTo({ top, behavior: "smooth" });
      };
      btns.forEach((b) => b.addEventListener("click", go));
      // Las imágenes cambian el alto de la página: recalcular cuando cargan.
      if (document.readyState === "complete") ScrollTrigger.refresh();
      else window.addEventListener("load", () => ScrollTrigger.refresh(), { once: true });

      return () => {
        btns.forEach((b) => b.removeEventListener("click", go));
        root.classList.remove("is-live");
      };
    });
  }

  /**
   * GSAP (unos 120 KB) baja recién cuando la sección está a un par de pantallas, y nunca con
   * movimiento reducido: la página carga liviana y, mientras tanto, se ven las escenas quietas.
   */
  const roots = Array.from(document.querySelectorAll<HTMLElement>("[data-flow]"));
  if (
    roots.length &&
    "IntersectionObserver" in window &&
    matchMedia("(prefers-reduced-motion: no-preference)").matches
  ) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        void Promise.all([import("gsap"), import("gsap/ScrollTrigger")]).then(([{ gsap }, { ScrollTrigger }]) => {
          gsap.registerPlugin(ScrollTrigger);
          roots.forEach((root) => setup(root, gsap, ScrollTrigger));
        });
      },
      { rootMargin: "200% 0px" },
    );
    roots.forEach((root) => io.observe(root));
  }
</script>
