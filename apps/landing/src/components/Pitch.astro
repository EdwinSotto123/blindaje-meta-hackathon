---
/**
 * El pitch: quince escenas a pantalla entera que avanzan con el scroll, con datos reales del proyecto.
 *
 *  0. Blindaje        el logo se arma con píxeles (solo, al cargar)
 *  1. El problema     de América Latina al Perú: 13,892 denuncias en siete meses (Ministerio Público,
 *                     ene-jul 2026) y los distritos fiscales con más casos: Lima Este 1,806, La Libertad
 *                     1,625, Lima Sur 1,346, Lima Norte 1,305 y Lima Centro 1,178 (mapas.json)
 *  2. Las víctimas    tres números distintos mandan audios, la foto de la bala y mensajes a tres víctimas
 *                     (casos ficticios A, B y C del demo: src/data/casos-demo.json)
 *  3. Escucha         la onda del audio, su espectrograma y su huella ECAPA de 192 números (voz-huella.json)
 *  4. Desdistorsiona  la voz disfrazada +4 y el barrido de tono hasta −5 (cosenos reales: 0.18 a 0.49)
 *  5. Compara voces   el radar: distancia al centro = 1 − coseno con la voz de B (pitch.json, radar)
 *  6. Mira            las cajas de SAM 3.1 sobre la foto del caso A y los parches de DINOv2 (fotos-demo.json)
 *  7. Lee             Muse Spark lee la evidencia del caso A y llena la ficha; de dónde sale cada dato
 *                     (pitch.json, lee y casos: la ficha real de la evaluación)
 *  8. Números         cada teléfono y cuenta, normalizado y cifrado con HMAC como el pipeline (con una
 *                     clave de demostración); 7 contactos distintos, 5 casos con la misma cuenta
 *  9. Patrones        las frases firma que se repiten, el vector e5 del resumen y la x del MO de 496
 *                     pares de guiones ficticios (pitch.json, patrones)
 * 10. Combina         voz 0.85 y guion 0.40 dan 0.91; la misma cuenta, 0.95 (pitch.json, combina)
 * 11. Une             la red: casos e identificadores compartidos, y una persona que confirma
 * 12. Vigila          14 días en San Juan de Lurigancho: 5 casos de «Los X» encienden la alerta
 * 13. Protege         el distrito en el mapa y la alerta aprobada
 * 14. Escala          de Lima a la región: qué cambia por país y el expediente para cualquier policía
 *
 * Los datos de texto los arma eval/src/pitch-texto.ts; el radar, eval/py/blindaje_eval/pitch_datos.py; los
 * mapas de puntos, eval/py/blindaje_eval/mapas_landing.py (Natural Earth, dominio público).
 * Con JavaScript y movimiento, la sección se fija y el scroll avanza las escenas (un lienzo dibuja todo;
 * el texto de cada escena es HTML). Sin movimiento, cada escena se ve quieta con su dibujo final. Sin
 * JavaScript, el texto de las escenas, una debajo de otra.
 */
import { getImage } from "astro:assets";
import type { Dict } from "../i18n";
import { PORTAL_URL } from "../i18n/sources";
import { DISTRICT_GRID, DISTRICTS } from "../../../../packages/shared/src/zones";
import mostrador from "../assets/flujo/mostrador.jpg";
import casosDemo from "../data/casos-demo.json";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const p = d.lp.pitch;
const ui = p.ui;
const n = p.scenes.length;
const fill = (s: string, t: Record<string, string | number>) =>
  s.replace(/\{(\w+)\}/g, (m, k: string) => (k in t ? String(t[k]) : m));
/** Los audios que se pueden escuchar en cada escena (los 7 s de public/voz, voz ficticia de MMS-TTS). */
const audios: Record<number, { src: string; label: string; name: string; undo?: number }[]> = {
  3: [{ src: "/voz/b1-limpia.m4a", label: p.audio.clean, name: p.audio.cleanName }],
  4: [
    { src: "/voz/b1-disfrazada.m4a", label: p.audio.disguised, name: p.audio.disguisedName, undo: 0 },
    { src: "/voz/b1-revertida.m4a", label: p.audio.reverted, name: p.audio.revertedName, undo: -4 },
  ],
};
/** El audio que recibe cada víctima (las notas de voz ficticias del demo, eval/demo/audio, en m4a). */
const victimAudio = casosDemo.casos.map((cs, k) => {
  const pz = cs.piezas.find((x) => x.tipo === "audio") as { segundos?: number } | undefined;
  return {
    src: `/casos/${cs.caso.toLowerCase()}1.m4a`,
    who: ui.victims.who[k] ?? cs.caso,
    name: fill(ui.victims.name, { k: cs.caso, s: Math.round(pz?.segundos ?? 0) }),
  };
});
/** Las señales de "Combina" y los datos de "Lee", con el color que tienen en el lienzo. */
const SIGNALS = [
  ["voz", p.canvas.signals.voice, "231 173 69"],
  ["guion", p.canvas.signals.script, "190 165 255"],
  ["cuenta", p.canvas.signals.account, "111 207 142"],
] as const;
const KINDS = [
  ["monto", "231 173 69"],
  ["plazo", "141 187 230"],
  ["cuenta", "111 207 142"],
  ["grupo", "236 159 208"],
  ["frase", "190 165 255"],
] as const;
const img = await getImage({ src: mostrador, widths: [720], format: "webp", quality: 80 });

const config = JSON.stringify({
  grid: {
    cols: DISTRICT_GRID.cols,
    rows: DISTRICT_GRID.rows,
    tiles: DISTRICTS.map((x) => [x.id, x.col, x.row, x.area]),
  },
  photo: img.src,
  labels: p.canvas,
  ui,
  nav: p.nav,
});
---

<section class="pt" id="pitch" aria-labelledby="pitch-title" data-pitch data-config={config} style={`--n:${n}`}>
  <div class="pt__track" data-track>
    <div class="pt__stage" data-stage>
      <canvas class="pt__canvas" aria-hidden="true" data-canvas></canvas>
      <div class="pt__copy">
        <ol class="pt__scenes" role="list">
          {p.scenes.map((s, i) => (
            <li class:list={["pt__scene", i === 0 && "is-on"]} data-scene={i}>
              {i === 0 ? (
                <h1 id="pitch-title" class="pt__title pt__title--first">
                  {s.title}
                </h1>
              ) : (
                <h2 class="pt__title">{s.title}</h2>
              )}
              <p class="pt__text">{s.text}</p>
              {s.tags && (
                <ul class="pt__tags" role="list">
                  {s.tags.map((t) => (
                    <li translate="no">{t}</li>
                  ))}
                </ul>
              )}
              {i === 1 && <p class="pt__source">{p.source}</p>}
              {i === 2 && (
                <div class="pt__ctl" role="group" aria-labelledby="pt-ctl-2">
                  <p class="pt__ctl-label" id="pt-ctl-2">
                    {ui.victims.label}
                  </p>
                  <div class="pt__opts">
                    {victimAudio.map((a, k) => (
                      <button type="button" class="pt__play" data-src={a.src} data-victim={k} aria-pressed="false">
                        <Icon name="play" class="icon pt__icon pt__icon--play" />
                        <Icon name="pause" class="icon pt__icon pt__icon--pause" />
                        {a.who}
                        <span class="sr-only">, {a.name}</span>
                      </button>
                    ))}
                  </div>
                </div>
              )}
              {i === 4 && (
                <div class="pt__ctl">
                  <label class="pt__ctl-label" for="pt-undo">
                    {ui.undo.label}
                  </label>
                  <input
                    class="pt__range"
                    id="pt-undo"
                    type="range"
                    min="-8"
                    max="8"
                    step="1"
                    value="0"
                    data-ctl="undo"
                  />
                  <div class="pt__ends" aria-hidden="true">
                    <span>−8</span>
                    <span>0</span>
                    <span>+8</span>
                  </div>
                  <p class="pt__out" data-out="undo" />
                </div>
              )}
              {i === 5 && (
                <div class="pt__ctl">
                  <label class="pt__ctl-label" for="pt-thr">
                    {ui.radar.label}
                  </label>
                  <input
                    class="pt__range"
                    id="pt-thr"
                    type="range"
                    min="10"
                    max="90"
                    step="1"
                    value="60"
                    data-ctl="thr"
                  />
                  <div class="pt__ends" aria-hidden="true">
                    <span>0.10</span>
                    <span>0.90</span>
                  </div>
                  <p class="pt__out" data-out="thr" />
                </div>
              )}
              {i === 6 && (
                <div class="pt__ctl" role="group" aria-labelledby="pt-ctl-6">
                  <p class="pt__ctl-label" id="pt-ctl-6">
                    {ui.look.label}
                  </p>
                  <div class="pt__opts">
                    {ui.look.pairs.map((name, k) => (
                      <button type="button" class="pt__opt" data-look={k} aria-pressed={k === 0 ? "true" : "false"}>
                        {name}
                      </button>
                    ))}
                  </div>
                  <p class="pt__out" data-out="look" />
                </div>
              )}
              {i === 7 && (
                <div class="pt__ctl" role="group" aria-labelledby="pt-ctl-7">
                  <p class="pt__ctl-label" id="pt-ctl-7">
                    {ui.read.label}
                  </p>
                  <div class="pt__opts">
                    {KINDS.map(([kind, col]) => (
                      <button
                        type="button"
                        class="pt__opt pt__opt--color"
                        data-field={kind}
                        aria-pressed="false"
                        style={`--c:${col}`}
                      >
                        <span class="pt__swatch" aria-hidden="true" />
                        {ui.read.fields[kind]}
                      </button>
                    ))}
                  </div>
                  <p class="pt__out" data-out="read" />
                </div>
              )}
              {i === 10 && (
                <div class="pt__ctl" role="group" aria-labelledby="pt-ctl-10">
                  <p class="pt__ctl-label" id="pt-ctl-10">
                    {ui.combine.label}
                  </p>
                  <div class="pt__opts">
                    {SIGNALS.map(([key, label, col]) => (
                      <button
                        type="button"
                        class="pt__opt pt__opt--color"
                        data-sig={key}
                        aria-pressed="true"
                        style={`--c:${col}`}
                      >
                        <span class="pt__swatch" aria-hidden="true" />
                        {label}
                      </button>
                    ))}
                  </div>
                  <p class="pt__out" data-out="combine" />
                </div>
              )}
              {i === 11 && (
                <div class="pt__ctl" role="group" aria-labelledby="pt-ctl-11">
                  <p class="pt__ctl-label" id="pt-ctl-11">
                    {ui.review.label}
                  </p>
                  <div class="pt__opts">
                    <button type="button" class="pt__opt pt__opt--ok" data-review="ok" aria-pressed="false">
                      <Icon name="check" class="icon" />
                      {ui.review.confirm}
                    </button>
                    <button type="button" class="pt__opt pt__opt--no" data-review="no" aria-pressed="false">
                      <Icon name="x" class="icon" />
                      {ui.review.discard}
                    </button>
                  </div>
                  <p class="pt__out" data-out="review" />
                </div>
              )}
              {i === 12 && (
                <div class="pt__ctl">
                  <label class="pt__ctl-label" for="pt-day">
                    {ui.vigia.label}
                  </label>
                  <input
                    class="pt__range"
                    id="pt-day"
                    type="range"
                    min="0"
                    max="14"
                    step="1"
                    value="14"
                    data-ctl="day"
                  />
                  <div class="pt__ends" aria-hidden="true">
                    <span>{fill(p.canvas.daysAgo, { n: 14 })}</span>
                    <span>{p.canvas.today}</span>
                  </div>
                  <p class="pt__out" data-out="day" />
                </div>
              )}
              {i === 14 && (
                <div class="pt__ctl" role="group" aria-labelledby="pt-ctl-14">
                  <p class="pt__ctl-label" id="pt-ctl-14">
                    {ui.scale.label}
                  </p>
                  <div class="pt__opts">
                    {p.canvas.payments.map(([country], k) => (
                      <button type="button" class="pt__opt" data-country={k} aria-pressed="false">
                        {country}
                      </button>
                    ))}
                  </div>
                  <p class="pt__out" data-out="scale" />
                </div>
              )}
              {audios[i] && (
                <div class="pt__audios" role="group" aria-label={p.audio.group}>
                  {audios[i]!.map((a) => (
                    <button
                      type="button"
                      class="pt__play"
                      data-src={a.src}
                      data-undo={a.undo === undefined ? undefined : String(a.undo)}
                      aria-pressed="false"
                    >
                      <Icon name="play" class="icon pt__icon pt__icon--play" />
                      <Icon name="pause" class="icon pt__icon pt__icon--pause" />
                      {a.label}
                      <span class="sr-only">, {a.name}</span>
                    </button>
                  ))}
                </div>
              )}
              {i === 0 && (
                <button type="button" class="btn pt__ghost pt__start" data-start>
                  {p.start}
                  <Icon name="arrowDown" class="icon" />
                </button>
              )}
              {i === n - 1 && (
                <div class="pt__cta">
                  <a class="btn btn--mark" href={`${PORTAL_URL}/mapa`}>
                    {p.ctaMap}
                  </a>
                  <a class="btn pt__ghost" href="#piloto">
                    {p.ctaPilot}
                  </a>
                </div>
              )}
            </li>
          ))}
        </ol>
      </div>
      <div class="pt__nav" role="group" aria-label={p.nav.label}>
        <button type="button" class="pt__arrow" data-step="-1" aria-label={p.nav.prev} aria-disabled="true">
          <Icon name="chevronUp" class="icon" />
        </button>
        <button type="button" class="pt__arrow" data-step="1" aria-label={p.nav.next}>
          <Icon name="chevronDown" class="icon" />
        </button>
        <p class="pt__count" aria-hidden="true" data-count>
          {fill(p.nav.count, { n: 1, total: n })}
        </p>
        <a class="pt__skip" href="#voz">
          {p.nav.skip}
        </a>
      </div>
      <div class="pt__progress" aria-hidden="true">
        <span data-progress></span>
      </div>
      <p class="sr-only" aria-live="polite" data-live></p>
      <nav class="pt__rail" aria-label={p.railLabel}>
        <ol role="list">
          {p.scenes.map((s, i) => (
            <li>
              <button type="button" class="pt__dot" data-goto={i} aria-current={i === 0 ? "step" : undefined}>
                <span class="sr-only">{s.kicker}</span>
                <span class="pt__dot-label" aria-hidden="true">
                  {s.kicker}
                </span>
              </button>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </div>
</section>

<style>
  .pt {
    --pt-top: 44px;
    position: relative;
    background: var(--noche);
    color: var(--fondo);
  }

  .pt__canvas {
    display: none;
  }

  /* ---------- Sin movimiento o sin JavaScript: las escenas una debajo de otra ---------- */

  .pt__copy {
    max-width: 1232px;
    margin: 0 auto;
    padding: 56px var(--margin);
  }

  .pt__scenes {
    display: grid;
    gap: 56px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pt__scene {
    display: grid;
    gap: 12px;
    align-content: start;
    max-width: 40rem;
  }

  .pt__title {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.75rem, 1.3rem + 1.9vw, 2.875rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.04;
  }

  .pt__title--first {
    font-size: clamp(2.125rem, 1.5rem + 2.8vw, 3.75rem);
  }

  .pt__text {
    max-width: 36rem;
    margin: 0;
    color: var(--claro-tenue);
    font-size: var(--step-lead);
    line-height: 1.5;
  }

  .pt__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .pt__tags li {
    padding: 2px 10px;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 999px;
    color: var(--fondo);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .pt__audios {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .pt__play {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px 0 12px;
    border: 1.5px solid rgb(255 255 255 / 0.4);
    border-radius: 999px;
    background: none;
    color: var(--fondo);
    font: inherit;
    font-size: var(--step-small);
    font-weight: 700;
    cursor: pointer;
  }

  .pt__play:hover {
    border-color: var(--fondo);
  }

  .pt__play:focus-visible {
    outline: 3px solid var(--ocre);
    outline-offset: 2px;
  }

  .pt__play[aria-pressed="true"] {
    border-color: var(--ocre);
    background: var(--ocre);
    color: var(--noche);
  }

  .pt__play :global(.icon) {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pt__play :global(.pt__icon--pause),
  .pt__play[aria-pressed="true"] :global(.pt__icon--play) {
    display: none;
  }

  .pt__play[aria-pressed="true"] :global(.pt__icon--pause) {
    display: block;
  }

  .pt__source {
    margin: 0;
    color: var(--claro-tenue);
    font-size: 0.8125rem;
  }

  /* ---------- Lo que se puede tocar: solo con JavaScript ---------- */
  .pt__ctl,
  .pt__start,
  .pt__nav,
  .pt__progress {
    display: none;
  }

  :global(.js) .pt .pt__ctl {
    display: grid;
    gap: 8px;
    margin-top: 6px;
  }

  :global(.js) .pt .pt__start {
    display: inline-flex;
    justify-self: start;
    gap: 10px;
    margin-top: 10px;
  }

  .pt__start :global(.icon) {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pt__ctl-label {
    margin: 0;
    color: var(--fondo);
    font-size: var(--step-small);
    font-weight: 700;
  }

  .pt__opts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .pt__opt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border: 1.5px solid rgb(255 255 255 / 0.4);
    border-radius: 999px;
    background: none;
    color: var(--fondo);
    font: inherit;
    font-size: var(--step-small);
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }

  .pt__opt:hover {
    border-color: var(--fondo);
  }

  .pt__opt:focus-visible,
  .pt__range:focus-visible {
    outline: 3px solid var(--ocre);
    outline-offset: 2px;
  }

  .pt__opt[aria-pressed="true"] {
    border-color: var(--ocre);
    background: var(--ocre);
    color: var(--noche);
  }

  .pt__opt :global(.icon) {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Con el color de su señal en el lienzo (voz, guion, cuenta; monto, plazo...). */
  .pt__opt--color {
    border-color: rgb(var(--c) / 0.55);
  }

  .pt__opt--color[aria-pressed="true"] {
    border-color: rgb(var(--c));
    background: rgb(var(--c));
  }

  .pt__swatch {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgb(var(--c));
    box-shadow: 0 0 0 1.5px rgb(255 255 255 / 0.18);
  }

  .pt__opt--color[aria-pressed="true"] .pt__swatch {
    background: var(--noche);
    box-shadow: none;
  }

  .pt__opt--ok[aria-pressed="true"] {
    border-color: #6fcf8e;
    background: #6fcf8e;
  }

  .pt__opt--no[aria-pressed="true"] {
    border-color: var(--fondo);
    background: var(--fondo);
  }

  /* Los deslizadores: riel fino, perilla crema con borde ocre. */
  .pt__range {
    width: 100%;
    max-width: 26rem;
    height: 28px;
    margin: 0;
    background: none;
    cursor: pointer;
    appearance: none;
  }

  .pt__range::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.22);
  }

  .pt__range::-webkit-slider-thumb {
    width: 22px;
    height: 22px;
    margin-top: -8px;
    border: 3px solid var(--ocre);
    border-radius: 50%;
    background: var(--fondo);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.45);
    appearance: none;
  }

  .pt__range::-moz-range-track {
    height: 6px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.22);
  }

  .pt__range::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: 3px solid var(--ocre);
    border-radius: 50%;
    background: var(--fondo);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.45);
  }

  .pt__ends {
    display: flex;
    justify-content: space-between;
    max-width: 26rem;
    margin-top: -6px;
    color: var(--claro-tenue);
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .pt__out {
    min-height: 1.45em;
    margin: 0;
    color: var(--fondo);
    font-size: var(--step-small);
    font-variant-numeric: tabular-nums;
    line-height: 1.45;
  }

  .pt__out:empty {
    display: none;
  }

  .pt__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .pt__ghost {
    border: 1.5px solid rgb(255 255 255 / 0.4);
    background: none;
    color: var(--fondo);
  }

  .pt__ghost:hover {
    border-color: var(--fondo);
  }

  .pt__rail {
    display: none;
  }

  /* Sin movimiento (con JavaScript): cada escena lleva su dibujo final. */
  .pt :global(.pt__still) {
    display: block;
    width: 100%;
    max-width: 720px;
    height: auto;
    aspect-ratio: 4 / 3;
    margin-top: 8px;
    border-radius: var(--r-m);
    background: rgb(0 0 0 / 0.18);
  }

  @media (min-width: 900px) {
    .pt__scene:has(:global(.pt__still)) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: 48px;
      max-width: none;
    }

    .pt__scene:has(:global(.pt__still)) > :not(:global(.pt__still)) {
      grid-column: 1;
    }

    .pt :global(.pt__still) {
      grid-column: 2;
      grid-row: 1 / span 9;
      margin-top: 0;
    }
  }

  /* ---------- En vivo: la sección se fija y el scroll avanza las escenas ---------- */
  /* Con JavaScript (la clase .js la pone Base.astro antes de pintar) y sin pedir menos movimiento. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .pt .pt__track {
      height: calc(100svh - var(--pt-top) + var(--n) * 85svh);
    }

    :global(.js) .pt .pt__stage {
      position: sticky;
      top: var(--pt-top);
      height: calc(100svh - var(--pt-top));
      overflow: hidden;
    }

    :global(.js) .pt .pt__canvas {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
    }

    :global(.js) .pt .pt__copy {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      padding: 0 var(--margin);
      pointer-events: none;
    }

    :global(.js) .pt .pt__scenes {
      position: relative;
      display: grid;
      width: min(100%, 30rem);
    }

    /* El texto nunca se atenúa: entra descubriéndose de arriba abajo (clip-path) y sale igual. */
    :global(.js) .pt .pt__scene {
      grid-area: 1 / 1;
      align-self: center;
      visibility: hidden;
      clip-path: inset(0 0 100% 0);
      transform: translateY(14px);
      transition:
        clip-path 0.4s ease,
        transform 0.4s ease,
        visibility 0s linear 0.4s;
    }

    :global(.js) .pt .pt__scene.is-on {
      visibility: visible;
      clip-path: inset(0 0 0 0);
      transform: none;
      transition:
        clip-path 0.55s ease 0.12s,
        transform 0.55s ease 0.12s,
        visibility 0s;
      pointer-events: auto;
    }

    /* Anterior, siguiente, en qué escena va y el salto a lo que sigue (abajo, bajo el texto). */
    :global(.js) .pt .pt__nav {
      position: absolute;
      bottom: 22px;
      left: max(var(--margin), calc((100vw - 1232px) / 2));
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .pt__arrow {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1.5px solid rgb(255 255 255 / 0.4);
      border-radius: 50%;
      background: rgb(28 20 15 / 0.6);
      color: var(--fondo);
      cursor: pointer;
    }

    .pt__arrow:hover:not([aria-disabled="true"]) {
      border-color: var(--fondo);
    }

    .pt__arrow[aria-disabled="true"] {
      border-color: rgb(255 255 255 / 0.16);
      color: rgb(255 255 255 / 0.3);
      cursor: default;
    }

    .pt__arrow:focus-visible,
    .pt__skip:focus-visible {
      outline: 3px solid var(--ocre);
      outline-offset: 2px;
    }

    .pt__arrow :global(.icon) {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .pt__count {
      min-width: 4.5em;
      margin: 0 4px 0 6px;
      color: var(--fondo);
      font-size: var(--step-small);
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }

    .pt__skip {
      color: var(--claro-tenue);
      font-size: var(--step-small);
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .pt__skip:hover {
      color: var(--fondo);
    }

    /* Cuánto falta: una línea ocre al pie del escenario. */
    :global(.js) .pt .pt__progress {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      display: block;
      height: 3px;
      background: rgb(255 255 255 / 0.08);
    }

    .pt__progress span {
      display: block;
      height: 100%;
      background: var(--ocre);
      transform: scaleX(var(--p, 0));
      transform-origin: left;
    }

    /* La barra de escenas: puntos a la derecha (en el celular, una línea arriba). */
    :global(.js) .pt .pt__rail {
      position: absolute;
      top: 50%;
      right: 14px;
      display: block;
      transform: translateY(-50%);
    }

    .pt__rail ol {
      display: grid;
      gap: 4px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .pt__dot {
      position: relative;
      display: grid;
      place-items: center;
      width: 28px;
      height: 28px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }

    .pt__dot::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgb(255 255 255 / 0.32);
      transition:
        transform 0.2s,
        background-color 0.2s;
    }

    .pt__dot[aria-current="step"]::before {
      background: var(--ocre);
      transform: scale(1.5);
    }

    .pt__dot:hover::before {
      background: var(--fondo);
    }

    .pt__dot:focus-visible {
      outline: 3px solid var(--ocre);
      outline-offset: 0;
      border-radius: 50%;
    }

    .pt__dot-label {
      position: absolute;
      right: 32px;
      padding: 2px 8px;
      border-radius: 6px;
      background: rgb(18 12 9 / 0.9);
      color: var(--fondo);
      font-size: 0.75rem;
      font-weight: 700;
      white-space: nowrap;
      visibility: hidden;
    }

    .pt__dot:hover .pt__dot-label,
    .pt__dot:focus-visible .pt__dot-label {
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (max-width: 899px) {
    /* El dibujo arriba y el texto abajo; el degradado empieza donde termina el dibujo (--pt-viz). */
    :global(.js) .pt .pt__copy {
      align-items: flex-end;
      padding-bottom: 22px;
      background: linear-gradient(
        180deg,
        transparent calc(var(--pt-viz, 48vh) - 8px),
        rgb(28 20 15 / 0.94) calc(var(--pt-viz, 48vh) + 26px)
      );
    }

    :global(.js) .pt .pt__scene {
      align-self: end;
      gap: 9px;
    }

    :global(.js) .pt .pt__scene:has(.pt__ctl) .pt__tags,
    :global(.js) .pt .pt__ends {
      display: none;
    }

    :global(.js) .pt .pt__title {
      font-size: clamp(1.375rem, 1.1rem + 1.6vw, 1.75rem);
    }

    :global(.js) .pt .pt__title--first {
      font-size: clamp(1.75rem, 1.4rem + 2vw, 2.25rem);
    }

    :global(.js) .pt .pt__text {
      font-size: 0.9375rem;
      line-height: 1.45;
    }

    /* En el celular se avanza deslizando: sin flechas; los controles, más compactos. */
    :global(.js) .pt .pt__nav {
      display: none;
    }

    :global(.js) .pt .pt__ctl {
      gap: 6px;
      margin-top: 2px;
    }

    .pt__opt,
    .pt__play {
      min-height: 38px;
      padding: 0 12px;
      font-size: 0.8125rem;
    }

    .pt__out,
    .pt__ctl-label {
      font-size: 0.8125rem;
    }

    .pt__tags li {
      font-size: 0.75rem;
    }

    :global(.js) .pt .pt__rail {
      top: 8px;
      right: 50%;
      transform: translateX(50%);
    }

    :global(.js) .pt .pt__rail ol {
      display: flex;
      gap: 0;
    }

    .pt__dot {
      width: 24px;
      height: 24px;
    }

    .pt__dot-label {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (min-width: 900px) {
    /* El texto se centra en el alto que dejan libre las flechas de abajo. */
    :global(.js) .pt .pt__copy {
      max-width: none;
      padding-top: 20px;
      padding-bottom: 84px;
      padding-left: max(var(--margin), calc((100vw - 1232px) / 2));
    }

    :global(.js) .pt .pt__scenes {
      width: min(36vw, 30rem);
    }
  }

  @media (min-width: 1100px) {
    .pt {
      --pt-top: 109px;
    }
  }
</style>

<script>
  import type { Dict } from "../i18n";

  type Rect = { x: number; y: number; w: number; h: number };
  type G = CanvasRenderingContext2D;
  type Labels = Dict["lp"]["pitch"]["canvas"];
  type Config = {
    grid: { cols: number; rows: number; tiles: [string, number, number, string][] };
    photo: string;
    labels: Labels;
    ui: Dict["lp"]["pitch"]["ui"];
    nav: Dict["lp"]["pitch"]["nav"];
  };
  type Pieza = {
    tipo: "audio" | "texto" | "imagen";
    texto?: string;
    onda?: number[];
    dia?: number;
    hora?: string;
    segundos?: number;
  };
  type Casos = { casos: { caso: string; contacto: string; piezas: Pieza[] }[] };
  type Marca = { a: number; b: number; kind: string };
  type CasoFicha = {
    tipo_amenaza: string | null;
    monto_soles: number | null;
    periodicidad: string | null;
    plazo: string | null;
    canal_pago: string | null;
    grupo: string | null;
    frases: string[];
    identificadores: { tipo: string; valor: string; rol: string }[];
    fuentes: string[];
  };
  type Par = { par: string; coseno: number; frases: string[]; canal: boolean; grupo: boolean; x: number; p: number };
  type Señales = { voz: number; guion: number; cuenta: number; total: number };
  type PitchData = {
    radar: { caso_a: number; caso_c: number; victima_a: number; slr73: number[] };
    lee: { piezas: { label: string; tipo: string; texto: string; marcas: Marca[] }[] };
    casos: Record<string, CasoFicha>;
    numeros: {
      items: { caso: string; rol: string; valor: string; normalizado: string; ref: string; ultimos: string }[];
    };
    patrones: {
      frases: { frase: string; casos: string[] }[];
      coseno_media: number;
      vector_a: number[] | null;
      vector_b: number[] | null;
      x_mismo: number[];
      x_distintos: number[];
      cal: { a: number; b: number; p_max: number };
      pares: Par[];
    };
    combina: { ab: Señales; bc: Señales; revisar: number; probable: number };
    vigia: {
      ventana: number;
      casos: { caso: string; zona: string; dia: number; grupo: string | null }[];
    };
  };
  type VozData = {
    disfraz: number;
    espectro: { filas: number; columnas: number; por_semitono: number; limpia: string; disfrazada: string };
    huella: { escala: number; guardada: string; limpia: string; barrido: { k: number; coseno: number; v: string }[] };
  };
  type FotosData = {
    grid: { cols: number; rows: number };
    pix: Record<string, string>;
    pares: { a: string; b: string; con_pareja: number; lineas: number[][] }[];
  };
  type MapsData = {
    latam: {
      caja: [number, number, number, number];
      paso: number;
      paises: string[];
      puntos: [number, number, number][];
    };
    peru: { caja: [number, number, number, number]; paso: number; puntos: [number, number][] };
  };
  type Data = { casos?: Casos; pitch?: PitchData; voz?: VozData; fotos?: FotosData; mapas?: MapsData };

  // ---------- Colores y utilidades ----------
  const COL = {
    cream: "255 241 214",
    dim: "214 209 202",
    ocre: "231 173 69",
    id: "111 207 142",
    frase: "236 159 208",
    img: "141 187 230",
    terra: "214 98 62",
    alert: "231 120 80",
    blue: "126 176 216",
  };
  const NOCHE = [42, 30, 23];
  const OCRE = [231, 173, 69];
  const AZUL = [126, 176, 216];
  const RAMP = [
    [36, 25, 19],
    [92, 42, 27],
    [168, 80, 38],
    [231, 173, 69],
    [255, 241, 214],
  ];
  const SHIELD = "M11.5 0 23 4v8.5C23 20 18.1 25.4 11.5 28 4.9 25.4 0 20 0 12.5V4Z";
  const clamp = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x);
  const ease = (x: number) => 1 - (1 - clamp(x)) ** 3;
  const inout = (x: number) => {
    const v = clamp(x);
    return v < 0.5 ? 4 * v * v * v : 1 - (-2 * v + 2) ** 3 / 2;
  };
  const lerp = (a: number, b: number, u: number) => a + (b - a) * u;
  const seg = (u: number, a: number, b: number) => clamp((u - a) / (b - a));
  const rnd = (k: number) => (((k + 1) * 2654435761) >>> 0) / 4294967296;
  const c = (rgb: string, a = 1) => `rgb(${rgb} / ${a.toFixed(3)})`;
  const rgb = (v: number[], a = 1) => `rgb(${v[0]! | 0} ${v[1]! | 0} ${v[2]! | 0} / ${a.toFixed(3)})`;
  const fmt = (x: number) => x.toFixed(2);
  const fill = (s: string, t: Record<string, string | number>) =>
    s.replace(/\{(\w+)\}/g, (m, k: string) => (k in t ? String(t[k]) : m));
  const signed = (k: number) => (k > 0 ? `+${k}` : k < 0 ? `−${-k}` : "0");
  const ramp = (u: number) => {
    const x = clamp(u) * (RAMP.length - 1);
    const i = Math.min(RAMP.length - 2, Math.floor(x));
    const f = x - i;
    return RAMP[i]!.map((v, j) => v + (RAMP[i + 1]![j]! - v) * f);
  };
  const cellColor = (x: number, scale: number) => {
    const u = Math.min(1, Math.abs(x) / scale) ** 0.75;
    const to = x >= 0 ? OCRE : AZUL;
    return NOCHE.map((v, j) => v + (to[j]! - v) * u);
  };
  const vec = (s: string, scale: number) =>
    Float32Array.from({ length: s.length / 2 }, (_, i) => {
      let q = parseInt(s.slice(i * 2, i * 2 + 2), 16);
      if (q > 127) q -= 256;
      return (q / 127) * scale;
    });

  for (const root of document.querySelectorAll<HTMLElement>("[data-pitch]")) {
    const canvas = root.querySelector<HTMLCanvasElement>("[data-canvas]")!;
    const ctx = canvas.getContext("2d");
    if (!ctx) continue;
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const scenes = [...root.querySelectorAll<HTMLElement>("[data-scene]")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-goto]")];
    const copy = root.querySelector<HTMLElement>(".pt__scenes")!;
    const cfg = JSON.parse(root.dataset.config ?? "{}") as Config;
    const L = cfg.labels;
    const U = cfg.ui;
    const sceneOf = (el: Element) => Number(el.closest<HTMLElement>("[data-scene]")?.dataset.scene ?? -1);
    /** Vuelve a dibujar una escena después de tocar algo (en vivo, el lienzo; sin movimiento, su dibujo quieto). */
    let repaint: (i: number) => void = () => {};

    // ---------- Lo que la persona eligió en cada escena (null: lo decide el scroll) ----------
    const I = {
      victim: -1,
      undo: null as number | null,
      thr: null as number | null,
      look: null as number | null,
      field: null as string | null,
      sig: { voz: true, guion: true, cuenta: true } as Record<"voz" | "guion" | "cuenta", boolean>,
      review: null as "ok" | "no" | null,
      day: null as number | null,
      country: null as number | null,
      /** Las escenas que la persona ya tocó: su dibujo se muestra completo, sin esperar al scroll. */
      touched: new Set<number>(),
      /** Cuándo fue el último toque (para las transiciones que dependen del tiempo). */
      t: 0,
    };
    /** Valores que se acercan a su meta cuadro a cuadro; `moving` pide otro cuadro. */
    const sm: Record<string, number> = {};
    let moving = false;
    const smooth = (key: string, to: number) => {
      const v = sm[key] ?? to;
      const next = reduce || Math.abs(to - v) < 0.002 ? to : v + (to - v) * 0.2;
      sm[key] = next;
      if (next !== to) moving = true;
      return next;
    };
    /** Lo que marca el scroll en la escena que se ve (para que los deslizadores lo sigan). */
    const auto: { undo?: number; day?: number } = {};
    let main = false;

    // Los audios: uno a la vez, se crean al tocar y se detienen al cambiar de escena.
    let sound: { a: HTMLAudioElement; b: HTMLButtonElement; ended: boolean } | null = null;
    const stopSound = () => {
      sound?.a.pause();
    };
    /** Cuánto lleva el audio de ese archivo (0 a 1; 1 si terminó), o -1 si no es el último que sonó. */
    const heard = (src: string) => {
      if (!sound || sound.b.dataset.src !== src) return -1;
      if (sound.ended) return 1;
      const d = sound.a.duration;
      return d > 0 && Number.isFinite(d) ? Math.min(1, sound.a.currentTime / d) : 0;
    };
    const playing = () => !!sound && !sound.a.paused;
    for (const b of root.querySelectorAll<HTMLButtonElement>("[data-src]")) {
      b.addEventListener("click", () => {
        const at = sceneOf(b);
        if (b.dataset.victim) I.victim = Number(b.dataset.victim);
        if (b.dataset.undo) setUndo(Number(b.dataset.undo), false);
        if (sound?.b === b && !sound.a.paused) {
          sound.a.pause();
          return;
        }
        stopSound();
        const a = new Audio(b.dataset.src);
        const s = { a, b, ended: false };
        const tick = () => repaint(at);
        a.addEventListener("play", () => {
          b.setAttribute("aria-pressed", "true");
          tick();
        });
        a.addEventListener("pause", () => {
          b.setAttribute("aria-pressed", "false");
          tick();
        });
        a.addEventListener("ended", () => {
          s.ended = true;
          b.setAttribute("aria-pressed", "false");
          tick();
        });
        // Sin movimiento no hay cuadros: el dibujo quieto se actualiza con el avance del audio.
        if (reduce) a.addEventListener("timeupdate", tick);
        sound = s;
        tick();
        void a.play();
      });
    }
    /** "A-B" o ("A", "B") como "A y B" / "A and B". */
    const pairName = (a: string, b?: string) => {
      const [x = "", y = ""] = b === undefined ? a.split("-") : [a, b];
      return fill(L.pair, { a: x, b: y });
    };
    const N = scenes.length;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const D: Data = {};
    let display = "sans-serif";
    let sans = "sans-serif";
    /** Las familias ya resueltas (el lienzo no entiende var()). */
    const fonts = () => {
      sans = getComputedStyle(root).fontFamily;
      const t = root.querySelector(".pt__title");
      display = t ? getComputedStyle(t).fontFamily : sans;
    };
    const photo = new Image();
    photo.decoding = "async";

    // ---------- Texto en el lienzo ----------
    const font = (g: G, size: number, weight = 400, fam = sans) => (g.font = `${weight} ${size}px ${fam}`);
    const txt = (
      g: G,
      s: string,
      x: number,
      y: number,
      size: number,
      color: string,
      weight = 400,
      align: CanvasTextAlign = "left",
      fam = sans,
    ) => {
      font(g, size, weight, fam);
      g.fillStyle = color;
      g.textAlign = align;
      g.textBaseline = "middle";
      g.fillText(s, x, y);
    };
    const pill = (g: G, s: string, x: number, y: number, col: string, size: number, solid = false) => {
      font(g, size, 700);
      const w = g.measureText(s).width + size * 1.1;
      const h = size + 10;
      g.beginPath();
      g.roundRect(x - w / 2, y - h / 2, w, h, h / 2);
      g.fillStyle = solid ? c(col) : "rgb(18 12 9 / 0.9)";
      g.fill();
      g.strokeStyle = c(col, 0.95);
      g.lineWidth = 1.2;
      g.stroke();
      txt(g, s, x, y + 0.5, size, solid ? "rgb(28 20 15)" : c(col), 700, "center");
      return w;
    };
    /** Texto en varias líneas dentro de un ancho; devuelve cuántas usó. */
    const wrap = (
      g: G,
      s: string,
      x: number,
      y: number,
      maxW: number,
      size: number,
      color: string,
      weight = 400,
      lh = 1.3,
      max = 99,
    ) => {
      font(g, size, weight);
      const words = s.split(" ");
      const lines: string[] = [];
      let cur = "";
      for (const w of words) {
        const next = cur ? `${cur} ${w}` : w;
        if (g.measureText(next).width > maxW && cur) {
          lines.push(cur);
          cur = w;
        } else cur = next;
      }
      if (cur) lines.push(cur);
      const out = lines.slice(0, max);
      if (lines.length > max) out[max - 1] = `${out[max - 1]}…`;
      out.forEach((l, i) => txt(g, l, x, y + i * size * lh, size, color, weight));
      return out.length;
    };
    const fitGrid = (R: Rect, cols: number, rows: number, aspect = 1.2) => {
      const w = Math.min(R.w / cols, (R.h / rows) * aspect);
      const h = w / aspect;
      return { x: R.x + (R.w - w * cols) / 2, y: R.y + (R.h - h * rows) / 2, w, h };
    };

    // ---------- Lo que se toca en el lienzo: atajos con el mouse o el dedo ----------
    // Cada uno tiene su equivalente en los controles del texto o en la barra de escenas (teclado).
    type Hit = { x: number; y: number; w: number; h: number; go: () => void };
    let hits: Hit[] = [];
    const hit = (x: number, y: number, w: number, h: number, go: () => void) => {
      if (main) hits.push({ x, y, w, h, go });
    };
    /** Lleva el scroll a una escena (lo define el modo en vivo). */
    let goto: (i: number) => void = () => {};
    const press = (sel: string) => root.querySelector<HTMLButtonElement>(sel)?.click();

    // ---------- Lo que se prepara una vez ----------
    let spec: { limpia: HTMLCanvasElement; disfrazada: HTMLCanvasElement } | null = null;
    let fp: {
      a: Float32Array;
      b: Float32Array;
      sweep: { k: number; cos: number; v: Float32Array }[];
      scale: number;
    } | null = null;
    const specCanvas = (hex: string, R: number, C: number) => {
      const el = document.createElement("canvas");
      el.width = C;
      el.height = R;
      const g = el.getContext("2d")!;
      const im = g.createImageData(C, R);
      const lut = Array.from({ length: 16 }, (_, i) => ramp((i / 15) ** 1.15));
      for (let r = 0; r < R; r++) {
        for (let col = 0; col < C; col++) {
          const v = lut[parseInt(hex[r * C + col]!, 16)]!;
          const i = ((R - 1 - r) * C + col) * 4;
          im.data[i] = v[0]!;
          im.data[i + 1] = v[1]!;
          im.data[i + 2] = v[2]!;
          im.data[i + 3] = 255;
        }
      }
      g.putImageData(im, 0, 0);
      return el;
    };
    const prepare = () => {
      if (D.voz && !spec) {
        const e = D.voz.espectro;
        spec = {
          limpia: specCanvas(e.limpia, e.filas, e.columnas),
          disfrazada: specCanvas(e.disfrazada, e.filas, e.columnas),
        };
        const h = D.voz.huella;
        const a = vec(h.guardada, h.escala);
        fp = {
          a,
          b: vec(h.limpia, h.escala),
          sweep: h.barrido.map((s) => ({ k: s.k, cos: s.coseno, v: vec(s.v, h.escala) })),
          scale: Math.max(...a.map(Math.abs)) * 0.8,
        };
      }
    };

    const tiles = cfg.grid.tiles;

    // ---------- Las escenas ----------

    // ---------- Mapas de puntos: América Latina y el Perú ----------
    type View = { lon0: number; lon1: number; lat0: number; lat1: number };
    const LATAM_V: View = { lon0: -118, lon1: -34, lat0: -56, lat1: 33 };
    const PERU_V: View = { lon0: -83.5, lon1: -66.5, lat0: -19.5, lat1: 1 };
    const lerpView = (a: View, b: View, t: number): View => ({
      lon0: lerp(a.lon0, b.lon0, t),
      lon1: lerp(a.lon1, b.lon1, t),
      lat0: lerp(a.lat0, b.lat0, t),
      lat1: lerp(a.lat1, b.lat1, t),
    });
    /** Proyección equirectangular con la longitud corregida por la latitud media; centrada en R. */
    const project = (R: Rect, v: View) => {
      const k = Math.cos((((v.lat0 + v.lat1) / 2) * Math.PI) / 180);
      const sw = (v.lon1 - v.lon0) * k;
      const sh = v.lat1 - v.lat0;
      const s = Math.min(R.w / sw, R.h / sh);
      const ox = R.x + (R.w - sw * s) / 2;
      const oy = R.y + (R.h - sh * s) / 2;
      return { s, k, X: (lon: number) => ox + (lon - v.lon0) * k * s, Y: (lat: number) => oy + (v.lat1 - lat) * s };
    };
    /** Distritos fiscales con más casos, enero a julio de 2026 (Exitosa con datos del Ministerio Público). */
    const FISCAL = [
      { name: "Lima Este", n: 1806, lon: -76.9, lat: -12.0 },
      { name: "La Libertad", n: 1625, lon: -79.03, lat: -8.11 },
      { name: "Lima Sur", n: 1346, lon: -76.95, lat: -12.2 },
      { name: "Lima Norte", n: 1305, lon: -77.07, lat: -11.92 },
      { name: "Lima Centro", n: 1178, lon: -77.04, lat: -12.05 },
    ];
    /** Capitales de la región (para el alcance) y Lima. */
    const LIMA = { lon: -77.04, lat: -12.05 };
    const CAPITALES: [string, number, number][] = [
      ["EC", -78.47, -0.18],
      ["CO", -74.07, 4.71],
      ["BO", -68.15, -16.5],
      ["CL", -70.67, -33.45],
      ["PA", -79.52, 8.98],
      ["CR", -84.09, 9.93],
      ["VE", -66.9, 10.48],
      ["BR", -46.63, -23.55],
      ["PY", -57.58, -25.26],
      ["AR", -58.38, -34.6],
      ["UY", -56.16, -34.9],
      ["SV", -89.19, 13.69],
      ["HN", -87.19, 14.07],
      ["GT", -90.51, 14.64],
      ["DO", -69.93, 18.49],
      ["MX", -99.13, 19.43],
    ];
    /** Las denuncias que caen sobre el Perú: cada punto, unas 100; casi la mitad, en los distritos fiscales de arriba. */
    const RAIN = (() => {
      const out: { lon: number; lat: number; d: number; peru: number }[] = [];
      const total = 139;
      FISCAL.forEach((f, i) => {
        const k = Math.round(f.n / 100);
        for (let j = 0; j < k; j++) {
          const r = rnd(i * 97 + j * 13) * 0.55;
          const a = rnd(i * 31 + j * 7) * Math.PI * 2;
          out.push({
            lon: f.lon + Math.cos(a) * r,
            lat: f.lat + Math.sin(a) * r * 0.8,
            d: rnd(i * 17 + j * 3),
            peru: -1,
          });
        }
      });
      for (let j = out.length; j < total; j++)
        out.push({ lon: 0, lat: 0, d: rnd(j * 5 + 1), peru: Math.floor(rnd(j * 11 + 3) * 1e6) });
      return out;
    })();

    /** Los puntos de América Latina; el Perú en terracota y, si toca, otros países encendidos. */
    const drawLatam = (
      g: G,
      M: MapsData,
      P: ReturnType<typeof project>,
      alpha: number,
      lit?: (code: string) => number,
    ) => {
      const L0 = M.latam;
      // El tamaño del punto no crece con el zoom: al acercarse, los puntos se separan.
      const r = Math.min(3.2, Math.max(1.1, L0.paso * P.s * P.k * 0.3));
      for (const [col, fila, k] of L0.puntos) {
        const code = L0.paises[k] ?? "";
        const x = P.X(L0.caja[0] + col * L0.paso);
        const y = P.Y(L0.caja[3] - fila * L0.paso);
        const on = code === "PE" ? 1 : (lit?.(code) ?? 0);
        g.fillStyle =
          code === "PE"
            ? c(COL.terra, alpha)
            : on > 0
              ? c(COL.ocre, alpha * (0.25 + 0.75 * on))
              : c(COL.cream, 0.2 * alpha);
        g.beginPath();
        g.arc(x, y, r, 0, Math.PI * 2);
        g.fill();
      }
    };

    /** 1. El problema: de América Latina al Perú, y las denuncias que caen sin conectarse. */
    const sceneProblem = (g: G, R: Rect, u: number) => {
      const M = D.mapas;
      if (!M) return;
      const small = R.w < 560;
      const fs = small ? 10 : 12.5;
      const head = Math.min(small ? 64 : 92, R.h * 0.16);
      const box = { x: R.x, y: R.y + head, w: R.w, h: (R.h - head) * (small ? 0.6 : 1) };
      const z = inout(seg(u, 0.18, 0.46));
      const P = project(box, lerpView(LATAM_V, PERU_V, z));
      const a0 = ease(seg(u, 0, 0.08));
      // América Latina, que se va al acercarse al Perú.
      const la = a0 * (1 - seg(u, 0.22, 0.36));
      if (la > 0) drawLatam(g, M, P, la);
      if (la > 0.3 && z < 0.2) {
        g.globalAlpha = la * (1 - z * 5);
        pill(g, L.peru, P.X(-75), P.Y(-9) - 2, COL.terra, fs, true);
        txt(g, L.latam, P.X(-102), P.Y(-30), fs + 2, c(COL.dim), 700);
        g.globalAlpha = 1;
      }
      // El Perú, punto por punto.
      const pa = seg(u, 0.24, 0.4);
      if (pa > 0) {
        const PE = M.peru;
        const r = Math.max(0.9, PE.paso * P.s * P.k * 0.3);
        g.fillStyle = c(COL.cream, 0.17 * pa);
        for (const [col, fila] of PE.puntos) {
          g.beginPath();
          g.arc(P.X(PE.caja[0] + col * PE.paso), P.Y(PE.caja[3] - fila * PE.paso), r, 0, Math.PI * 2);
          g.fill();
        }
      }
      // Las denuncias caen, cada una sola.
      const PE = M.peru;
      RAIN.forEach((d, i) => {
        let lon = d.lon;
        let lat = d.lat;
        if (d.peru >= 0) {
          const pt = PE.puntos[d.peru % PE.puntos.length]!;
          lon = PE.caja[0] + pt[0] * PE.paso;
          lat = PE.caja[3] - pt[1] * PE.paso;
        }
        const t0 = 0.5 + d.d * 0.3;
        const f = seg(u, t0, t0 + 0.06);
        if (f <= 0) return;
        const tx = P.X(lon);
        const ty = P.Y(lat);
        if (f < 1) {
          const y = lerp(box.y - 10, ty, f * f);
          g.strokeStyle = c(COL.cream, 0.6);
          g.lineWidth = 1.2;
          g.beginPath();
          g.moveTo(tx, y - 18);
          g.lineTo(tx, y);
          g.stroke();
        } else {
          g.fillStyle = c(COL.alert, i % 3 === 0 ? 0.95 : 0.8);
          g.beginPath();
          g.arc(tx, ty, small ? 1.8 : 2.4, 0, Math.PI * 2);
          g.fill();
        }
      });
      // Los distritos fiscales con más casos: marcas en el mapa y barras.
      const fb = seg(u, 0.52, 0.8);
      if (fb > 0) {
        for (const pl of [
          { name: "Lima", lon: LIMA.lon, lat: LIMA.lat },
          { name: "La Libertad", lon: -79.03, lat: -8.11 },
        ]) {
          const x = P.X(pl.lon);
          const y = P.Y(pl.lat);
          g.strokeStyle = c(COL.ocre, 0.9 * fb);
          g.lineWidth = 1.5;
          g.beginPath();
          g.arc(x, y, 6 + 10 * (1 - fb), 0, Math.PI * 2);
          g.stroke();
          g.globalAlpha = fb;
          txt(g, pl.name, x - 12, y + 1, fs, c(COL.cream), 800, "right");
          g.globalAlpha = 1;
        }
        const cw = small ? R.w : Math.min(300, R.w * 0.4);
        const cx = small ? R.x : R.x + R.w - cw;
        const cy = small ? box.y + box.h + 26 : box.y + box.h * 0.48;
        const max = FISCAL[0]!.n;
        g.globalAlpha = fb;
        txt(g, L.fiscalTitle, cx, cy - 14, fs - 1, c(COL.dim), 700);
        g.globalAlpha = 1;
        FISCAL.forEach((f, i) => {
          const a = ease(seg(u, 0.54 + i * 0.04, 0.62 + i * 0.04));
          if (a <= 0) return;
          const y = cy + 6 + i * (small ? 22 : 26);
          const nameW = small ? 78 : 92;
          g.globalAlpha = a;
          txt(g, f.name, cx, y, fs - 1, c(COL.cream), 700);
          g.fillStyle = c(COL.alert, 0.85);
          g.fillRect(cx + nameW, y - 5, (cw - nameW - 50) * (f.n / max) * a, 10);
          txt(
            g,
            f.n.toLocaleString("en-US"),
            cx + nameW + (cw - nameW - 50) * (f.n / max) * a + 6,
            y + 0.5,
            fs - 1,
            c(COL.cream),
            700,
          );
          g.globalAlpha = 1;
        });
        const per = seg(u, 0.82, 0.9);
        if (per > 0) {
          g.globalAlpha = per;
          g.fillStyle = c(COL.alert);
          g.beginPath();
          g.arc(cx + 4, cy + 6 + 5 * (small ? 22 : 26) + 6, 2.4, 0, Math.PI * 2);
          g.fill();
          txt(g, L.perDot, cx + 12, cy + 6 + 5 * (small ? 22 : 26) + 6.5, fs - 1.5, c(COL.dim));
          g.globalAlpha = 1;
        }
      }
      // El contador.
      const n = Math.round(13892 * ease(seg(u, 0.05, 0.7)));
      g.globalAlpha = a0;
      txt(
        g,
        n.toLocaleString("en-US"),
        R.x,
        R.y + head * 0.36,
        Math.min(54, head * 0.62),
        c(COL.cream),
        800,
        "left",
        display,
      );
      txt(g, L.reportsPeru, R.x, R.y + head * 0.8, Math.min(15, head * 0.2), c(COL.dim));
      g.globalAlpha = 1;
    };

    /** 14. Escala: de Lima a la región, y el expediente que cualquier policía o fiscalía puede recibir. */
    /** Los países de "Escala", en el orden de los rótulos de pago. */
    const PAY_CODES = ["PE", "CO", "BR", "CR"];
    const sceneScale = (g: G, R: Rect, u0: number) => {
      const M = D.mapas;
      if (!M) return;
      // Si la persona elige un país, ese se enciende y su línea desde Lima se marca.
      const sel = I.country;
      const pick = sel === null ? "" : (PAY_CODES[sel] ?? "");
      const u = sel === null ? u0 : Math.max(u0, 0.9);
      const small = R.w < 560;
      const fs = small ? 10 : 12.5;
      const box = small ? { x: R.x, y: R.y, w: R.w, h: R.h * 0.72 } : { x: R.x, y: R.y, w: R.w * 0.72, h: R.h };
      const P = project(box, LATAM_V);
      const lit = new Map<string, number>();
      CAPITALES.forEach(([code], i) => lit.set(code, ease(seg(u, 0.12 + i * 0.03, 0.2 + i * 0.03))));
      drawLatam(g, M, P, ease(seg(u, 0, 0.08)), (code) =>
        pick ? (code === pick ? 1 : 0.12 * (lit.get(code) ?? 0)) : (lit.get(code) ?? 0),
      );
      // Desde Lima, una línea a cada capital.
      const x0 = P.X(LIMA.lon);
      const y0 = P.Y(LIMA.lat);
      CAPITALES.forEach(([code, lon, lat], i) => {
        const f = ease(seg(u, 0.08 + i * 0.03, 0.2 + i * 0.03));
        if (f <= 0) return;
        const x1 = P.X(lon);
        const y1 = P.Y(lat);
        const mx = (x0 + x1) / 2 - (y1 - y0) * 0.18;
        const my = (y0 + y1) / 2 + (x1 - x0) * 0.18 - 20;
        const mine = code === pick;
        g.strokeStyle = c(COL.ocre, pick ? (mine ? 1 : 0.18) : 0.65);
        g.lineWidth = mine ? 2.6 : 1.3;
        g.beginPath();
        g.moveTo(x0, y0);
        const n = 24;
        for (let k = 1; k <= n * f; k++) {
          const t = k / n;
          g.lineTo(
            (1 - t) * (1 - t) * x0 + 2 * (1 - t) * t * mx + t * t * x1,
            (1 - t) * (1 - t) * y0 + 2 * (1 - t) * t * my + t * t * y1,
          );
        }
        g.stroke();
        if (f >= 1) {
          g.fillStyle = c(COL.ocre);
          g.beginPath();
          g.arc(x1, y1, 2.6, 0, Math.PI * 2);
          g.fill();
        }
      });
      // Lima, hoy.
      const pulse = seg(u, 0, 0.3);
      g.strokeStyle = c(COL.terra, 1 - pulse);
      g.lineWidth = 2;
      g.beginPath();
      g.arc(x0, y0, 4 + pulse * 26, 0, Math.PI * 2);
      g.stroke();
      g.fillStyle = c(COL.terra);
      g.beginPath();
      g.arc(x0, y0, 4.5, 0, Math.PI * 2);
      g.fill();
      g.globalAlpha = ease(seg(u, 0.02, 0.1));
      pill(g, L.todayLima, x0 - (small ? 40 : 96), y0 + 22, COL.terra, fs - 1, true);
      g.globalAlpha = 1;
      // Lo que cambia por país: el canal de pago que usan las bandas.
      L.payments.forEach(([country, apps, lon, lat], i) => {
        const a = ease(seg(u, 0.55 + i * 0.05, 0.63 + i * 0.05));
        if (a <= 0) return;
        const mine = sel === i;
        g.globalAlpha = a * (sel === null || mine ? 1 : 0.5);
        const x = P.X(Number(lon));
        const y = P.Y(Number(lat));
        const w = pill(g, `${country}: ${apps}`, x, y, COL.ocre, fs - (mine ? 0 : 1.5), mine);
        g.globalAlpha = 1;
        hit(x - w / 2, y - fs, w, fs * 2, () => press(`[data-country="${i}"]`));
      });
      // El expediente, para cualquier policía o fiscalía.
      const ex = ease(seg(u, 0.72, 0.84));
      if (ex > 0) {
        const cw = small ? R.w : R.w * 0.26;
        const cx = small ? R.x : R.x + R.w - cw;
        const cy = small ? R.y + R.h * 0.76 : R.y + R.h * 0.34;
        const ch = small ? 62 : 170;
        g.globalAlpha = ex;
        g.fillStyle = "#f4efe8";
        g.beginPath();
        g.roundRect(cx, cy, cw, ch, 12);
        g.fill();
        // Una hoja con su esquina doblada.
        const ix = cx + 14;
        const iy = cy + 14;
        g.fillStyle = "#b4462a";
        g.beginPath();
        g.moveTo(ix, iy);
        g.lineTo(ix + 20, iy);
        g.lineTo(ix + 28, iy + 8);
        g.lineTo(ix + 28, iy + 34);
        g.lineTo(ix, iy + 34);
        g.closePath();
        g.fill();
        txt(g, "PDF", ix + 14, iy + 23, 8.5, "#fff", 800, "center");
        txt(g, L.file, ix + 38, iy + 10, fs + 1, "#2a1e17", 800);
        if (small) txt(g, L.anyPolice, ix + 38, iy + 30, fs - 1, "#5a4a40", 700);
        else {
          wrap(g, L.fileText, ix, iy + 54, cw - 28, fs - 0.5, "#2a1e17", 400, 1.35, 3);
          wrap(g, L.anyPolice, ix, iy + 108, cw - 28, fs, "#2f6b4a", 800, 1.3, 2);
        }
        g.globalAlpha = 1;
      }
    };

    const shieldPath = new Path2D(SHIELD);
    let shieldCells: { step: number; list: { x: number; y: number; k: number }[] } | null = null;
    /** 0. El logo: los píxeles llegan de todas partes y arman el escudo. */
    const sceneLogo = (g: G, R: Rect, _u: number, T: number) => {
      const S = Math.min(R.h * 0.5, R.w * 0.58);
      const sc = S / 28;
      const ox = R.x + R.w / 2 - 11.5 * sc;
      const oy = R.y + R.h * 0.34 - 14 * sc;
      const path = shieldPath;
      const cs = Math.max(5, S / 22);
      // Las celdas que caen dentro del escudo (sobre la forma de 23 x 28); se calculan una vez por tamaño.
      const cellStep = cs / sc;
      if (!shieldCells || shieldCells.step !== cellStep) {
        const probe = probeCtx();
        const list: { x: number; y: number; k: number }[] = [];
        for (let y = 0; y < 28; y += cellStep) {
          for (let x = 0; x < 23; x += cellStep) {
            if (probe.isPointInPath(path, x + cellStep / 2, y + cellStep / 2)) list.push({ x, y, k: list.length });
          }
        }
        shieldCells = { step: cellStep, list };
      }
      const cells = shieldCells.list;
      const done = clamp((T - 1700) / 600);
      cells.forEach(({ x, y, k }) => {
        const e = inout((T - rnd(k) * 700) / 1000);
        const tx = ox + x * sc;
        const ty = oy + y * sc;
        const sx = R.x + rnd(k * 5 + 1) * R.w * 1.2 - R.w * 0.1;
        const sy = R.y + rnd(k * 9 + 2) * R.h * 1.2 - R.h * 0.1;
        const shade = 0.82 + rnd(k * 13) * 0.25;
        g.fillStyle = `rgb(${(214 * shade) | 0} ${(98 * shade) | 0} ${(62 * shade) | 0} / ${(0.25 + 0.75 * e).toFixed(3)})`;
        const s = cs * (0.5 + 0.38 * e) * (1 - done * 0.15);
        g.fillRect(lerp(sx, tx, e) + (cs - s) / 2, lerp(sy, ty, e) + (cs - s) / 2, s, s);
      });
      if (done > 0) {
        g.save();
        g.translate(ox, oy);
        g.scale(sc, sc);
        g.fillStyle = `rgb(200 85 50 / ${(0.9 * done).toFixed(3)})`;
        g.fill(path);
        g.restore();
        txt(g, "blindaje", R.x + R.w / 2, oy + 28 * sc + S * 0.2, S * 0.26, c(COL.cream, done), 800, "center", display);
      }
      // Escucha, mira y lee: un ícono por cada cosa que hace la IA, con el color de su señal.
      const iconsY = oy + 28 * sc + S * 0.42;
      const step = Math.min(R.w / 3.2, S * 0.62);
      const items: [string, string, string][] = [
        [L.ears, COL.ocre, "mic"],
        [L.eyes, COL.img, "eye"],
        [L.reads, KIND.frase!, "doc"],
      ];
      items.forEach(([label, col, kind], i) => {
        const a = ease(clamp((T - 2100 - i * 220) / 500));
        if (a <= 0) return;
        const x = R.x + R.w / 2 + (i - 1) * step;
        const y = iconsY + (1 - a) * 10;
        const r = Math.max(14, S * 0.07);
        g.globalAlpha = a;
        g.beginPath();
        g.arc(x, y, r, 0, Math.PI * 2);
        g.fillStyle = "rgb(255 255 255 / 0.06)";
        g.fill();
        g.strokeStyle = c(col);
        g.lineWidth = 1.6;
        g.stroke();
        glyphIcon(g, kind, x, y, r * 0.55, c(col));
        txt(g, label, x, y + r + 14, Math.max(11, S * 0.045), c(COL.cream), 700, "center");
        g.globalAlpha = 1;
        // Escucha, Mira y Lee llevan a su escena.
        if (a >= 1) hit(x - r - 8, y - r - 6, r * 2 + 16, r * 2 + 30, () => goto([3, 6, 7][i]!));
      });
    };

    /** Íconos de trazo simple para el logo: micrófono, ojo y documento. */
    const glyphIcon = (g: G, kind: string, x: number, y: number, s: number, col: string) => {
      g.strokeStyle = col;
      g.lineWidth = Math.max(1.5, s * 0.18);
      g.lineCap = "round";
      g.lineJoin = "round";
      g.beginPath();
      if (kind === "mic") {
        g.roundRect(x - s * 0.32, y - s * 0.95, s * 0.64, s * 1.15, s * 0.32);
        g.moveTo(x - s * 0.7, y - s * 0.1);
        g.quadraticCurveTo(x - s * 0.7, y + s * 0.6, x, y + s * 0.6);
        g.quadraticCurveTo(x + s * 0.7, y + s * 0.6, x + s * 0.7, y - s * 0.1);
        g.moveTo(x, y + s * 0.6);
        g.lineTo(x, y + s * 0.95);
      } else if (kind === "eye") {
        g.moveTo(x - s, y);
        g.quadraticCurveTo(x, y - s * 0.9, x + s, y);
        g.quadraticCurveTo(x, y + s * 0.9, x - s, y);
        g.moveTo(x + s * 0.32, y);
        g.arc(x, y, s * 0.32, 0, Math.PI * 2);
      } else {
        g.moveTo(x - s * 0.6, y - s * 0.9);
        g.lineTo(x + s * 0.25, y - s * 0.9);
        g.lineTo(x + s * 0.6, y - s * 0.55);
        g.lineTo(x + s * 0.6, y + s * 0.9);
        g.lineTo(x - s * 0.6, y + s * 0.9);
        g.closePath();
        g.moveTo(x - s * 0.3, y - s * 0.15);
        g.lineTo(x + s * 0.3, y - s * 0.15);
        g.moveTo(x - s * 0.3, y + s * 0.25);
        g.lineTo(x + s * 0.3, y + s * 0.25);
      }
      g.stroke();
    };
    let probeG: G | null = null;
    const probeCtx = () => (probeG ??= document.createElement("canvas").getContext("2d")!);

    /** Un ícono simple por víctima: bodega, mototaxi y puesto de mercado. */
    const victimIcon = (g: G, k: number, x: number, y: number, r: number) => {
      g.strokeStyle = c(COL.cream);
      g.fillStyle = c(COL.cream);
      g.lineWidth = Math.max(1.5, r * 0.08);
      g.lineJoin = "round";
      const s = r * 0.55;
      g.beginPath();
      if (k === 0) {
        g.rect(x - s, y - s * 0.2, s * 2, s * 1.1);
        g.moveTo(x - s * 1.15, y - s * 0.2);
        g.lineTo(x - s * 0.9, y - s * 0.8);
        g.lineTo(x + s * 0.9, y - s * 0.8);
        g.lineTo(x + s * 1.15, y - s * 0.2);
        g.stroke();
        g.fillRect(x - s * 0.3, y + s * 0.25, s * 0.6, s * 0.65);
      } else if (k === 1) {
        g.moveTo(x - s * 1.1, y + s * 0.4);
        g.lineTo(x - s * 1.1, y - s * 0.3);
        g.quadraticCurveTo(x - s * 0.6, y - s * 0.95, x + s * 0.2, y - s * 0.9);
        g.lineTo(x + s * 0.5, y + s * 0.4);
        g.lineTo(x + s * 1.1, y + s * 0.4);
        g.stroke();
        for (const wx of [-0.75, 0.85]) {
          g.beginPath();
          g.arc(x + s * wx, y + s * 0.55, s * 0.28, 0, Math.PI * 2);
          g.stroke();
        }
      } else {
        g.moveTo(x - s * 1.1, y - s * 0.3);
        g.lineTo(x + s * 1.1, y - s * 0.3);
        g.lineTo(x + s * 0.7, y - s * 0.95);
        g.lineTo(x - s * 0.7, y - s * 0.95);
        g.closePath();
        g.stroke();
        g.beginPath();
        g.moveTo(x - s * 0.9, y - s * 0.3);
        g.lineTo(x - s * 0.9, y + s * 0.8);
        g.moveTo(x + s * 0.9, y - s * 0.3);
        g.lineTo(x + s * 0.9, y + s * 0.8);
        g.moveTo(x - s * 1.1, y + s * 0.2);
        g.lineTo(x + s * 1.1, y + s * 0.2);
        g.stroke();
      }
    };

    /**
     * Una pieza de evidencia como la ve la víctima: el audio con su onda (se pinta mientras "suena") y su
     * duración, el mensaje en dos líneas o la foto. Devuelve el alto que ocupa.
     */
    const piece = (
      g: G,
      p: Pieza,
      x: number,
      y: number,
      w: number,
      a: number,
      play: number,
      small: boolean,
      lines = 2,
    ) => {
      const fs = small ? 9 : 11.5;
      g.save();
      g.globalAlpha = a;
      let h = 0;
      if (p.tipo === "imagen") {
        h = w * 0.5;
        g.beginPath();
        g.roundRect(x, y, w, h, 8);
        g.fillStyle = "#fff";
        g.fill();
        if (photo.complete && photo.naturalWidth) {
          g.save();
          g.beginPath();
          g.roundRect(x + 3, y + 3, w - 6, h - 6, 6);
          g.clip();
          g.drawImage(photo, x + 3, y + 3, w - 6, h - 6);
          g.restore();
        }
      } else if (p.tipo === "audio") {
        h = small ? 30 : 38;
        g.beginPath();
        g.roundRect(x, y, w, h, 10);
        g.fillStyle = "#f4efe8";
        g.fill();
        const r = h * 0.32;
        g.fillStyle = "#2a1e17";
        g.beginPath();
        g.arc(x + r + 7, y + h / 2, r, 0, Math.PI * 2);
        g.fill();
        g.fillStyle = "#f4efe8";
        g.beginPath();
        g.moveTo(x + r + 4.5, y + h / 2 - r * 0.45);
        g.lineTo(x + r + 4.5 + r * 0.8, y + h / 2);
        g.lineTo(x + r + 4.5, y + h / 2 + r * 0.45);
        g.fill();
        const bars = p.onda ?? [];
        const bx = x + r * 2 + 14;
        const bwAll = w - (bx - x) - (small ? 30 : 38);
        const bw = bwAll / Math.max(1, bars.length);
        bars.forEach((v, i) => {
          const bh = Math.max(2, v * h * 0.6);
          g.fillStyle = i / bars.length < play ? "#b4462a" : "#8a7b70";
          g.fillRect(bx + i * bw, y + h / 2 - bh / 2, Math.max(1, bw * 0.62), bh);
        });
        const sec = Math.round(p.segundos ?? 0);
        txt(g, `0:${String(sec).padStart(2, "0")}`, x + w - 8, y + h / 2 + 0.5, fs - 1, "#5a4a40", 700, "right");
      } else {
        // Las líneas que de verdad ocupa el mensaje, hasta el tope.
        font(g, fs, 400);
        const need = Math.ceil(g.measureText(p.texto ?? "").width / (w - 18) + 0.15);
        lines = Math.max(1, Math.min(lines, need));
        h = lines * fs * 1.32 + 16;
        g.beginPath();
        g.roundRect(x, y, w, h, 10);
        g.fillStyle = "#f4efe8";
        g.fill();
        wrap(g, p.texto ?? "", x + 9, y + 8 + fs * 0.66, w - 18, fs, "#2a1e17", 400, 1.32, lines);
      }
      if (p.hora && !small) {
        const when = p.dia ? `${fill(L.daysAgo, { n: p.dia })}, ${p.hora}` : p.hora;
        txt(g, when, x + w, y + h + 9, fs - 2.5, c(COL.dim), 400, "right");
      }
      g.restore();
      return h + (small ? 8 : 18);
    };

    /** 2. Las víctimas: tres números distintos les mandan audios, fotos y mensajes; cada una queda sola. */
    const sceneVictims = (g: G, R: Rect, u0: number) => {
      const casos = D.casos?.casos ?? [];
      const small = R.w < 560;
      const fs = small ? 9.5 : 12;
      const gap = small ? 8 : 22;
      const colW = (R.w - gap * 2) / 3;
      const pw = colW - (small ? 4 : 16);
      const sy = R.y + 10;
      const vy = R.y + R.h - (small ? 48 : 62);
      const r = small ? 18 : 28;
      // Si la persona eligió un caso, todo ya llegó: ese celular se lee entero y los otros se atenúan.
      const sel = I.victim;
      const u = sel >= 0 ? Math.max(u0, 0.8) : u0;
      // El orden de llegada: de la más antigua a la más nueva, en los tres celulares.
      const all = casos
        .flatMap((cs, i) => cs.piezas.map((pz, j) => ({ i, j, pz })))
        .sort((a, b) => (b.pz.dia ?? 0) - (a.pz.dia ?? 0) || (a.pz.hora ?? "").localeCompare(b.pz.hora ?? ""));
      const slotT = new Map(all.map((x, k) => [`${x.i}-${x.j}`, 0.1 + k * (0.6 / all.length)]));
      let bottom = sy;
      casos.forEach((cs, i) => {
        const x = R.x + i * (colW + gap);
        const cx = x + colW / 2;
        const dim = sel >= 0 && sel !== i ? 0.3 : 1;
        const a0 = ease(seg(u, i * 0.03, 0.08 + i * 0.03));
        // El número que manda: otro número para cada víctima.
        g.globalAlpha = a0 * dim;
        pill(g, cs.contacto, cx, sy, COL.dim, small ? 8.5 : 11.5);
        txt(g, L.otherNumber, cx, sy + (small ? 16 : 22), small ? 8.5 : 11, c(COL.dim), 400, "center");
        g.globalAlpha = 1;
        // Las piezas, una debajo de otra, en el orden en que llegaron (las que faltan guardan su lugar).
        const top = sy + (small ? 30 : 42);
        let y = top;
        cs.piezas.forEach((pz, j) => {
          const t0 = slotT.get(`${i}-${j}`) ?? 0.1;
          const f = seg(u, t0, t0 + 0.08);
          const e = ease(f);
          let play = pz.tipo === "audio" ? seg(u, t0 + 0.08, t0 + 0.3) : 0;
          if (pz.tipo === "audio" && sel === i) {
            const h = heard(`/casos/${cs.caso.toLowerCase()}1.m4a`);
            if (h >= 0) play = h;
          }
          const dy = f > 0 ? (1 - e) * -26 : 0;
          y += piece(g, pz, x + (colW - pw) / 2, y + dy, pw, e * dim, play, small, sel === i ? 5 : 2);
        });
        bottom = Math.max(bottom, y);
        if (sel === i) {
          g.strokeStyle = c(COL.ocre, 0.9);
          g.lineWidth = 1.5;
          g.beginPath();
          g.roundRect(x + (colW - pw) / 2 - 6, top - 8, pw + 12, y - top + (small ? 0 : -6), 12);
          g.stroke();
        }
        // La víctima.
        const iso = seg(u, 0.78, 0.92);
        g.globalAlpha = dim;
        g.beginPath();
        g.arc(cx, vy, r, 0, Math.PI * 2);
        g.fillStyle = c("255 255 255", 0.08 * a0);
        g.fill();
        g.strokeStyle = c(sel === i ? COL.ocre : COL.alert, 0.4 + 0.6 * iso);
        g.lineWidth = 1.5 + iso;
        g.stroke();
        if (iso > 0 && iso < 1) {
          g.beginPath();
          g.arc(cx, vy, r + iso * 22, 0, Math.PI * 2);
          g.strokeStyle = c(COL.alert, 0.7 * (1 - iso));
          g.stroke();
        }
        g.globalAlpha = a0 * dim;
        victimIcon(g, i, cx, vy, r);
        txt(g, fill(L.caseLabel, { k: cs.caso }), cx, vy + r + (small ? 12 : 16), fs, c(COL.cream), 700, "center");
        txt(g, `${L.sectors[i]}, ${L.zones[i]}`, cx, vy + r + (small ? 25 : 33), fs - 1.5, c(COL.dim), 400, "center");
        g.globalAlpha = 1;
        // Para cada una, un caso aislado.
        if (iso > 0) {
          g.globalAlpha = iso * dim;
          pill(g, L.oneReport, cx, vy - r - (small ? 12 : 16), COL.alert, small ? 8.5 : 11, true);
          g.globalAlpha = 1;
        }
        // Tocar un celular reproduce su audio (lo mismo que su botón).
        hit(x, sy - 14, colW, vy + r + 40 - sy, () => press(`[data-victim="${i}"]`));
      });
      // Lo que dice el audio del caso elegido, como subtítulos que avanzan mientras suena.
      const cs = casos[sel];
      const audio = cs?.piezas.find((x) => x.tipo === "audio");
      if (cs && audio?.texto) {
        const tfs = small ? 10.5 : 16;
        const y0 = bottom + (small ? 2 : 10);
        const y1 = vy - r - (small ? 24 : 34);
        const max = Math.floor((y1 - y0 - tfs * 1.8) / (tfs * 1.38));
        if (max >= 1) {
          const h = heard(`/casos/${cs.caso.toLowerCase()}1.m4a`);
          const p = h < 0 ? 1 : h;
          const words = audio.texto.split(" ");
          const said = `«${words.slice(0, Math.ceil(words.length * p)).join(" ")}${p >= 1 ? "»" : ""}`;
          font(g, tfs, 400);
          const lines: string[] = [];
          let cur = "";
          for (const w of said.split(" ")) {
            const next = cur ? `${cur} ${w}` : w;
            if (g.measureText(next).width > R.w && cur) {
              lines.push(cur);
              cur = w;
            } else cur = next;
          }
          if (cur) lines.push(cur);
          txt(g, `${fill(L.caseLabel, { k: cs.caso })}, ${L.says}`, R.x, y0 + tfs * 0.6, tfs - 1.5, c(COL.ocre), 700);
          lines.slice(-max).forEach((l, k) => txt(g, l, R.x, y0 + tfs * 2.1 + k * tfs * 1.38, tfs, c(COL.cream), 400));
        }
      }
    };

    /** La línea que marca por dónde va el audio que suena. */
    const playhead = (g: G, x: number, y: number, h: number) => {
      g.fillStyle = c(COL.cream, 0.95);
      g.fillRect(x - 1, y - 4, 2, h + 8);
      g.beginPath();
      g.arc(x, y - 4, 4, 0, Math.PI * 2);
      g.fill();
    };

    /** La huella (12 x 16) en un rectángulo, con las casillas que ya llegaron. */
    const drawPrint = (g: G, x: number, y: number, cell: number, v: Float32Array, scale: number, shown = 192) => {
      for (let k = 0; k < 192; k++) {
        const cx = x + (k % 16) * cell;
        const cy = y + Math.floor(k / 16) * cell;
        g.fillStyle = k < shown ? rgb(cellColor(v[k]!, scale)) : "rgb(255 255 255 / 0.06)";
        g.fillRect(cx + 0.5, cy + 0.5, cell - 1, cell - 1);
      }
    };

    /** 3. Escucha: la onda, el espectrograma y los 192 números. */
    const sceneListen = (g: G, R: Rect, u: number) => {
      const casoB = D.casos?.casos[1];
      const audio = casoB?.piezas.find((x) => x.tipo === "audio");
      const small = R.w < 520;
      const wide = R.w > 560;
      const left = { x: R.x, y: R.y, w: wide ? R.w * 0.56 : R.w, h: wide ? R.h : R.h * 0.62 };
      const fs = small ? 10.5 : 12.5;
      // La onda.
      const wy = left.y + left.h * 0.1;
      txt(g, L.audio, left.x, wy - 16, fs, c(COL.dim), 700);
      const bars = audio?.onda ?? [];
      const bw = left.w / Math.max(1, bars.length);
      const grow = ease(seg(u, 0, 0.18));
      const play = seg(u, 0.05, 0.3);
      bars.forEach((v, i) => {
        const bh = Math.max(2, v * left.h * 0.13 * grow);
        g.fillStyle = i / bars.length < play ? c(COL.ocre) : c(COL.dim, 0.6);
        g.fillRect(left.x + i * bw + bw * 0.2, wy + 22 - bh / 2, bw * 0.6, bh);
      });
      // La transcripción, letra por letra.
      if (audio?.texto) {
        const t = audio.texto.slice(0, Math.round(audio.texto.length * seg(u, 0.08, 0.35)));
        txt(g, L.transcript, left.x, wy + 54, fs - 1, c(COL.frase), 700);
        wrap(g, t ? `«${t}»` : "", left.x, wy + 72, left.w, fs, c(COL.cream), 400, 1.3, wide ? 6 : 2);
      }
      // El espectrograma.
      const sp = wide
        ? { x: left.x, y: left.y + left.h * 0.44, w: left.w, h: left.h * 0.5 }
        : { x: left.x, y: wy + 112, w: left.w, h: left.h - (wy + 112 - left.y) };
      if (spec) {
        // Si suena el audio, el espectrograma se ve entero y una línea marca por dónde va.
        const ph = heard("/voz/b1-limpia.m4a");
        const rev = Math.max(seg(u, 0.25, 0.48), ph >= 0 ? 1 : 0);
        txt(g, L.spectrogram, sp.x, sp.y - 12, fs, c(COL.dim, rev > 0 ? 1 : 0), 700);
        g.save();
        g.beginPath();
        g.rect(sp.x, sp.y, sp.w * rev, sp.h);
        g.clip();
        g.imageSmoothingEnabled = false;
        g.drawImage(spec.limpia, sp.x, sp.y, sp.w, sp.h);
        g.restore();
        if (ph > 0 && ph < 1) playhead(g, sp.x + sp.w * ph, sp.y, sp.h);
      }
      // La huella: cada número llega desde la nota.
      if (fp) {
        const cell = wide ? Math.min(14, (R.w - left.w - 30) / 16) : Math.min(11, R.w / 22);
        const px = wide ? R.x + R.w - cell * 16 : R.x + (R.w - cell * 16) / 2;
        const py = wide ? R.y + R.h * 0.4 : R.y + R.h * 0.68;
        const arrive = seg(u, 0.45, 0.78);
        const shown = Math.round(arrive * 192);
        txt(g, L.print, px, py - 14, fs, c(COL.dim, arrive > 0 ? 1 : 0), 700);
        drawPrint(g, px, py, cell, fp.b, fp.scale, shown);
        if (arrive > 0 && arrive < 1) {
          for (let k = Math.max(0, shown - 30); k < Math.min(192, shown + 14); k++) {
            const life = arrive * 192 - k;
            if (life < -12 || life > 1) continue;
            const f = clamp((life + 12) / 13);
            const x0 = sp.x + rnd(k * 7) * sp.w;
            const y0 = sp.y + rnd(k * 3) * sp.h;
            const x1 = px + (k % 16) * cell + cell / 2;
            const y1 = py + Math.floor(k / 16) * cell + cell / 2;
            g.fillStyle = c(COL.cream, 0.9);
            g.fillRect(lerp(x0, x1, inout(f)) - 2, lerp(y0, y1, inout(f)) - 2 - Math.sin(f * Math.PI) * 30, 4, 4);
          }
        }
      }
    };

    /** El parecido: número grande, barra y umbral de revisión (0.60). */
    const gauge = (g: G, x: number, y: number, w: number, cos: number, fs: number, good: boolean) => {
      txt(g, L.similarity, x, y, fs, c(COL.dim), 700);
      txt(g, fmt(cos), x, y + fs * 2.2, fs * 2.6, good ? c(COL.ocre) : c(COL.cream), 800, "left", display);
      const by = y + fs * 4.3;
      g.fillStyle = c("255 255 255", 0.12);
      g.fillRect(x, by, w, 8);
      g.fillStyle = good ? c(COL.ocre) : c(COL.cream, 0.85);
      g.fillRect(x, by, Math.max(0, cos) * w, 8);
      g.fillStyle = "#fff";
      g.fillRect(x + 0.6 * w - 1, by - 5, 2, 18);
      txt(g, `${L.threshold} 0.60`, x + 0.6 * w, by + 24, fs - 1.5, c(COL.dim), 400, "center");
    };

    /** 4. Desdistorsiona: la voz disfrazada y el barrido de tono hasta que vuelve a parecerse. */
    const PATH_K = [0, -1, -2, -3, -4, -5, -6, -7, -8, -7, -6, -5];
    const sceneUndo = (g: G, R: Rect, u: number) => {
      if (!spec || !fp || !D.voz) return;
      const small = R.w < 520;
      const fs = small ? 10.5 : 12.5;
      const wide = R.w > 560;
      const sp = {
        x: R.x,
        y: R.y + 22,
        w: wide ? R.w * 0.55 : R.w,
        h: wide ? R.h * 0.62 : Math.min(R.h * 0.45, R.h - 178),
      };
      // Qué tono mira ahora: el que eligió la persona con el deslizador o, si no tocó nada, el del scroll.
      const user = I.undo !== null;
      let kf: number;
      let k: number;
      if (user) {
        k = I.undo!;
        kf = smooth("undo", k);
      } else {
        const q = seg(u, 0.18, 0.82) * (PATH_K.length - 1);
        const i0 = Math.floor(q);
        kf = lerp(PATH_K[i0]!, PATH_K[Math.min(PATH_K.length - 1, i0 + 1)]!, inout(q - i0));
        k = Math.round(kf);
        sm.undo = kf;
        if (main) auto.undo = k;
      }
      const cur = fp.sweep.find((s) => s.k === k) ?? fp.sweep.find((s) => s.k === 0)!;
      const best = fp.sweep.reduce((a, b) => (b.cos > a.cos ? b : a)).k;
      const fin = user || seg(u, 0.82, 0.9) > 0;
      const e = D.voz.espectro;
      const rowH = sp.h / e.filas;
      g.save();
      g.beginPath();
      g.rect(sp.x, sp.y, sp.w, sp.h);
      g.clip();
      g.fillStyle = rgb(RAMP[0]!);
      g.fillRect(sp.x, sp.y, sp.w, sp.h);
      g.imageSmoothingEnabled = false;
      g.globalAlpha = user ? 1 : ease(seg(u, 0, 0.1));
      g.drawImage(spec.disfrazada, sp.x, sp.y - kf * e.por_semitono * rowH, sp.w, sp.h);
      g.restore();
      // Si suena la voz disfrazada o la revertida, una línea marca por dónde va.
      const ph = Math.max(heard("/voz/b1-disfrazada.m4a"), heard("/voz/b1-revertida.m4a"));
      if (ph > 0 && ph < 1) playhead(g, sp.x + sp.w * ph, sp.y, sp.h);
      const lab = k === 0 ? `${L.voiceB}, ${L.disguised}` : `${L.voiceB}, ${fill(L.reverted, { k: signed(k) })}`;
      txt(g, lab, sp.x, sp.y - 12, fs, c(COL.dim), 700);
      // La escala de semitonos.
      const dy = sp.y + sp.h + 22;
      for (let s = -8; s <= 8; s++) {
        const x = sp.x + ((s + 8) / 16) * sp.w;
        g.fillStyle = s === k ? c(COL.ocre) : c("255 255 255", s === 0 ? 0.6 : 0.3);
        g.fillRect(x - 1, dy - (s % 4 === 0 ? 6 : 3), 2, s % 4 === 0 ? 12 : 6);
        if (s % 4 === 0) txt(g, signed(s), x, dy + 16, fs - 2, c(COL.dim), 400, "center");
      }
      const mx = sp.x + ((kf + 8) / 16) * sp.w;
      g.fillStyle = c(COL.ocre);
      g.beginPath();
      g.moveTo(mx, dy - 9);
      g.lineTo(mx - 6, dy - 18);
      g.lineTo(mx + 6, dy - 18);
      g.fill();
      txt(g, L.semitones, sp.x + sp.w / 2, dy + 32, fs - 2, c(COL.dim), 400, "center");
      // Las dos huellas y el parecido (en el celular, las huellas a la izquierda y el parecido al lado).
      const cell = wide ? Math.min(11, (R.w - sp.w - 40) / 16) : Math.min(6.5, (R.w * 0.62 - 12) / 32);
      const gx = wide ? R.x + R.w - cell * 16 : R.x;
      const gy = wide ? R.y + 22 : dy + 54;
      txt(g, L.voiceA, gx, gy - 12, fs - 1, c(COL.dim), 700);
      drawPrint(g, gx, gy, cell, fp.a, fp.scale);
      const g2x = wide ? gx : gx + cell * 16 + 12;
      const g2y = wide ? gy + cell * 12 + 30 : gy;
      txt(g, L.voiceB, g2x, g2y - 12, fs - 1, c(COL.dim), 700);
      drawPrint(g, g2x, g2y, cell, cur.v, fp.scale);
      if (wide) gauge(g, gx, g2y + cell * 12 + 26, cell * 16, cur.cos, fs, fin && k === best);
      else {
        const x3 = g2x + cell * 16 + 18;
        gauge(g, x3, gy - 12, R.x + R.w - x3, cur.cos, fs, fin && k === best);
      }
    };

    /** 5. Compara: el radar de voces alrededor de la voz de B. */
    const sceneRadar = (g: G, R: Rect, u0: number) => {
      const r = D.pitch?.radar;
      if (!r) return;
      // El umbral lo puede mover la persona: las voces que lo pasan se encienden y las demás se apagan.
      const user = I.thr !== null;
      const u = user ? Math.max(u0, 0.8) : u0;
      const thr = I.thr ?? 0.6;
      const tS = smooth("thr", thr);
      const small = R.w < 520;
      const fs = small ? 10 : 12;
      const cx = R.x + R.w / 2;
      const cy = R.y + R.h / 2;
      const Rr = Math.min(R.w, R.h) * 0.46;
      const dist = (cos: number) => Math.min(1, Math.max(0, 1 - cos)) * Rr;
      const a0 = ease(seg(u, 0, 0.12));
      for (const v of [0.25, 0.5, 0.75]) {
        g.setLineDash([3, 5]);
        g.strokeStyle = c("255 255 255", 0.16 * a0);
        g.lineWidth = 1;
        g.beginPath();
        g.arc(cx, cy, dist(v), 0, Math.PI * 2);
        g.stroke();
      }
      if (user) {
        g.fillStyle = c(COL.ocre, 0.07);
        g.beginPath();
        g.arc(cx, cy, dist(tS), 0, Math.PI * 2);
        g.fill();
      }
      g.setLineDash([6, 4]);
      g.strokeStyle = c(COL.ocre, (user ? 0.9 : 0.55) * a0);
      g.lineWidth = user ? 1.6 : 1;
      g.beginPath();
      g.arc(cx, cy, dist(tS), 0, Math.PI * 2);
      g.stroke();
      g.setLineDash([]);
      g.lineWidth = 1;
      txt(g, `${L.threshold} ${fmt(thr)}`, cx, cy - dist(tS) - 10, fs - 1, c(COL.ocre, a0), 700, "center");
      // Las voces: entran desde afuera hasta su distancia.
      const pts = [
        ...r.slr73.map((cos, i) => ({ cos, ang: i * 2.39996 + 0.4, col: COL.dim, s: 3, lab: "" })),
        { cos: r.victima_a, ang: 3.6, col: COL.dim, s: 4, lab: `${L.victim} ${fmt(r.victima_a)}` },
        { cos: r.caso_c, ang: 2.5, col: COL.frase, s: 6, lab: `${L.caseC} ${fmt(r.caso_c)}` },
        { cos: r.caso_a, ang: -0.9, col: COL.ocre, s: 8, lab: `${L.caseA} ${fmt(r.caso_a)}` },
      ];
      pts.forEach((p, i) => {
        const f = ease(seg(u, 0.08 + (i / pts.length) * 0.4, 0.2 + (i / pts.length) * 0.4 + 0.12));
        if (f <= 0) return;
        const d = lerp(Rr * 1.5, dist(p.cos), f);
        const x = cx + Math.cos(p.ang) * d;
        const y = cy + Math.sin(p.ang) * d;
        const pass = p.cos >= tS;
        g.fillStyle = c(p.col, Math.min(1, f * 1.5) * (user && !pass ? 0.3 : 1));
        g.beginPath();
        g.arc(x, y, p.s * (small ? 0.8 : 1), 0, Math.PI * 2);
        g.fill();
        if (user && pass) {
          g.strokeStyle = c(COL.ocre);
          g.lineWidth = 1.5;
          g.beginPath();
          g.arc(x, y, p.s * (small ? 0.8 : 1) + 4, 0, Math.PI * 2);
          g.stroke();
        }
        if (p.lab && f >= 1) {
          const la = seg(u, 0.62, 0.75);
          if (p.cos === r.caso_a) {
            g.strokeStyle = c(COL.ocre, la);
            g.lineWidth = 2;
            g.beginPath();
            g.moveTo(cx, cy);
            g.lineTo(lerp(cx, x, la), lerp(cy, y, la));
            g.stroke();
          }
          g.globalAlpha = la;
          pill(g, p.lab, x, y + (p.cos === r.caso_a ? -22 : 20), p.col, fs);
          g.globalAlpha = 1;
        }
      });
      // Las 28 voces de SLR73, rotuladas una vez.
      const sl = seg(u, 0.62, 0.75);
      if (sl > 0) {
        g.globalAlpha = sl;
        txt(g, L.slr, cx - Rr * 0.95, cy + Rr * 0.98, fs, c(COL.dim), 700, "left");
        g.globalAlpha = 1;
      }
      // El centro: la voz de B.
      g.fillStyle = c(COL.cream, a0);
      g.beginPath();
      g.arc(cx, cy, small ? 7 : 9, 0, Math.PI * 2);
      g.fill();
      txt(g, L.center, cx, cy + (small ? 20 : 24), fs, c(COL.cream, a0), 700, "center");
    };

    /** 6. Mira: las cajas de SAM sobre la foto y los parches de DINOv2. */
    const BOXES = [
      { x: 0.295, y: 0.632, w: 0.091, h: 0.103, lab: "bullet" },
      { x: 0.406, y: 0.53, w: 0.355, h: 0.381, lab: "note" },
    ];
    const sceneLook = (g: G, R: Rect, u0: number) => {
      const small = R.w < 520;
      // La persona elige qué par de fotos comparar; entonces todo se ve completo y las líneas vuelven a tenderse.
      const sel = I.look ?? 0;
      const touched = I.touched.has(6);
      const u = touched ? 1 : u0;
      const fs = small ? 10 : 12;
      const pw = Math.min(R.w, R.h * 0.46 * (1000 / 506));
      const ph = pw * (506 / 1000);
      const px = R.x + (R.w - pw) / 2;
      const py = R.y;
      const a0 = ease(seg(u, 0, 0.12));
      if (photo.complete && photo.naturalWidth) {
        g.save();
        g.globalAlpha = a0;
        g.beginPath();
        g.roundRect(px, py, pw, ph, 8);
        g.clip();
        g.drawImage(photo, px, py, pw, ph);
        g.restore();
      }
      const scan = seg(u, 0.08, 0.24);
      if (scan > 0 && scan < 1) {
        g.fillStyle = c(COL.cream, 0.85);
        g.fillRect(px + scan * pw, py, 2, ph);
      }
      BOXES.forEach((b, i) => {
        const f = seg(u, 0.22 + i * 0.1, 0.36 + i * 0.1);
        if (f <= 0) return;
        const x = px + b.x * pw;
        const y = py + b.y * ph;
        const w = b.w * pw;
        const h = b.h * ph;
        g.strokeStyle = c(COL.img);
        g.lineWidth = 2.5;
        g.setLineDash([2 * (w + h) * f, 9999]);
        g.strokeRect(x, y, w, h);
        g.setLineDash([]);
        if (f >= 1)
          pill(g, b.lab === "bullet" ? L.bullet : L.note, x + w / 2, i === 0 ? y + h + 14 : y - 14, COL.img, fs, true);
      });
      // Dos fotos del mismo cuarto, parche por parche.
      const fo = D.fotos;
      if (!fo) return;
      const par = fo.pares[sel]!;
      const C = fo.grid.cols;
      const Rw = fo.grid.rows;
      const gap = R.w * 0.08;
      const mw = Math.min((R.w - gap) / 2, ((R.h - ph - (small ? 60 : 150)) * C) / Rw);
      const mh = (mw * Rw) / C;
      const my = py + ph + 46;
      const mx = [R.x + (R.w - mw * 2 - gap) / 2, R.x + (R.w - mw * 2 - gap) / 2 + mw + gap];
      const cw = mw / C;
      const ch = mh / Rw;
      [par.a, par.b].forEach((id, s) => {
        const hex = fo.pix[id] ?? "";
        for (let k = 0; k < C * Rw; k++) {
          const f = seg(u, 0.45 + rnd(k + s * 997) * 0.12, 0.5 + rnd(k + s * 997) * 0.12);
          if (f <= 0) continue;
          g.fillStyle = `rgb(${parseInt(hex.slice(k * 6, k * 6 + 2), 16)} ${parseInt(hex.slice(k * 6 + 2, k * 6 + 4), 16)} ${parseInt(hex.slice(k * 6 + 4, k * 6 + 6), 16)} / ${f.toFixed(3)})`;
          g.fillRect(mx[s]! + (k % C) * cw + 0.5, my + Math.floor(k / C) * ch + 0.5, cw - 1, ch - 1);
        }
      });
      const names = [L.sameRoom, L.otherRoom, L.resent];
      if (u >= 0.45) txt(g, names[sel] ?? "", mx[0]!, my - 12, fs - 0.5, c(COL.cream), 700);
      const lt = touched && !reduce ? clamp((performance.now() - I.t) / 900) : 1;
      if (lt < 1) moving = true;
      par.lineas.forEach(([i, j], li) => {
        const at = li / par.lineas.length;
        const f = touched ? ease(seg(lt, at * 0.5, at * 0.5 + 0.5)) : ease(seg(u, 0.62 + at * 0.18, 0.66 + at * 0.18));
        if (f <= 0) return;
        const x0 = mx[0]! + ((i! % C) + 0.5) * cw;
        const y0 = my + (Math.floor(i! / C) + 0.5) * ch;
        const x1 = mx[1]! + ((j! % C) + 0.5) * cw;
        const y1 = my + (Math.floor(j! / C) + 0.5) * ch;
        g.strokeStyle = c(COL.ocre, 0.75);
        g.lineWidth = 1.3;
        g.beginPath();
        g.moveTo(x0, y0);
        g.lineTo(lerp(x0, x1, f), lerp(y0, y1, f));
        g.stroke();
      });
      // Cuántos parches encuentran pareja en cada par de fotos (de 384): el mismo cuarto, otro cuarto
      // con los mismos objetos y la misma foto reenviada.
      const cmp = seg(u, 0.78, 0.92);
      if (cmp > 0) {
        const rows: [string, number, string][] = [
          [L.sameRoom, fo.pares[0]!.con_pareja, COL.ocre],
          [L.otherRoom, fo.pares[1]!.con_pareja, COL.dim],
          [L.resent, fo.pares[2]!.con_pareja, COL.cream],
        ];
        const by = my + mh + (small ? 18 : 26);
        const lw = small ? R.w * 0.42 : R.w * 0.34;
        const bw = R.w - lw - (small ? 120 : 190);
        rows.forEach(([name, n, col], i) => {
          const a = ease(seg(cmp, i * 0.2, i * 0.2 + 0.6));
          if (a <= 0) return;
          const y = by + i * (small ? 18 : 24);
          const on = !touched || i === sel;
          g.globalAlpha = a * (on ? 1 : 0.45);
          if (touched && i === sel) {
            g.fillStyle = c(COL.ocre);
            g.beginPath();
            g.arc(R.x - 9, y, 3.5, 0, Math.PI * 2);
            g.fill();
          }
          txt(g, name, R.x, y, fs - 1, c(COL.cream), 700);
          hit(R.x - 14, y - (small ? 9 : 12), R.w + 14, small ? 18 : 24, () => press(`[data-look="${i}"]`));
          g.fillStyle = c(col, 0.85);
          g.fillRect(R.x + lw, y - 5, bw * (n / 384) * a, 10);
          txt(g, fill(L.patches, { n }), R.x + lw + bw * (n / 384) * a + 8, y + 0.5, fs - 1.5, c(COL.dim), 400);
          g.globalAlpha = 1;
        });
      }
    };

    /** Colores de cada tipo de dato que lee Muse Spark. */
    const KIND: Record<string, string> = {
      monto: "231 173 69",
      plazo: "141 187 230",
      cuenta: "111 207 142",
      grupo: "236 159 208",
      frase: "190 165 255",
    };

    /** Texto en líneas que recuerda dónde quedó cada palabra (para marcar trozos y saber qué ya se leyó). */
    const layout = (g: G, s: string, maxW: number, size: number, maxLines = 99) => {
      font(g, size, 400);
      const space = g.measureText(" ").width;
      const words: { w: string; a: number; b: number; x: number; line: number; width: number }[] = [];
      let x = 0;
      let line = 0;
      let i = 0;
      for (const w of s.split(" ")) {
        const width = g.measureText(w).width;
        if (x > 0 && x + width > maxW) {
          line++;
          x = 0;
        }
        if (line >= maxLines) break;
        words.push({ w, a: i, b: i + w.length, x, line, width });
        x += width + space;
        i += w.length + 1;
      }
      return { words, lines: Math.min(maxLines, line + 1) };
    };

    /** 7. Lee: Muse Spark lee la evidencia del caso A y cada dato vuela a su fila de la ficha. */
    const sceneRead = (g: G, R: Rect, u0: number) => {
      const lee = D.pitch?.lee;
      const casos = D.pitch?.casos;
      if (!lee || !casos) return;
      // Si la persona elige un dato, la lectura ya terminó: se marca de dónde sale y a qué fila va.
      const sel = I.field;
      const u = sel ? Math.max(u0, 0.66) : u0;
      const f = casos.A!;
      const small = R.w < 560;
      const fs = small ? 10.5 : 12.5;
      const lh = fs * 1.42;
      const colW = small ? R.w : R.w * 0.56;
      const fichaX = small ? R.x : R.x + colW + R.w * 0.05;
      const fichaW = small ? R.w : R.w - colW - R.w * 0.05;
      // La evidencia: cada pieza con su etiqueta y su texto; lo leído se enciende.
      g.globalAlpha = ease(seg(u, 0, 0.06));
      txt(g, L.evidence, R.x, R.y + 6, fs + 1, c(COL.cream), 700);
      g.globalAlpha = 1;
      let y = R.y + 26;
      const total = lee.piezas.reduce((n, p) => n + p.texto.length, 0);
      const read = seg(u, 0.04, 0.55) * total;
      let offset = 0;
      const flying: { x: number; y: number; kind: string; t: number; text: string }[] = [];
      for (const pz of lee.piezas) {
        const lay = layout(g, pz.texto, colW - 20, fs, small ? 3 : 6);
        const h = lay.lines * lh + 30;
        if (y + h > R.y + (small ? R.h * 0.5 : R.h * 0.86)) break;
        g.fillStyle = "rgb(255 255 255 / 0.05)";
        g.beginPath();
        g.roundRect(R.x, y, colW, h, 8);
        g.fill();
        txt(
          g,
          `${pz.label}, ${pz.tipo === "audio" ? L.voiceNote : L.message}`,
          R.x + 10,
          y + 12,
          fs - 2,
          c(COL.dim),
          700,
        );
        for (const m of pz.marcas) {
          const ws = lay.words.filter((w) => w.b > m.a && w.a < m.b);
          if (!ws.length) continue;
          const seen = read >= offset + m.b;
          if (!seen) continue;
          const mine = sel === m.kind;
          for (const w of ws) {
            g.fillStyle = c(KIND[m.kind] ?? COL.dim, sel ? (mine ? 0.62 : 0.08) : 0.28);
            g.fillRect(R.x + 10 + w.x - 2, y + 22 + w.line * lh, w.width + 4, lh - 2);
            if (mine) {
              g.strokeStyle = c(KIND[m.kind]!);
              g.lineWidth = 1.2;
              g.strokeRect(R.x + 10 + w.x - 2.5, y + 22 + w.line * lh - 0.5, w.width + 5, lh - 1);
            }
          }
          const w0 = ws[0]!;
          flying.push({
            x: R.x + 10 + w0.x,
            y: y + 22 + w0.line * lh + lh / 2,
            kind: m.kind,
            t: (offset + m.b) / total,
            text: pz.texto.slice(m.a, m.b),
          });
        }
        for (const w of lay.words) {
          const on = read >= offset + w.b;
          txt(g, w.w, R.x + 10 + w.x, y + 22 + w.line * lh + lh / 2, fs, on ? c(COL.cream) : c(COL.dim, 0.45));
        }
        offset += pz.texto.length;
        y += h + 10;
      }
      // La cabeza de lectura de Muse Spark.
      const rd = seg(u, 0.04, 0.55);
      if (rd > 0 && rd < 1) pill(g, "Muse Spark 1.3", R.x + colW * rd, R.y + 6, COL.frase, fs - 2);
      // La ficha.
      const fy = small ? R.y + R.h * 0.53 : R.y + 26;
      const rows: [string, string, string | null][] = [
        [L.fields.threat, f.tipo_amenaza ? (L.threats[f.tipo_amenaza] ?? f.tipo_amenaza) : "", null],
        [
          L.fields.amount,
          f.monto_soles
            ? `S/ ${f.monto_soles.toLocaleString("en-US")} ${f.periodicidad ? (L.periods[f.periodicidad] ?? "") : ""}`
            : "",
          "monto",
        ],
        [L.fields.deadline, f.plazo ?? "", "plazo"],
        [L.fields.channel, f.canal_pago === "yape" ? "Yape" : (f.canal_pago ?? ""), null],
        [L.fields.payment, f.identificadores.find((i) => i.rol === "cobro")?.valor ?? "", "cuenta"],
        [L.fields.contact, f.identificadores.find((i) => i.rol === "contacto")?.valor ?? "", null],
        [L.fields.group, f.grupo ?? "", "grupo"],
        [
          L.fields.phrases,
          f.frases
            .slice(0, small ? 1 : 3)
            .map((x) => `«${x}»`)
            .join("  "),
          "frase",
        ],
        [L.fields.sources, f.fuentes.join(", "), null],
      ];
      const rowH = small ? (R.y + R.h - fy - 34) / rows.length : Math.min(46, (R.h - 70) / rows.length);
      const appear = ease(seg(u, 0.02, 0.1));
      g.globalAlpha = appear;
      g.fillStyle = "rgb(255 255 255 / 0.06)";
      g.beginPath();
      g.roundRect(fichaX, fy - 4, fichaW, rows.length * rowH + 36, 10);
      g.fill();
      g.strokeStyle = c(COL.frase, 0.5);
      g.lineWidth = 1;
      g.stroke();
      txt(g, L.ficha, fichaX + 12, fy + 10, fs, c(COL.frase), 700);
      if (!small) txt(g, L.strict, fichaX + 12, fy + 26, fs - 2.5, c(COL.dim), 400);
      g.globalAlpha = 1;
      rows.forEach(([k, v, kind], i) => {
        const ry = fy + 34 + i * rowH + (small ? 0 : 8);
        if (sel && kind === sel) {
          g.fillStyle = c(KIND[kind]!, 0.16);
          g.beginPath();
          g.roundRect(fichaX + 4, ry - rowH / 2 + 1, fichaW - 8, rowH - 2, 6);
          g.fill();
        }
        if (kind) hit(fichaX, ry - rowH / 2, fichaW, rowH, () => press(`[data-field="${kind}"]`));
        // Cada fila se llena cuando llega su dato (o al final de la lectura, si no tiene marca).
        const arrive = kind ? flying.filter((x) => x.kind === kind).map((x) => x.t)[0] : undefined;
        const t0 = arrive !== undefined ? 0.04 + arrive * 0.51 + 0.06 : 0.58 + i * 0.015;
        const a = ease(seg(u, t0, t0 + 0.05));
        txt(g, k, fichaX + 12, ry, fs - 2, c(COL.dim, Math.max(0.5, a)), 400);
        if (a > 0) {
          g.globalAlpha = a;
          const vx = fichaX + (small ? 90 : 108);
          wrap(g, v, vx, ry, fichaW - (vx - fichaX) - 10, fs - 0.5, kind ? c(KIND[kind]!) : c(COL.cream), 700, 1.25, 2);
          g.globalAlpha = 1;
        }
      });
      // El dato elegido, unido con una línea a su fila.
      const fl0 = sel ? flying.find((x) => x.kind === sel) : undefined;
      const ri = sel ? rows.findIndex((r) => r[2] === sel) : -1;
      if (fl0 && ri >= 0) {
        const tx = fichaX + 6;
        const ty = fy + 34 + ri * rowH + (small ? 0 : 8);
        g.strokeStyle = c(KIND[sel!]!, 0.9);
        g.lineWidth = 1.5;
        g.setLineDash([4, 3]);
        g.beginPath();
        g.moveTo(fl0.x, fl0.y);
        if (small) g.bezierCurveTo(fl0.x, (fl0.y + ty) / 2, tx - 30, ty, tx, ty);
        else g.bezierCurveTo((fl0.x + tx) / 2, fl0.y, (fl0.x + tx) / 2, ty, tx, ty);
        g.stroke();
        g.setLineDash([]);
        g.fillStyle = c(KIND[sel!]!);
        g.beginPath();
        g.arc(tx, ty, 3.5, 0, Math.PI * 2);
        g.fill();
      }
      // Los datos vuelan del texto a su fila.
      for (const fl of flying) {
        const i = rows.findIndex((r) => r[2] === fl.kind);
        if (i < 0) continue;
        const t0 = 0.04 + fl.t * 0.51;
        const k = seg(u, t0, t0 + 0.07);
        if (k <= 0 || k >= 1) continue;
        const tx = fichaX + (small ? 90 : 108);
        const ty = fy + 34 + i * rowH + (small ? 0 : 8);
        const e = inout(k);
        g.globalAlpha = 1 - k * 0.3;
        pill(
          g,
          fl.text.length > 22 ? `${fl.text.slice(0, 20)}…` : fl.text,
          lerp(fl.x, tx, e) + 30,
          lerp(fl.y, ty, e) - Math.sin(e * Math.PI) * 30,
          KIND[fl.kind]!,
          fs - 2,
          true,
        );
        g.globalAlpha = 1;
      }
      // Y la ficha de cada caso: siete tarjetas chicas.
      const cards = seg(u, 0.72, 0.9);
      if (cards > 0 && !small) {
        const ids = Object.keys(casos);
        const cw = (R.w - (ids.length - 1) * 8) / ids.length;
        const cy = R.y + R.h - 58;
        txt(g, L.otherFichas, R.x, cy - 16, fs - 1, c(COL.dim), 700);
        ids.forEach((id, i) => {
          const a = ease(seg(cards, (i / ids.length) * 0.6, (i / ids.length) * 0.6 + 0.4));
          if (a <= 0) return;
          const cf = casos[id]!;
          const cx = R.x + i * (cw + 8);
          g.globalAlpha = a;
          g.fillStyle = "#f4efe8";
          g.beginPath();
          g.roundRect(cx, cy, cw, 52, 8);
          g.fill();
          txt(g, id, cx + 8, cy + 14, fs + 1, "#2a1e17", 800, "left", display);
          txt(
            g,
            cf.monto_soles ? `S/ ${cf.monto_soles.toLocaleString("en-US")}` : "",
            cx + 24,
            cy + 14,
            fs - 2,
            "#2a1e17",
            700,
          );
          const cobro = cf.identificadores.find((x) => x.rol === "cobro")?.valor ?? "";
          txt(
            g,
            cobro ? `…${cobro.slice(-3)}` : "",
            cx + 8,
            cy + 36,
            fs - 1.5,
            cobro.endsWith("202") ? "#1e6b40" : "#5a4a40",
            800,
          );
          g.globalAlpha = 1;
        });
      }
    };

    /** Un texto que se va cifrando: los caracteres se vuelven hex de a poco (siempre igual para un mismo avance). */
    const scramble = (from: string, to: string, p: number) => {
      const hex = "0123456789abcdef";
      const n = Math.max(from.length, to.length);
      let out = "";
      for (let i = 0; i < n; i++) {
        if (i / n < p) out += to[i] ?? "";
        else out += from[i] ? hex[(i * 7 + Math.floor(p * 31)) % 16] : "";
      }
      return out;
    };

    /** 8. Números: normalizar, cifrar con HMAC y cruzar los códigos. */
    const sceneNumbers = (g: G, R: Rect, u: number) => {
      const items = D.pitch?.numeros.items;
      if (!items) return;
      const small = R.w < 560;
      const fs = small ? 9.5 : 12.5;
      const casos = [...new Set(items.map((x) => x.caso))];
      const rowH = Math.min(small ? 30 : 48, (R.h - 110) / casos.length);
      const x0 = R.x;
      const xC = R.x + (small ? 26 : 44);
      const colW = (R.w - (xC - R.x) - (small ? 54 : 150)) / 2;
      const xP = xC + colW + 12;
      const top = R.y + 40;
      const phase = u < 0.3 ? 0 : u < 0.5 ? 1 : 2;
      const heads = [L.fields.contact, L.fields.payment];
      const sub = [L.normalized, L.normalized, L.hmac][phase]!;
      g.globalAlpha = ease(seg(u, 0, 0.06));
      heads.forEach((h, i) => {
        const x = i === 0 ? xC : xP;
        txt(g, h, x, R.y + 6, fs + 1, c(COL.cream), 700);
        txt(g, phase === 0 ? "" : sub, x, R.y + 24, fs - 2, c(phase === 2 ? COL.id : COL.dim), 700);
      });
      g.globalAlpha = 1;
      const shared = new Map<string, number>();
      for (const it of items) if (it.rol === "cobro") shared.set(it.ref, (shared.get(it.ref) ?? 0) + 1);
      const hot = [...shared.entries()].sort((a, b) => b[1] - a[1])[0];
      const match = ease(seg(u, 0.72, 0.84));
      const rowsY: Record<string, number> = {};
      casos.forEach((k, r) => {
        const y = top + r * rowH + rowH / 2;
        rowsY[k] = y;
        const a = ease(seg(u, r * 0.02, 0.08 + r * 0.02));
        g.globalAlpha = a;
        txt(g, k, x0, y, fs + 3, c(COL.cream), 800, "left", display);
        for (const rol of ["contacto", "cobro"]) {
          const it = items.find((x) => x.caso === k && x.rol === rol);
          if (!it) continue;
          const x = rol === "contacto" ? xC : xP;
          let t = it.valor;
          let col = c(COL.cream);
          if (u >= 0.3) t = it.normalizado;
          if (u >= 0.5) {
            const q = seg(u, 0.5 + r * 0.015, 0.62 + r * 0.015);
            t = q < 1 ? scramble(it.normalizado, `${it.ref} …${it.ultimos}`, q) : `${it.ref} …${it.ultimos}`;
            col = c(COL.id);
          }
          const isHot = rol === "cobro" && hot && it.ref === hot[0];
          if (isHot && match > 0) {
            g.fillStyle = c(COL.id, 0.2 * match);
            font(g, fs, 700, "ui-monospace, Consolas, monospace");
            g.fillRect(x - 6, y - fs, g.measureText(t).width + 12, fs * 2);
          }
          txt(
            g,
            t,
            x,
            y,
            fs,
            rol === "cobro" && match > 0 && !isHot ? c(COL.dim, 0.7) : col,
            700,
            "left",
            "ui-monospace, Consolas, monospace",
          );
        }
        g.globalAlpha = 1;
      });
      // Los que coinciden: un corchete con cuántos casos comparten la cuenta.
      if (match > 0 && hot) {
        const ys = casos
          .filter((k) => items.some((x) => x.caso === k && x.rol === "cobro" && x.ref === hot[0]))
          .map((k) => rowsY[k]!);
        const bx = xP + colW + 8;
        g.strokeStyle = c(COL.id, match);
        g.lineWidth = 2;
        g.beginPath();
        for (const y of ys) {
          g.moveTo(bx - 6, y);
          g.lineTo(bx + 6, y);
        }
        g.moveTo(bx + 6, Math.min(...ys));
        g.lineTo(bx + 6, lerp(Math.min(...ys), Math.max(...ys), match));
        g.stroke();
        g.globalAlpha = match;
        if (!small)
          wrap(
            g,
            fill(L.sameAccountCases, { n: hot[1] }),
            bx + 14,
            (Math.min(...ys) + Math.max(...ys)) / 2 - 8,
            R.x + R.w - bx - 14,
            fs,
            c(COL.id),
            700,
            1.3,
            3,
          );
        g.globalAlpha = 1;
      }
      // Las conclusiones, abajo.
      const out = ease(seg(u, 0.78, 0.9));
      if (out > 0) {
        const by = top + casos.length * rowH + 18;
        g.globalAlpha = out;
        txt(g, L.distinctContacts, R.x, by, fs, c(COL.cream), 700);
        if (small && hot) txt(g, fill(L.sameAccountCases, { n: hot[1] }), R.x, by + fs * 1.6, fs, c(COL.id), 700);
        txt(
          g,
          `${L.demoKey}. ${L.stored}: ID-…, …${hot?.[0] ? items.find((x) => x.ref === hot[0])?.ultimos : ""}`,
          R.x,
          by + fs * (small ? 3.2 : 1.8),
          fs - 2,
          c(COL.dim),
          400,
        );
        g.globalAlpha = 1;
      }
    };

    /** 9. Patrones de habla: las frases que se repiten, el vector del resumen y lo que separa a las bandas. */
    const scenePatterns = (g: G, R: Rect, u: number) => {
      const pt = D.pitch?.patrones;
      if (!pt) return;
      const small = R.w < 560;
      const fs = small ? 9.5 : 12;
      // Las frases firma que se repiten, con los casos donde aparecen.
      g.globalAlpha = ease(seg(u, 0, 0.06));
      txt(g, L.phrasesTitle, R.x, R.y + 6, fs + 1, c(COL.cream), 700);
      g.globalAlpha = 1;
      const letters = ["A", "B", "C", "D", "E", "F", "G"];
      pt.frases.slice(0, 3).forEach((fr, i) => {
        const y = R.y + 32 + i * (small ? 34 : 40);
        const a = ease(seg(u, i * 0.05, 0.1 + i * 0.05));
        g.globalAlpha = a;
        const q = `«${fr.frase.replace(/[.]$/, "")}»`;
        wrap(g, q, R.x, y, small ? R.w * 0.55 : R.w * 0.5, fs + 0.5, c(KIND.frase!), 700, 1.2, 1);
        letters.forEach((k, j) => {
          const on = fr.casos.includes(k);
          const lit = on ? ease(seg(u, 0.1 + i * 0.05 + j * 0.012, 0.16 + i * 0.05 + j * 0.012)) : 0;
          const bx = R.x + (small ? R.w * 0.58 : R.w * 0.53) + j * (small ? 18 : 24);
          g.fillStyle = on && lit > 0 ? c(KIND.frase!, 0.25 + 0.75 * lit) : "rgb(255 255 255 / 0.08)";
          g.beginPath();
          g.roundRect(bx, y - (small ? 8 : 10), small ? 15 : 20, small ? 16 : 20, 4);
          g.fill();
          txt(
            g,
            k,
            bx + (small ? 7.5 : 10),
            y + 0.5,
            fs - 1.5,
            on && lit > 0.5 ? "#231a14" : c(COL.dim, 0.6),
            800,
            "center",
          );
        });
        g.globalAlpha = 1;
      });
      // El resumen de A y de B como vectores (384 números): se parecen, pero todos se parecen.
      const vy = R.y + (small ? 140 : 170);
      const va = pt.vector_a;
      const vb = pt.vector_b;
      const vec2 = seg(u, 0.22, 0.38);
      if (va && vb && vec2 > 0) {
        const cols = 96;
        const rows = 4;
        const cw = (R.w * (small ? 1 : 0.62)) / cols;
        const scale = Math.max(...va.map(Math.abs)) * 0.7;
        [va, vb].forEach((v, s) => {
          const y = vy + s * (rows * cw + 22);
          txt(g, fill(L.summaryVector, { k: s === 0 ? "A" : "B" }), R.x, y - 8, fs - 1.5, c(COL.dim), 700);
          for (let k = 0; k < cols * rows; k++) {
            if (k / (cols * rows) > vec2) break;
            g.fillStyle = rgb(cellColor(v[k]!, scale));
            g.fillRect(R.x + (k % cols) * cw, y + Math.floor(k / cols) * cw, cw - 0.5, cw - 0.5);
          }
        });
        if (!small) {
          const p0 = pt.pares[0]!;
          const cx = R.x + R.w * 0.66;
          g.globalAlpha = ease(seg(u, 0.34, 0.42));
          txt(g, `${L.terms.cosine} ${fmt(p0.coseno)}`, cx, vy + 14, fs + 2, c(COL.cream), 800);
          wrap(
            g,
            fill(L.avgCosine, { c: fmt(pt.coseno_media) }),
            cx,
            vy + 36,
            R.w * 0.32,
            fs - 1,
            c(COL.dim),
            400,
            1.3,
            3,
          );
          g.globalAlpha = 1;
        }
      }
      // La cuenta del guion: parecido + frase común + mismo canal + mismo grupo.
      const p0 = pt.pares[0]!;
      const fy = vy + (small ? 64 : 84);
      const terms: [string, string, number][] = [
        [L.terms.cosine, fmt(p0.coseno), 0.42],
        [L.terms.phrases, `+ ${fmt(0.05 * Math.min(p0.frases.length, 3))}`, 0.47],
        [L.terms.channel, `+ ${p0.canal ? "0.03" : "0.00"}`, 0.52],
        [L.terms.group, `+ ${p0.grupo ? "0.05" : "0.00"}`, 0.57],
        ["x", `= ${p0.x.toFixed(3)}`, 0.62],
      ];
      let tx = R.x;
      const tw = (R.w * (small ? 1 : 0.95)) / terms.length;
      txt(g, pairName("A", "B"), R.x, fy - 14, fs - 1, c(COL.dim), 700);
      terms.forEach(([k, v, t0]) => {
        const a = ease(seg(u, t0, t0 + 0.05));
        g.globalAlpha = a;
        txt(g, v, tx, fy + 6, fs + (small ? 1 : 3), k === "x" ? c(COL.ocre) : c(COL.cream), 800, "left", display);
        txt(g, k, tx, fy + 26, fs - 2, c(COL.dim), 400);
        g.globalAlpha = 1;
        tx += tw;
      });
      const pg = ease(seg(u, 0.66, 0.72));
      if (pg > 0) {
        g.globalAlpha = pg;
        pill(
          g,
          `${L.terms.result} ${fmt(p0.p)} (${L.cap})`,
          R.x + R.w * (small ? 0.5 : 0.8),
          fy + 48,
          COL.ocre,
          fs,
          true,
        );
        g.globalAlpha = 1;
      }
      // Lo que separa: la x de 496 pares de guiones ficticios.
      const hy = fy + (small ? 76 : 88);
      const hh = R.y + R.h - hy - 30;
      const hist = seg(u, 0.7, 0.88);
      if (hist > 0 && hh > 40) {
        const lo = 0.85;
        const hi = 1.2;
        const bins = 35;
        const count = (xs: number[]) => {
          const b = new Array<number>(bins).fill(0);
          for (const x of xs) b[Math.min(bins - 1, Math.max(0, Math.floor(((x - lo) / (hi - lo)) * bins)))]!++;
          return b;
        };
        const cm = count(pt.x_mismo);
        const cd = count(pt.x_distintos);
        const mx = Math.max(...cm, ...cd);
        const bw = R.w / bins;
        const X = (x: number) => R.x + ((x - lo) / (hi - lo)) * R.w;
        for (let i = 0; i < bins; i++) {
          const hd = (cd[i]! / mx) * hh * hist;
          const hm = (cm[i]! / mx) * hh * hist;
          g.fillStyle = c(COL.dim, 0.45);
          g.fillRect(R.x + i * bw + 1, hy + hh - hd, bw - 2, hd);
          g.fillStyle = c(COL.ocre, 0.9);
          g.fillRect(R.x + i * bw + bw * 0.25, hy + hh - hm, bw * 0.5, hm);
        }
        g.fillStyle = "rgb(255 255 255 / 0.25)";
        g.fillRect(R.x, hy + hh, R.w, 1);
        // Los pares del demo: A y B (mismo guion) y A y C (no).
        const mk = ease(seg(u, 0.84, 0.92));
        pt.pares.forEach((pp, i) => {
          if (mk <= 0) return;
          const x = X(pp.x);
          g.strokeStyle = i === 0 ? c(COL.ocre, mk) : c(COL.cream, mk * 0.8);
          g.setLineDash(i === 0 ? [] : [3, 3]);
          g.lineWidth = 2;
          g.beginPath();
          g.moveTo(x, hy - 4);
          g.lineTo(x, hy + hh);
          g.stroke();
          g.setLineDash([]);
          g.globalAlpha = mk;
          pill(g, `${pairName(pp.par)} ${fmt(pp.p)}`, x, hy - 14, i === 0 ? COL.ocre : COL.dim, fs - 1.5);
          g.globalAlpha = 1;
        });
        g.globalAlpha = hist;
        g.fillStyle = c(COL.ocre);
        g.fillRect(R.x, hy + hh + 14, 10, 10);
        txt(g, fill(L.sameScript, { n: pt.x_mismo.length }), R.x + 14, hy + hh + 19, fs - 1.5, c(COL.dim));
        font(g, fs - 1.5);
        const lx = R.x + 14 + g.measureText(fill(L.sameScript, { n: pt.x_mismo.length })).width + 18;
        g.fillStyle = c(COL.dim, 0.45);
        g.fillRect(lx, hy + hh + 14, 10, 10);
        txt(g, fill(L.otherPairs, { n: pt.x_distintos.length }), lx + 14, hy + hh + 19, fs - 1.5, c(COL.dim));
        g.globalAlpha = 1;
      }
    };

    /** 10. Combina: las señales calibradas de dos pares y su suma. */
    /** La suma de las señales prendidas: 1 − ∏(1 − p), la misma de combineSignals (packages/shared). */
    const combined = (sg: Señales) =>
      1 - (I.sig.voz ? 1 - sg.voz : 1) * (I.sig.guion ? 1 - sg.guion : 1) * (I.sig.cuenta ? 1 - sg.cuenta : 1);
    const sceneCombine = (g: G, R: Rect, u0: number) => {
      const cb = D.pitch?.combina;
      if (!cb) return;
      const small = R.w < 560;
      const fs = small ? 10 : 12.5;
      // La persona puede apagar señales: la suma se recalcula y cambia la decisión.
      const touched = I.touched.has(10);
      const u = touched ? 1 : u0;
      const pairs: [string, Señales, number][] = [
        [pairName("A", "B"), cb.ab, 0],
        [pairName("B", "C"), cb.bc, 0.45],
      ];
      const ph = R.h / 2 - 10;
      pairs.forEach(([name, sg, t0], pi) => {
        const y0 = R.y + pi * (ph + 20);
        const a0 = ease(seg(u, t0, t0 + 0.06));
        if (a0 <= 0) return;
        g.globalAlpha = a0;
        txt(g, name, R.x, y0 + 8, fs + 4, c(COL.cream), 800, "left", display);
        g.globalAlpha = 1;
        const barX = R.x + (small ? 70 : 110);
        const barW = R.w - (barX - R.x) - (small ? 40 : 60);
        const tot = combined(sg);
        const totS = smooth(`tot${pi}`, tot);
        const rows: [string, number, string, string | null][] = [
          [L.signals.voice, sg.voz, COL.ocre, "voz"],
          [L.signals.script, sg.guion, KIND.frase!, "guion"],
          [L.signals.account, sg.cuenta, COL.id, "cuenta"],
          [L.signals.together, totS, COL.cream, null],
        ];
        const rh = Math.min(small ? 26 : 38, (ph - 40) / rows.length);
        rows.forEach(([k, v, col, key], i) => {
          const y = y0 + 34 + i * rh;
          const grow = ease(seg(u, t0 + 0.05 + i * 0.06, t0 + 0.13 + i * 0.06));
          const isTotal = key === null;
          const on = isTotal || I.sig[key as keyof typeof I.sig];
          txt(
            g,
            k,
            R.x,
            y + rh / 2 - 2,
            fs - (isTotal ? 0 : 1),
            isTotal ? c(COL.cream) : c(COL.dim, on ? 1 : 0.6),
            isTotal ? 800 : 400,
          );
          g.fillStyle = "rgb(255 255 255 / 0.08)";
          g.fillRect(barX, y + 2, barW, rh - 10);
          if (on) {
            g.fillStyle = c(col, isTotal ? 1 : 0.85);
            g.fillRect(barX, y + 2, barW * v * grow, rh - 10);
          } else if (v > 0.005) {
            // Apagada: solo su contorno, para ver cuánto aportaba.
            g.setLineDash([3, 3]);
            g.strokeStyle = c(col, 0.7);
            g.lineWidth = 1;
            g.strokeRect(barX + 0.5, y + 2.5, barW * v * grow - 1, rh - 11);
            g.setLineDash([]);
          }
          if (grow > 0)
            txt(
              g,
              on ? (v > 0.005 ? fmt(v) : "0") : L.off,
              barX + barW * v * grow + 8,
              y + rh / 2 - 3,
              fs,
              on ? c(COL.cream) : c(COL.dim),
              700,
            );
          if (key) hit(R.x, y, R.w, rh, () => press(`[data-sig="${key}"]`));
        });
        // Los umbrales: revisar (0.60) y probable (0.90).
        for (const [v, lab] of [
          [cb.revisar, L.review],
          [cb.probable, L.probable],
        ] as [number, string][]) {
          const x = barX + barW * v;
          g.setLineDash([3, 4]);
          g.strokeStyle = c(COL.cream, 0.5 * a0);
          g.lineWidth = 1;
          g.beginPath();
          g.moveTo(x, y0 + 26);
          g.lineTo(x, y0 + 34 + rows.length * rh - 6);
          g.stroke();
          g.setLineDash([]);
          txt(g, `${lab} ${fmt(v)}`, x, y0 + 20, fs - 2.5, c(COL.dim, a0), 700, "center");
        }
        const done = ease(seg(u, t0 + 0.3, t0 + 0.36));
        if (done > 0) {
          g.globalAlpha = done;
          const parts = [
            [sg.voz, I.sig.voz],
            [sg.guion, I.sig.guion],
            [sg.cuenta, I.sig.cuenta],
          ]
            .filter(([x, on]) => on && (x as number) > 0.005)
            .map(([x]) => x as number);
          const formula = parts.length
            ? `1 − ${parts.map((x) => `(1 − ${fmt(x)})`).join(" × ")} = ${fmt(tot)}`
            : `= ${fmt(0)}`;
          txt(
            g,
            formula,
            barX,
            y0 + 34 + rows.length * rh + 8,
            fs - 1,
            c(COL.dim),
            700,
            "left",
            "ui-monospace, Consolas, monospace",
          );
          // La decisión: probable, a revisión o no llega al equipo.
          const lv = tot >= cb.probable ? "probable" : tot >= cb.revisar ? "review" : "none";
          const label = lv === "probable" ? L.probable : lv === "review" ? L.review : U.combine.levels.none;
          const col = lv === "probable" ? COL.alert : lv === "review" ? COL.ocre : COL.dim;
          font(g, fs - 1, 700);
          const pw2 = g.measureText(label).width + (fs - 1) * 1.1;
          font(g, fs + 4, 800, display);
          const nameW = g.measureText(name).width;
          pill(g, label, R.x + nameW + 14 + pw2 / 2, y0 + 8, col, fs - 1, lv === "probable");
          g.globalAlpha = 1;
        }
      });
    };

    /** 11. Une: los casos y lo que comparten arman la red; una persona la confirma. */
    const sceneNetwork = (g: G, R: Rect, u0: number) => {
      const small = R.w < 520;
      const fs = small ? 10 : 12;
      // La persona revisa el vínculo por la voz entre A y B: si lo descarta, A queda fuera de la red.
      const rv = I.review;
      const u = rv ? Math.max(u0, 0.95) : u0;
      const out = rv === "no";
      const P = (fx: number, fy: number) => ({ x: R.x + R.w * fx, y: R.y + R.h * fy });
      const cases = [
        { k: "A", ...P(0.1, 0.32) },
        { k: "B", ...P(0.42, 0.5) },
        { k: "C", ...P(0.9, 0.2) },
        { k: "D", ...P(0.94, 0.48) },
        { k: "E", ...P(0.84, 0.78) },
        { k: "G", ...P(0.6, 0.86) },
      ];
      const F = { k: "F", ...P(0.24, 0.72) };
      const voice = { ...P(0.25, 0.42), col: COL.ocre, lab: "V-3" };
      const acc = { ...P(0.68, 0.5), col: COL.id, lab: "Yape …202" };
      const edges: [{ x: number; y: number }, { x: number; y: number }, string][] = [
        [cases[0]!, voice, COL.ocre],
        [voice, cases[1]!, COL.ocre],
        [cases[1]!, acc, COL.id],
        [acc, cases[2]!, COL.id],
        [acc, cases[3]!, COL.id],
        [acc, cases[4]!, COL.id],
        [acc, cases[5]!, COL.id],
      ];
      const ring = ease(seg(u, 0.62, 0.76));
      if (ring > 0) {
        g.setLineDash([6, 6]);
        g.strokeStyle = c(COL.alert, 0.8 * ring);
        g.lineWidth = 1.5;
        g.beginPath();
        g.ellipse(R.x + R.w * 0.53, R.y + R.h * 0.53, R.w * 0.5, R.h * 0.47, 0, 0, Math.PI * 2 * ring);
        g.stroke();
        g.setLineDash([]);
        g.globalAlpha = ring;
        pill(g, fill(L.network, { n: out ? 5 : 6 }), R.x + R.w * 0.53, R.y + 8, COL.alert, fs + 1);
        g.globalAlpha = 1;
      }
      edges.forEach(([a, b, col], i) => {
        const f = ease(seg(u, 0.25 + i * 0.04, 0.35 + i * 0.04));
        if (f <= 0) return;
        const cut = out && i < 2;
        g.strokeStyle = c(col, cut ? 0.3 : 0.9);
        g.lineWidth = cut ? 1.5 : 2.5;
        if (cut) g.setLineDash([4, 5]);
        g.beginPath();
        g.moveTo(a.x, a.y);
        g.lineTo(lerp(a.x, b.x, f), lerp(a.y, b.y, f));
        g.stroke();
        g.setLineDash([]);
      });
      // F dice ser de Los X, pero paga a otra cuenta y su voz no está: solo el guion (0.40) no alcanza.
      const fa = ease(seg(u, 0.5, 0.6));
      if (fa > 0) {
        g.setLineDash([3, 5]);
        g.strokeStyle = c(KIND.frase!, 0.6 * fa);
        g.lineWidth = 1.5;
        g.beginPath();
        g.moveTo(F.x, F.y);
        g.lineTo(cases[0]!.x, cases[0]!.y);
        g.stroke();
        g.setLineDash([]);
        g.globalAlpha = fa * 0.9;
        txt(g, L.scriptOnly, F.x - 16, F.y + (small ? 30 : 38), fs - 1.5, c(KIND.frase!), 700, "left");
        g.globalAlpha = 1;
      }
      for (const h of [voice, acc]) {
        const f = ease(seg(u, 0.18, 0.3));
        if (f <= 0) continue;
        g.globalAlpha = f * (out && h === voice ? 0.4 : 1);
        g.fillStyle = "rgb(28 20 15)";
        g.beginPath();
        g.arc(h.x, h.y, small ? 14 : 18, 0, Math.PI * 2);
        g.fill();
        g.strokeStyle = c(h.col);
        g.lineWidth = 2;
        g.stroke();
        pill(g, h.lab, h.x, h.y + (small ? 26 : 32), h.col, fs - 0.5);
        txt(
          g,
          h === voice ? L.sameVoice : L.sameAccount,
          h.x,
          h.y + (small ? 46 : 56),
          fs - 1,
          c(h.col),
          700,
          "center",
        );
        g.globalAlpha = 1;
      }
      [...cases, F].forEach((n, i) => {
        const f = ease(seg(u, i * 0.03, 0.14 + i * 0.03));
        if (f <= 0) return;
        const w = small ? 32 : 42;
        g.globalAlpha = f * (n === F || (out && n.k === "A") ? 0.45 : 1);
        g.fillStyle = "#f4efe8";
        g.beginPath();
        g.roundRect(n.x - w / 2, n.y - w / 2, w, w, 10);
        g.fill();
        txt(g, n.k, n.x, n.y + 1, small ? 15 : 18, "#2a1e17", 800, "center", display);
        g.globalAlpha = 1;
      });
      // La decisión: confirmado (por una revisora, o por la persona que mira) o descartado.
      const ok = rv ? 1 : ease(seg(u, 0.78, 0.9));
      if (ok > 0) {
        const x = cases[0]!.x - (small ? 8 : 12);
        const y = cases[0]!.y - (small ? 44 : 58);
        g.globalAlpha = ok;
        g.fillStyle = out ? "#8a3b22" : "#2f6b4a";
        g.beginPath();
        g.arc(x, y, small ? 11 : 14, 0, Math.PI * 2);
        g.fill();
        g.strokeStyle = "#fff";
        g.lineWidth = 2.5;
        g.beginPath();
        if (out) {
          g.moveTo(x - 4.5, y - 4.5);
          g.lineTo(x + 4.5, y + 4.5);
          g.moveTo(x + 4.5, y - 4.5);
          g.lineTo(x - 4.5, y + 4.5);
        } else {
          g.moveTo(x - 5, y);
          g.lineTo(x - 1, y + 4);
          g.lineTo(x + 6, y - 4);
        }
        g.stroke();
        const said = rv === "ok" ? L.confirmedByYou : out ? L.discardedByYou : L.confirmed;
        txt(g, said, x + (small ? 18 : 22), y + 1, fs, c(COL.cream), 700, "left");
        g.globalAlpha = 1;
      }
    };

    /** 12. Vigila: 14 días en dos distritos; con 5 casos de «Los X» en uno, la alerta. */
    const sceneVigia = (g: G, R: Rect, u: number) => {
      const vg = D.pitch?.vigia;
      if (!vg) return;
      // Con el deslizador, la persona avanza los días: los casos entran cuando llega su fecha.
      const user = I.day !== null;
      const dS = user ? smooth("day", I.day!) : 0;
      const small = R.w < 560;
      const fs = small ? 10 : 12.5;
      const zonas = [
        { id: "san-juan-de-lurigancho", name: "San Juan de Lurigancho" },
        { id: "comas", name: "Comas" },
      ];
      const ax0 = R.x + (small ? 4 : 10);
      const ax1 = R.x + R.w - 10;
      const X = (dia: number) => lerp(ax0, ax1, (vg.ventana - dia) / vg.ventana);
      const rowY = (i: number) => R.y + (small ? 64 : 90) + i * (small ? 70 : 96);
      const a0 = user ? 1 : ease(seg(u, 0, 0.08));
      // El eje: hace 14 días a hoy.
      g.globalAlpha = a0;
      g.fillStyle = "rgb(255 255 255 / 0.25)";
      g.fillRect(ax0, R.y + 30, ax1 - ax0, 1);
      for (let d = vg.ventana; d >= 0; d--) {
        const x = X(d);
        g.fillRect(x, R.y + 26, 1, d % 7 === 0 ? 9 : 5);
        if (d % 7 === 0)
          txt(
            g,
            d === 0 ? L.today : fill(L.daysAgo, { n: d }),
            x,
            R.y + 14,
            fs - 2,
            c(COL.dim),
            400,
            d === vg.ventana ? "left" : d === 0 ? "right" : "center",
          );
      }
      zonas.forEach((z, i) => {
        const y = rowY(i);
        txt(g, z.name, ax0, y - (small ? 22 : 28), fs, c(COL.cream), 700);
        g.fillStyle = "rgb(255 255 255 / 0.06)";
        g.fillRect(ax0, y - 14, ax1 - ax0, 28);
      });
      g.globalAlpha = 1;
      // Los casos entran en el orden en que llegaron (del más antiguo al más nuevo).
      const orden = [...vg.casos].sort((a, b) => b.dia - a.dia);
      let losX = 0;
      let last = -1;
      orden.forEach((cs, i) => {
        const zi = zonas.findIndex((z) => z.id === cs.zona);
        if (zi < 0) return;
        const t0 = 0.1 + i * 0.07;
        const a = user ? ease(clamp((dS - (vg.ventana - cs.dia)) * 2 + 1)) : ease(seg(u, t0, t0 + 0.06));
        if (a <= 0) return;
        if (a >= 1) last = Math.max(last, vg.ventana - cs.dia);
        const isX = cs.grupo === "Los X" && cs.zona === "san-juan-de-lurigancho";
        if (isX && a >= 1) losX++;
        const x = X(cs.dia);
        const y = rowY(zi);
        const r = (small ? 10 : 13) * (0.6 + 0.4 * a);
        g.beginPath();
        g.arc(x, y, r, 0, Math.PI * 2);
        g.fillStyle = isX ? c(COL.alert) : cs.grupo ? c("200 170 150") : c(COL.dim, 0.6);
        g.fill();
        txt(g, cs.caso, x, y + 0.5, fs, "#231a14", 800, "center", display);
        if (a < 1) {
          g.strokeStyle = c(COL.alert, 1 - a);
          g.lineWidth = 1.5;
          g.beginPath();
          g.arc(x, y, r + (1 - a) * 18, 0, Math.PI * 2);
          g.stroke();
        }
      });
      if (!user && main) auto.day = Math.max(0, last);
      // El día que eligió la persona: una línea sobre las dos filas.
      if (user) {
        const xc = X(vg.ventana - dS);
        g.fillStyle = c(COL.cream, 0.85);
        g.fillRect(xc - 1, R.y + 22, 2, rowY(1) + 18 - (R.y + 22));
        g.beginPath();
        g.arc(xc, R.y + 30, 4.5, 0, Math.PI * 2);
        g.fill();
      }
      // El contador del patrón y la regla.
      const cy = rowY(2) - (small ? 10 : 6);
      const full = losX >= 5;
      g.globalAlpha = a0;
      txt(
        g,
        fill(L.counter, { n: losX }),
        R.x,
        cy,
        fs + (small ? 4 : 8),
        full ? c(COL.alert) : c(COL.cream),
        800,
        "left",
        display,
      );
      txt(g, `${L.pattern}. ${L.rule}`, R.x, cy + (small ? 22 : 28), fs - 1.5, c(COL.dim), 400);
      g.globalAlpha = 1;
      // El borrador de alerta y la aprobación (con el deslizador, apenas se juntan los cinco casos).
      const dr = user ? (full ? 1 : 0) : ease(seg(u, 0.68, 0.78));
      if (dr > 0) {
        const cw = small ? R.w : R.w * 0.62;
        const cx = R.x;
        const y = cy + (small ? 40 : 56);
        g.globalAlpha = dr;
        g.fillStyle = "#f4efe8";
        g.beginPath();
        g.roundRect(cx, y, cw, small ? 74 : 92, 10);
        g.fill();
        txt(g, L.draft, cx + 14, y + 20, fs + 1, "#7a3b20", 800);
        wrap(g, L.alert, cx + 14, y + 42, cw - 28, fs, "#2a1e17", 400, 1.35, 2);
        g.globalAlpha = 1;
        const ok = user ? 1 : ease(seg(u, 0.82, 0.9));
        if (ok > 0) {
          const bx = small ? cx : cx + cw + 22;
          const by = y + (small ? 92 : 46);
          g.globalAlpha = ok;
          g.fillStyle = "#2f6b4a";
          g.beginPath();
          g.arc(bx + 12, by, 12, 0, Math.PI * 2);
          g.fill();
          g.strokeStyle = "#fff";
          g.lineWidth = 2.5;
          g.beginPath();
          g.moveTo(bx + 7, by);
          g.lineTo(bx + 11, by + 4);
          g.lineTo(bx + 18, by - 4);
          g.stroke();
          txt(g, L.approved, bx + 30, by + 1, fs, c(COL.cream), 700);
          g.globalAlpha = 1;
        }
      }
    };

    /** 13. Protege: el distrito se enciende en el mapa y sale la alerta aprobada. */
    const sceneProtect = (g: G, R: Rect, u: number) => {
      const small = R.w < 520;
      const fs = small ? 10 : 12;
      const gr = fitGrid({ x: R.x, y: R.y, w: R.w * (small ? 1 : 0.62), h: R.h }, cfg.grid.cols, cfg.grid.rows, 1.25);
      const gap = Math.max(2, gr.w * 0.07);
      // Solo se publica San Juan de Lurigancho (6 casos de la red: rango 5-9). Comas tiene 1: menos de 5,
      // queda igual que un distrito sin datos, como en el mapa público.
      const hot = new Set(["san-juan-de-lurigancho"]);
      const on = ease(seg(u, 0.15, 0.4));
      let comas = { x: 0, y: 0, w: 0, h: 0 };
      let sjl = { x: 0, y: 0, w: 0, h: 0 };
      for (const [id, col, row] of tiles) {
        const x = gr.x + col * gr.w + gap / 2;
        const y = gr.y + row * gr.h + gap / 2;
        const w = gr.w - gap;
        const h = gr.h - gap;
        g.fillStyle = c("255 255 255", 0.07);
        g.beginPath();
        g.roundRect(x, y, w, h, 3);
        g.fill();
        if (hot.has(id) && on > 0) {
          g.fillStyle = c("160 58 31", on);
          g.fill();
        }
        if (id === "san-juan-de-lurigancho") sjl = { x, y, w, h };
        if (id === "comas") comas = { x, y, w, h };
      }
      // Las ondas de la alerta.
      const wave = seg(u, 0.4, 0.8);
      for (let k = 0; k < 3; k++) {
        const f = clamp(wave * 1.6 - k * 0.3);
        if (f <= 0 || f >= 1) continue;
        g.strokeStyle = c(COL.alert, 0.8 * (1 - f));
        g.lineWidth = 2;
        g.beginPath();
        g.arc(sjl.x + sjl.w / 2, sjl.y + sjl.h / 2, 10 + f * gr.w * 4, 0, Math.PI * 2);
        g.stroke();
      }
      if (on >= 1) pill(g, L.range, sjl.x + sjl.w / 2, sjl.y + sjl.h + 14, COL.cream, fs, true);
      if (on > 0) {
        txt(
          g,
          "SJL",
          sjl.x + sjl.w / 2,
          sjl.y + sjl.h / 2 + 0.5,
          Math.max(9, gr.w * 0.22),
          c(COL.cream, on),
          800,
          "center",
        );
        // Comas: punteado y con su nota, sin color.
        g.setLineDash([3, 3]);
        g.strokeStyle = c(COL.dim, 0.8 * on);
        g.lineWidth = 1.2;
        g.strokeRect(comas.x + 1, comas.y + 1, comas.w - 2, comas.h - 2);
        g.setLineDash([]);
        g.globalAlpha = on;
        txt(g, L.underFive, comas.x + comas.w + 8, comas.y + comas.h / 2 + 0.5, fs - 1.5, c(COL.dim), 700, "left");
        g.globalAlpha = 1;
      }
      // La alerta aprobada.
      const al = ease(seg(u, 0.55, 0.75));
      if (al > 0) {
        const cw = small ? R.w * 0.86 : R.w * 0.36;
        const cx = small ? R.x + (R.w - cw) / 2 : R.x + R.w - cw;
        const cy = small ? R.y + R.h * 0.62 : R.y + R.h * 0.3;
        g.globalAlpha = al;
        g.fillStyle = "#f4efe8";
        g.beginPath();
        g.roundRect(cx, cy, cw, small ? 96 : 150, 12);
        g.fill();
        txt(g, L.alertTitle, cx + 16, cy + 24, fs + 3, "#2f6b4a", 800);
        wrap(g, L.alert, cx + 16, cy + 52, cw - 32, fs + 2, "#2a1e17", 400, 1.38);
        g.globalAlpha = 1;
      }
    };

    const SCENES = [
      sceneLogo,
      sceneProblem,
      sceneVictims,
      sceneListen,
      sceneUndo,
      sceneRadar,
      sceneLook,
      sceneRead,
      sceneNumbers,
      scenePatterns,
      sceneCombine,
      sceneNetwork,
      sceneVigia,
      sceneProtect,
      sceneScale,
    ];

    // ---------- Dónde se dibuja cada escena ----------
    let W = 0;
    let H = 0;
    let viz: Rect = { x: 0, y: 0, w: 0, h: 0 };
    const measure = () => {
      const r = stage.getBoundingClientRect();
      W = r.width;
      H = r.height;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (W >= 900) {
        const right = copy.getBoundingClientRect().right - r.left;
        const x = right + Math.max(40, W * 0.04);
        viz = { x, y: H * 0.1, w: W - x - 70, h: H * 0.8 };
      } else {
        delete sm.vizh;
        viz = { x: 18, y: 44, w: W - 36, h: 0 };
        fitViz();
      }
      root.style.setProperty("--pt-viz", `${Math.round(viz.y + viz.h)}px`);
      fonts();
    };
    /** En el celular, el dibujo usa todo el alto que deja libre el texto de la escena que se ve. */
    const fitViz = () => {
      if (W >= 900) return;
      const li = scenes[active];
      const want = Math.max(H * 0.3, Math.min(H * 0.56, H - (li?.offsetHeight ?? H * 0.5) - 80));
      const h = Math.round(smooth("vizh", want));
      if (h !== viz.h) {
        viz = { ...viz, h };
        root.style.setProperty("--pt-viz", `${Math.round(viz.y + h)}px`);
      }
    };

    // ---------- Lo que dice cada control ----------
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel);
    const liveRegion = $<HTMLElement>("[data-live]");
    /** Lo que se anuncia a un lector de pantalla después de tocar un control. */
    const say = (s: string) => {
      if (liveRegion && s) liveRegion.textContent = s;
    };
    const writeOut = (key: string, s: string) => {
      const el = $<HTMLElement>(`[data-out="${key}"]`);
      if (el && el.textContent !== s) el.textContent = s;
    };
    const undoIn = $<HTMLInputElement>('[data-ctl="undo"]');
    const thrIn = $<HTMLInputElement>('[data-ctl="thr"]');
    const dayIn = $<HTMLInputElement>('[data-ctl="day"]');
    const undoText = (k: number) => {
      const s = fp?.sweep.find((x) => x.k === k);
      if (!fp || !s) return "";
      const best = fp.sweep.reduce((a, b) => (b.cos > a.cos ? b : a)).k;
      return fill(k === 0 ? U.undo.zero : k === best ? U.undo.best : U.undo.out, { k: signed(k), c: fmt(s.cos) });
    };
    const thrText = (t: number) => {
      const r = D.pitch?.radar;
      if (!r) return "";
      const n = [r.caso_a, r.caso_c, r.victima_a, ...r.slr73].filter((x) => x >= t).length;
      const tt = fmt(t);
      // La voz del caso A es la más parecida: si no pasa, no pasa ninguna.
      if (r.caso_a < t) return fill(U.radar.none, { t: tt });
      const m = n - 1;
      if (m === 0) return fill(U.radar.onlyA, { t: tt });
      return fill(m === 1 ? U.radar.manyOne : U.radar.manyMany, { t: tt, n, m });
    };
    const lookText = (k: number) => {
      const par = D.fotos?.pares[k];
      return par ? `${[L.sameRoom, L.otherRoom, L.resent][k]}: ${fill(L.patches, { n: par.con_pareja })}` : "";
    };
    const readText = (kind: string | null) => {
      if (!kind) return "";
      for (const pz of D.pitch?.lee.piezas ?? []) {
        const m = pz.marcas.find((x) => x.kind === kind);
        if (m)
          return fill(pz.tipo === "audio" ? U.read.outAudio : U.read.outText, {
            field: U.read.fields[kind as keyof typeof U.read.fields] ?? kind,
            text: pz.texto.slice(m.a, m.b),
            id: pz.label,
          });
      }
      return "";
    };
    const combineText = () => {
      const cb = D.pitch?.combina;
      if (!cb) return "";
      const rows: [string, string, Señales][] = [
        ["A", "B", cb.ab],
        ["B", "C", cb.bc],
      ];
      return rows
        .map(([a, b, sg]) => {
          const p = combined(sg);
          const lv = p >= cb.probable ? "probable" : p >= cb.revisar ? "review" : "none";
          return fill(U.combine.out, { pair: pairName(a, b), p: fmt(p), level: U.combine.levels[lv] });
        })
        .join(". ");
    };
    const reviewText = () => (I.review === "ok" ? U.review.confirmed : I.review === "no" ? U.review.discarded : "");
    const dayText = (day: number) => {
      const vg = D.pitch?.vigia;
      if (!vg) return "";
      const ago = vg.ventana - day;
      const n = vg.casos.filter(
        (x) => x.grupo === "Los X" && x.zona === "san-juan-de-lurigancho" && x.dia >= ago,
      ).length;
      const when = ago === 0 ? U.vigia.today : ago === 1 ? U.vigia.whenOne : fill(U.vigia.when, { n: ago });
      return n >= 5 ? fill(U.vigia.alert, { when }) : fill(U.vigia.out, { when, n });
    };
    const scaleText = (k: number | null) => {
      const row = k === null ? undefined : L.payments[k];
      return row ? fill(U.scale.out, { country: row[0], apps: row[1] }) : "";
    };
    /** Escribe lo que dice cada control según lo elegido (o, si no tocó nada, lo que marca el scroll). */
    const outputs = () => {
      const k = I.undo ?? auto.undo ?? (reduce ? -5 : 0);
      writeOut("undo", undoText(k));
      undoIn?.setAttribute("aria-valuetext", undoText(k));
      const t = I.thr ?? 0.6;
      writeOut("thr", thrText(t));
      thrIn?.setAttribute("aria-valuetext", thrText(t));
      writeOut("look", lookText(I.look ?? 0));
      writeOut("read", readText(I.field));
      writeOut("combine", combineText());
      writeOut("review", reviewText());
      const day = I.day ?? auto.day ?? 14;
      writeOut("day", dayText(day));
      dayIn?.setAttribute("aria-valuetext", dayText(day));
      writeOut("scale", scaleText(I.country));
    };

    // ---------- Lo que pasa al tocar ----------
    const touch = (i: number) => {
      I.touched.add(i);
      I.t = performance.now();
    };
    const pressGroup = (attr: string, value: string | null) => {
      for (const b of root.querySelectorAll<HTMLButtonElement>(`[${attr}]`))
        b.setAttribute("aria-pressed", String(b.getAttribute(attr) === value));
    };
    const setUndo = (k: number, announce = true) => {
      I.undo = k;
      touch(4);
      if (undoIn) undoIn.value = String(k);
      outputs();
      if (announce) say(undoText(k));
      repaint(4);
    };
    undoIn?.addEventListener("input", () => setUndo(Number(undoIn.value)));
    thrIn?.addEventListener("input", () => {
      I.thr = Number(thrIn.value) / 100;
      touch(5);
      outputs();
      say(thrText(I.thr));
      repaint(5);
    });
    dayIn?.addEventListener("input", () => {
      I.day = Number(dayIn.value);
      touch(12);
      outputs();
      say(dayText(I.day));
      repaint(12);
    });
    root.addEventListener("click", (e) => {
      const b = (e.target as Element | null)?.closest<HTMLButtonElement>("button");
      if (!b || !root.contains(b)) return;
      const k = b.dataset;
      if (k.look !== undefined) {
        I.look = Number(k.look);
        touch(6);
        pressGroup("data-look", k.look);
        outputs();
        say(lookText(I.look));
        repaint(6);
      } else if (k.field) {
        I.field = I.field === k.field ? null : k.field;
        touch(7);
        pressGroup("data-field", I.field);
        outputs();
        say(readText(I.field));
        repaint(7);
      } else if (k.sig) {
        const key = k.sig as keyof typeof I.sig;
        I.sig[key] = !I.sig[key];
        touch(10);
        b.setAttribute("aria-pressed", String(I.sig[key]));
        outputs();
        say(combineText());
        repaint(10);
      } else if (k.review) {
        I.review = k.review === "no" ? "no" : "ok";
        touch(11);
        pressGroup("data-review", I.review);
        outputs();
        say(reviewText());
        repaint(11);
      } else if (k.country !== undefined) {
        const c0 = Number(k.country);
        I.country = I.country === c0 ? null : c0;
        touch(14);
        pressGroup("data-country", I.country === null ? null : String(I.country));
        outputs();
        say(scaleText(I.country));
        repaint(14);
      }
    });
    /** Al salir de una escena, vuelve a lo que decide el scroll. */
    const reset = (i: number) => {
      I.touched.delete(i);
      if (i === 2) I.victim = -1;
      else if (i === 4) I.undo = null;
      else if (i === 5) {
        I.thr = null;
        if (thrIn) thrIn.value = "60";
      } else if (i === 6) {
        I.look = null;
        pressGroup("data-look", "0");
      } else if (i === 7) {
        I.field = null;
        pressGroup("data-field", null);
      } else if (i === 10) {
        I.sig = { voz: true, guion: true, cuenta: true };
        for (const b of root.querySelectorAll("[data-sig]")) b.setAttribute("aria-pressed", "true");
      } else if (i === 11) {
        I.review = null;
        pressGroup("data-review", null);
      } else if (i === 12) I.day = null;
      else if (i === 14) {
        I.country = null;
        pressGroup("data-country", null);
      }
      outputs();
    };
    /** Los deslizadores siguen al scroll mientras la persona no los toque. */
    const follow = () => {
      let changed = false;
      if (I.undo === null && auto.undo !== undefined && undoIn && undoIn.value !== String(auto.undo)) {
        undoIn.value = String(auto.undo);
        changed = true;
      }
      if (I.day === null && auto.day !== undefined && dayIn && dayIn.value !== String(auto.day)) {
        dayIn.value = String(auto.day);
        changed = true;
      }
      if (changed) outputs();
    };

    // ---------- El scroll ----------
    let target = 0;
    let shown = 0;
    let raf = 0;
    let t0 = performance.now();
    let active = 0;
    const live = !reduce;
    const bar = $<HTMLElement>("[data-progress]");
    const count = $<HTMLElement>("[data-count]");
    const steps = [...root.querySelectorAll<HTMLButtonElement>("[data-step]")];
    const sceneName = (i: number) => dots[i]?.querySelector(".sr-only")?.textContent?.trim() ?? "";
    /** La cuenta y las flechas: apagadas en los extremos y con el nombre de la escena a la que llevan. */
    const navState = () => {
      if (count) count.textContent = fill(cfg.nav.count, { n: active + 1, total: N });
      for (const b of steps) {
        const d = Number(b.dataset.step);
        const to = active + d;
        const off = to < 0 || to >= N;
        const name = d < 0 ? cfg.nav.prev : cfg.nav.next;
        b.setAttribute("aria-disabled", String(off));
        b.setAttribute("aria-label", off ? name : `${name}: ${sceneName(to)}`);
      }
    };

    let topPx = 0;
    const progress = () => {
      const r = track.getBoundingClientRect();
      const span = track.offsetHeight - stage.offsetHeight;
      return span > 0 ? Math.min(N - 0.001, clamp((topPx - r.top) / span) * N) : 0;
    };

    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      moving = false;
      hits = [];
      fitViz();
      const T = performance.now() - t0;
      const i = Math.floor(shown);
      const u = shown - i;
      // Al final de cada escena, la siguiente entra encima.
      const fade = seg(u, 0.86, 1);
      ctx.save();
      ctx.globalAlpha = 1 - fade;
      main = fade < 0.5;
      SCENES[i]?.(ctx, viz, Math.min(1, u / 0.82), T);
      main = false;
      ctx.restore();
      if (fade > 0 && i + 1 < N) {
        ctx.save();
        ctx.globalAlpha = fade;
        SCENES[i + 1]?.(ctx, viz, 0, T);
        ctx.restore();
      }
      const next = Math.min(N - 1, Math.floor(shown + 0.1));
      if (next !== active) {
        stopSound();
        reset(active);
        scenes[active]?.classList.remove("is-on");
        scenes[next]?.classList.add("is-on");
        dots[active]?.removeAttribute("aria-current");
        dots[next]?.setAttribute("aria-current", "step");
        active = next;
        navState();
      }
      follow();
      bar?.style.setProperty("--p", clamp(shown / (N - 1)).toFixed(4));
    };

    const frame = () => {
      target = progress();
      shown += (target - shown) * 0.16;
      if (Math.abs(target - shown) < 0.0005) shown = target;
      draw();
      const intro = performance.now() - t0 < 2600 && shown < 1;
      const busy = Math.abs(target - shown) > 0.0005 || intro || moving || playing();
      raf = busy ? requestAnimationFrame(frame) : 0;
    };
    const kick = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };

    const load = async () => {
      if (!photo.src) photo.src = cfg.photo;
      const [casos, pitch, voz, fotos, mapas] = await Promise.all([
        import("../data/casos-demo.json"),
        import("../data/pitch.json"),
        import("../data/voz-huella.json"),
        import("../data/fotos-demo.json"),
        import("../data/mapas.json"),
      ]);
      D.mapas = mapas.default as unknown as MapsData;
      D.casos = casos.default as unknown as Casos;
      D.pitch = pitch.default as unknown as PitchData;
      D.voz = voz.default as unknown as VozData;
      D.fotos = fotos.default as unknown as FotosData;
      prepare();
      outputs();
    };

    if (live) {
      const top = () => {
        let h = 0;
        for (const el of document.querySelectorAll<HTMLElement>(".help, .top")) {
          const pos = getComputedStyle(el).position;
          if (pos === "sticky" || pos === "fixed") h += el.offsetHeight;
        }
        topPx = h;
        root.style.setProperty("--pt-top", `${h}px`);
      };
      top();
      measure();
      t0 = performance.now();
      repaint = () => kick();
      navState();
      kick();
      photo.addEventListener("load", kick);
      // Los datos de las escenas (unos 150 KB) y la foto del caso A no hacen falta para el logo: bajan al
      // primer scroll o, después de la carga y de un cuadro pintado, cuando el navegador queda libre. Así
      // lo único que compite con el titular son las fuentes (Lighthouse móvil: LCP 3.2 s → 2.1 s).
      let loading: Promise<void> | null = null;
      const ensure = () => (loading ??= load().then(kick));
      const idle = () => {
        if ("requestIdleCallback" in window) requestIdleCallback(() => void ensure(), { timeout: 2500 });
        else setTimeout(() => void ensure(), 1200);
      };
      const later = () => requestAnimationFrame(() => setTimeout(idle, 0));
      if (document.readyState === "complete") later();
      else window.addEventListener("load", later, { once: true });
      window.addEventListener(
        "scroll",
        () => {
          void ensure();
          kick();
        },
        { passive: true },
      );
      new ResizeObserver(() => {
        top();
        measure();
        kick();
      }).observe(stage);
      // Ir a una escena: el scroll la deja con su dibujo completo.
      goto = (i: number) => {
        const k = Math.max(0, Math.min(N - 1, i));
        const span = track.offsetHeight - stage.offsetHeight;
        const start = window.scrollY + track.getBoundingClientRect().top - topPx;
        window.scrollTo({ top: start + (k === 0 ? 0 : ((k + 0.8) / N) * span), behavior: "smooth" });
      };
      dots.forEach((b) => b.addEventListener("click", () => goto(Number(b.dataset.goto))));
      for (const b of steps)
        b.addEventListener("click", () => {
          if (b.getAttribute("aria-disabled") !== "true") goto(active + Number(b.dataset.step));
        });
      $("[data-start]")?.addEventListener("click", () => goto(1));
      // Con el escenario fijo, las flechas ← y → del teclado pasan de escena (fuera de los deslizadores).
      window.addEventListener("keydown", (e) => {
        if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        if ((e.target as Element | null)?.closest?.("input, textarea, select, [contenteditable]")) return;
        const r = track.getBoundingClientRect();
        if (r.top > topPx + 2 || r.bottom < topPx + stage.offsetHeight - 2) return;
        e.preventDefault();
        goto(active + (e.key === "ArrowRight" ? 1 : -1));
      });
      // Atajos en el lienzo: el cursor de mano donde se puede tocar.
      const hitAt = (e: MouseEvent) => {
        const r = canvas.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        return hits.find((h) => x >= h.x && x <= h.x + h.w && y >= h.y && y <= h.y + h.h);
      };
      canvas.addEventListener("pointermove", (e) => {
        canvas.style.cursor = hitAt(e) ? "pointer" : "";
      });
      canvas.addEventListener("click", (e) => hitAt(e)?.go());
    } else if (reduce) {
      // Sin movimiento: cada escena con su dibujo final, quieto; los controles lo vuelven a dibujar.
      const still = (i: number) => {
        const li = scenes[i];
        if (!li) return;
        let cv = li.querySelector<HTMLCanvasElement>(".pt__still");
        if (!cv) {
          cv = document.createElement("canvas");
          cv.className = "pt__still";
          cv.setAttribute("aria-hidden", "true");
          li.append(cv);
        }
        const r = cv.getBoundingClientRect();
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        cv.width = Math.round(r.width * dpr);
        cv.height = Math.round(r.height * dpr);
        const g = cv.getContext("2d");
        if (!g) return;
        g.setTransform(dpr, 0, 0, dpr, 0, 0);
        const pad = r.width * 0.06;
        SCENES[i]?.(g, { x: pad, y: pad, w: r.width - pad * 2, h: r.height - pad * 2 }, 1, 99999);
      };
      repaint = still;
      $("[data-start]")?.addEventListener("click", () => scenes[1]?.scrollIntoView());
      void load().then(() => {
        if (undoIn) undoIn.value = "-5";
        outputs();
        const draws = () => {
          fonts();
          scenes.forEach((_, i) => still(i));
        };
        if (photo.complete) draws();
        else photo.addEventListener("load", draws, { once: true });
        draws();
      });
    }
  }
</script>
