    gap: 8px;
    align-content: start;
    margin: 0;
  }

  .fh__photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 3px;
  }

  .fh__photo figcaption {
    font-size: var(--step-small);
    color: var(--claro-tenue);
  }

  :global(.js) .fh__photo--b:not(.is-active) {
    display: none;
  }

  .fh__canvas {
    display: none;
  }

  :global(.js) .fh__canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  .fh__count {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    margin: 0;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgb(20 14 10 / 0.82);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 700;
    pointer-events: none;
  }

  .fh__count:empty {
    display: none;
  }

  @media (min-width: 720px) {
    .fh__stage {
      padding: 20px 22px 16px;
    }

    .fh__photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
      row-gap: 28px;
    }

    .fh__count {
      top: 10px;
      left: 10px;
    }
  }

  /* ---------- Los pasos ---------- */

  .fh__player {
    display: grid;
    gap: 6px;
    margin-top: 20px;
  }

  .fh__steps {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fh__step {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 8px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 700;
    text-align: start;
  }

  .fh__n {
    flex: none;
    color: var(--ocre);
  }

  .fh__step-text {
    margin: 2px 0 0;
    color: var(--claro-tenue);
  }

  .fh__prog,
  .fh__now {
    display: none;
  }

  :global(.js) .fh__steps {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
  }

  :global(.js) .fh__step {
    padding: 12px 0 6px;
    color: var(--claro-tenue);
    font-size: var(--step-small);
    line-height: 1.25;
    cursor: pointer;
  }

  :global(.js) .fh__step:hover {
    color: var(--fondo);
  }

  :global(.js) .fh__step[aria-current="step"] {
    color: var(--fondo);
  }

  :global(.js) .fh__step:focus-visible {
    outline: 3px solid var(--ocre);
    outline-offset: 2px;
    border-radius: 4px;
  }

  :global(.js) .fh__prog {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    display: block;
    height: 3px;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.16);
  }

  :global(.js) .fh__prog::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--ocre);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }

  :global(.js) .fh__step-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  :global(.js) .fh__now {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px 20px;
  }

  .fh__caption {
    display: grid;
    flex: 1 1 32rem;
    max-width: 72ch;
    color: var(--claro-tenue);
  }

  .fh__cap {
    grid-area: 1 / 1;
    margin: 0;
    visibility: hidden;
  }

  .fh__cap.is-on {
    visibility: visible;
  }

  .fh__verdicts {
    display: grid;
    margin-top: 8px;
  }

  .fh__cap-v {
    grid-area: 1 / 1;
    visibility: hidden;
  }

  .fh__cap.is-on .fh__cap-v.is-on {
    visibility: visible;
  }

  .fh__caption strong {
    margin-right: 0.4em;
    color: var(--fondo);
  }

  .fh__cap-verdict {
    display: inline-block;
    padding: 1px 10px;
    border-radius: 999px;
    background: var(--claro-tenue);
    color: var(--noche);
    font-weight: 700;
  }

  .fh__cap-verdict[data-kind="probable"] {
    background: var(--verde-suave);
    color: var(--verde);
  }

  /* La misma foto: no hay veredicto de Muse Spark, es una frase. */
  .fh__cap-verdict[data-kind="misma_foto"] {
    display: inline;
    padding: 0;
    background: none;
    color: var(--fondo);
  }

  .fh__replay {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 999px;
    background: none;
    color: var(--fondo);
    font: inherit;
    font-size: var(--step-small);
    font-weight: 700;
    white-space: nowrap;
    cursor: pointer;
    /* Ocupa su lugar desde el principio: al aparecer no empuja nada. */
    visibility: hidden;
  }

  .fh__replay.is-on {
    visibility: visible;
  }

  .fh__replay :global(.icon) {
    flex: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fh__replay:hover {
    border-color: var(--fondo);
  }

  .fh__replay:focus-visible {
    outline: 3px solid var(--ocre);
    outline-offset: 2px;
  }

  @media (max-width: 719px) {
    :global(.js) .fh__step-title {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    :global(.js) .fh__step {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fh__replay {
      display: none;
    }
  }

  /* ---------- Lo que dicen las cifras y Muse Spark ---------- */

  .fh__hint {
    margin: -4px 0 0;
  }

  .fh__panel {
    display: grid;
    gap: 20px;
    margin-top: 12px;
  }

  .fh__panel:focus-visible {
    outline: 3px solid var(--terracota);
    outline-offset: 6px;
    border-radius: 8px;
  }

  :global(.js) .fh__panel:not(.is-active) {
    display: none;
  }

  .fh__panel-title {
    margin: 0 0 8px;
    font-family: var(--display);
    font-size: 1.125rem;
    font-weight: 650;
  }

  :global(.js) .fh__panel-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .fh__explain {
    max-width: 62ch;
    margin: 0 0 16px;
  }

  .fh__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
  }

  .fh__stats > div {
    padding: 10px 12px;
    border: 1px solid var(--linea);
    border-radius: var(--r-s);
    background: var(--papel);
  }

  .fh__stats dt {
    font-size: var(--step-small);
    color: var(--ink-2);
  }

  .fh__stats dd {
    margin: 2px 0 0;
    font-family: var(--display);
    font-size: 1.0625rem;
    font-weight: 650;
  }

  .fh__sys.is-on dd {
    color: var(--verde);
  }

  /* En el celular, las cuatro cifras en filas: dato a la izquierda, valor a la derecha. */
  @media (max-width: 719px) {
    .fh__stats {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      border: 1px solid var(--linea);
      border-radius: var(--r-s);
      background: var(--papel);
    }

    .fh__stats > div {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      border: 0;
      border-top: 1px solid var(--linea);
      border-radius: 0;
      background: none;
    }

    .fh__stats > div:first-child {
      border-top: 0;
    }

    .fh__stats dd {
      margin: 0;
      font-size: 1rem;
      text-align: end;
    }
  }

  .fh__vlm {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 16px 18px;
    border: 1px solid var(--linea);
    border-radius: var(--r-m);
    background: var(--papel);
  }

  .fh__vlm-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin: 0;
  }

  .fh__vlm-name {
    font-weight: 700;
  }

  .fh__verdict {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--fondo-2);
    color: var(--tinta);
    font-size: var(--step-small);
  }

  .fh__verdict.is-probable {
    background: var(--verde-suave);
    color: var(--verde);
  }

  .fh__chips-label {
    margin: 6px 0 0;
    font-size: var(--step-small);
    font-weight: 700;
    color: var(--ink-2);
  }

  .fh__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fh__chips li {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--ocre-suave);
    color: var(--tinta);
    font-size: var(--step-small);
    line-height: 1.35;
  }

  .fh__chips--diff li {
    background: var(--fondo-2);
  }

  .fh__vlm-cols {
    display: grid;
    gap: 8px;
  }

  .fh__vlm-cols > div {
    display: grid;
    gap: 6px;
    align-content: start;
  }

  .fh__quote {
    margin: 6px 0 0;
    padding-left: 12px;
    border-left: 3px solid var(--linea-2);
    color: var(--ink-2);
    font-size: var(--step-small);
  }

  @media (min-width: 900px) {
    .fh__panel {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: 40px;
      align-items: start;
    }
  }

  @media (min-width: 1100px) {
    .fh__panel {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .fh__vlm-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 20px;
    }

    .fh__foot {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 56px;
    }
  }

  .fh__foot {
    display: grid;
    gap: 8px;
    margin-top: 28px;
  }

  .fh__note {
    max-width: 75ch;
    margin: 0;
  }
</style>

<script>
  type Pair = {
    a: string;
    b: string;
    con_pareja: number;
    mejor_a: string;
    mejor_b: string;
    pareja_a: string;
    pareja_b: string;
    lineas: number[][];
  };
  type Demo = {
    grid: { cols: number; rows: number };
    umbral_pareja: number;
    pix: Record<string, string>;
    pca: Record<string, string>;
    pares: Pair[];
  };
  type Side = {
    pix: Uint8Array;
    pca: Uint8Array;
    sim: Float32Array;
    part: Int16Array;
    turn: Float32Array;
  };
  type Line = [number, number, number];
  type Prep = { a: Side; b: Side; matched: number; lines: Line[]; tour: Line[] };
  type Rect = { x: number; y: number; w: number; h: number };

  /** Duración de cada paso (ms): parches, colores, parejas, líneas (y la lupa), Muse Spark. */
  const LINES = 1800;
  const LOUPE = 900;
  const LOUPES = 3;
  const DUR = [1300, 1700, 2500, LINES + LOUPE * LOUPES + 200, 1100];
  const START = DUR.map((_, i) => DUR.slice(0, i).reduce((s, x) => s + x, 0));
  const END = START[4]! + DUR[4]!;
  const SWEEP = 900;
  const TURN = 2000;
  const DARK = [18, 12, 9];

  const clamp = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x);
  const ease = (x: number) => 1 - (1 - x) ** 3;
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  /** Un número fijo entre 0 y 1 por parche, para que los colores cambien en desorden. */
  const rnd = (k: number) => (((k + 1) * 2654435761) >>> 0) / 4294967296;
  const bytes = (s: string) =>
    Uint8Array.from({ length: s.length / 2 }, (_, i) => parseInt(s.slice(i * 2, i * 2 + 2), 16));
  const digits = (s: string, w: number) =>
    Array.from({ length: s.length / w }, (_, i) => Number(s.slice(i * w, i * w + w)));

  function side(pix: string, pca: string, sim: string, part: string): Side {
    const s = Float32Array.from(digits(sim, 2), (v) => v / 100);
    // El turno de cada parche en el paso 3: primero los más parecidos.
    const order = Array.from(s.keys()).sort((x, y) => s[y]! - s[x]!);
    const turn = new Float32Array(s.length);
    order.forEach((k, r) => (turn[k] = r / s.length));
    return { pix: bytes(pix), pca: bytes(pca), sim: s, part: Int16Array.from(digits(part, 3)), turn };
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-fotos]")) {
    const photos = root.querySelector<HTMLElement>("[data-photos]")!;
    const canvas = root.querySelector<HTMLCanvasElement>("[data-canvas]")!;
    const ctx = canvas.getContext("2d");
    if (!ctx) continue;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const figsB = [...root.querySelectorAll<HTMLElement>("[data-b]")];
    const steps = [...root.querySelectorAll<HTMLButtonElement>("[data-step]")];
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const caps = [...root.querySelectorAll<HTMLElement>("[data-cap]")];
    const verdicts = [...root.querySelectorAll<HTMLElement>("[data-cap-verdict]")];
    const replay = root.querySelector<HTMLButtonElement>("[data-replay]")!;
    const hint = root.querySelector<HTMLElement>("[data-hint]")!;
    const countTpl = count.dataset.tpl ?? "";
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    let data: Demo | null = null;
    let prep: Prep | null = null;
    let pair = 0;
    let t = 0;
    let shown = false;
    let raf = 0;
    let hover: { side: "a" | "b"; k: number } | null = null;
    let rects: { a: Rect; b: Rect; across: boolean } | null = null;
    let cssW = 0;
    let cssH = 0;
    let font = "sans-serif";
    let lastStep = -1;
    let lastCount = "";

    steps.forEach((b) => (b.disabled = false));

    const prepare = () => {
      if (!data) return;
      const par = data.pares[pair]!;
      const a = side(data.pix[par.a]!, data.pca[par.a]!, par.mejor_a, par.pareja_a);
      const b = side(data.pix[par.b]!, data.pca[par.b]!, par.mejor_b, par.pareja_b);
      const lines = par.lineas as Line[];
      // La lupa visita parejas de zonas distintas de la foto A.
      const C = data.grid.cols;
      const far = (x: number, y: number) =>
        Math.max(Math.abs((x % C) - (y % C)), Math.abs(Math.floor(x / C) - Math.floor(y / C))) >= 6;
      const tour: Line[] = [];
      for (const l of lines) {
        if (tour.length < LOUPES && tour.every((o) => far(o[0], l[0]))) tour.push(l);
      }
      prep = { a, b, matched: par.con_pareja, lines, tour };
    };

    const imgA = root.querySelector<HTMLImageElement>('[data-img="a"]')!;
    let imgB = figsB[0]!.querySelector<HTMLImageElement>('[data-img="b"]')!;
    const measure = () => {
      const box = photos.getBoundingClientRect();
      imgB = figsB[pair]!.querySelector<HTMLImageElement>('[data-img="b"]')!;
      const rel = (el: HTMLElement): Rect => {
        const r = el.getBoundingClientRect();
        return { x: r.left - box.left, y: r.top - box.top, w: r.width, h: r.height };
      };
      const a = rel(imgA);
      const b = rel(imgB);
      rects = { a, b, across: b.x > a.x + a.w / 2 };
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      cssW = box.width;
      cssH = box.height;
      canvas.width = Math.round(cssW * dpr);
      canvas.height = Math.round(cssH * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      font = getComputedStyle(root).fontFamily;
    };

    const center = (r: Rect, k: number, C: number, R: number) => ({
      x: r.x + ((k % C) + 0.5) * (r.w / C),
      y: r.y + (Math.floor(k / C) + 0.5) * (r.h / R),
    });

    /** Curva entre dos puntos: se arquea hacia afuera, alternando el lado. */
    const curve = (p0: { x: number; y: number }, p1: { x: number; y: number }, bend: number) => {
      const mx = (p0.x + p1.x) / 2;
      const my = (p0.y + p1.y) / 2;
      const dx = p1.x - p0.x;
      const dy = p1.y - p0.y;
      return { x: mx - dy * bend, y: my + dx * bend };
    };

    const strokeCurve = (
      p0: { x: number; y: number },
      c: { x: number; y: number },
      p1: { x: number; y: number },
      u: number,
    ) => {
      ctx.beginPath();
      ctx.moveTo(p0.x, p0.y);
      const n = Math.max(2, Math.ceil(24 * u));
      for (let i = 1; i <= n; i++) {
        const s = (i / n) * u;
        const x = (1 - s) * (1 - s) * p0.x + 2 * (1 - s) * s * c.x + s * s * p1.x;
        const y = (1 - s) * (1 - s) * p0.y + 2 * (1 - s) * s * c.y + s * s * p1.y;
        ctx.lineTo(x, y);
      }
      ctx.stroke();
    };

    /**
     * Un parche y sus vecinos (3 × 3), recortados de la foto, para la lupa; el parche, marcado. Cerca
     * del borde, el recorte se corre hacia adentro y la marca lo sigue.
     */
    const tile = (img: HTMLImageElement, k: number, C: number, R: number, x: number, y: number, size: number) => {
      if (!img.complete || !img.naturalWidth) return;
      const sw = img.naturalWidth / C;
      const sh = img.naturalHeight / R;
      const col = k % C;
      const row = Math.floor(k / C);
      const c0 = Math.min(C - 3, Math.max(0, col - 1));
      const r0 = Math.min(R - 3, Math.max(0, row - 1));
      ctx.save();
      ctx.beginPath();
      ctx.roundRect(x, y, size, size, 6);
      ctx.clip();
      ctx.imageSmoothingEnabled = true;
      ctx.drawImage(img, c0 * sw, r0 * sh, sw * 3, sh * 3, x, y, size, size);
      ctx.restore();
      const cell = size / 3;
      ctx.lineWidth = 2;
      ctx.strokeStyle = "#fff";
      ctx.strokeRect(x + (col - c0) * cell, y + (row - r0) * cell, cell, cell);
    };

    /**
     * La lupa: los dos parches ampliados, uno al lado del otro, y cuánto se parecen. Va en el medio de
     * la curva que los une, dentro del dibujo.
     */
    const loupe = (ka: number, kb: number, sim: number, alpha: number, C: number, R: number, U: number) => {
      if (!rects || alpha <= 0) return;
      const { a: ra, b: rb } = rects;
      const p0 = center(ra, ka, C, R);
      const p1 = center(rb, kb, C, R);
      const cwA = ra.w / C;
      const chA = ra.h / R;
      const cwB = rb.w / C;
      const chB = rb.h / R;
      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.lineWidth = 2;
      ctx.strokeStyle = "#fff";
      ctx.strokeRect(ra.x + (ka % C) * cwA - 1, ra.y + Math.floor(ka / C) * chA - 1, cwA + 2, chA + 2);
      ctx.strokeRect(rb.x + (kb % C) * cwB - 1, rb.y + Math.floor(kb / C) * chB - 1, cwB + 2, chB + 2);
      ctx.setLineDash(sim >= U ? [] : [5, 5]);
      ctx.lineWidth = 1.5;
      strokeCurve(p0, curve(p0, p1, rects.across ? -0.08 : -0.12), p1, 1);
      ctx.setLineDash([]);

      const size = cssW < 600 ? 78 : 102;
      const label = sim.toFixed(2);
      ctx.font = `700 ${cssW < 600 ? 14 : 16}px ${font}`;
      const lw = Math.max(52, ctx.measureText(label).width + 20);
      const pad = 7;
      const w = size * 2 + lw + pad * 2;
      const h = size + pad * 2;
      const mx = Math.min(cssW - w - 6, Math.max(6, (p0.x + p1.x) / 2 - w / 2));
      const my = Math.min(cssH - h - 6, Math.max(6, (p0.y + p1.y) / 2 - h / 2));
      ctx.fillStyle = "rgb(18 12 9 / 0.94)";
      ctx.strokeStyle = "rgb(255 255 255 / 0.35)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.roundRect(mx, my, w, h, 10);
      ctx.fill();
      ctx.stroke();
      tile(imgA, ka, C, R, mx + pad, my + pad, size);
      tile(imgB, kb, C, R, mx + pad + size + lw, my + pad, size);
      ctx.fillStyle = sim >= U ? "#e7ad45" : "#fff";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(label, mx + pad + size + lw / 2, my + h / 2 + 0.5);
      ctx.restore();
    };

    const draw = () => {
      ctx.clearRect(0, 0, cssW, cssH);
      if (!data || !prep || !rects) return;
      const C = data.grid.cols;
      const R = data.grid.rows;
      const N = C * R;
      const U = data.umbral_pareja;
      const sides = [
        { r: rects.a, s: prep.a },
        { r: rects.b, s: prep.b },
      ];
      const f5 = clamp((t - START[4]!) / 700);

      // 1-3: cada parche, su color y su estado.
      sides.forEach(({ r, s }, si) => {
        const cw = r.w / C;
        const ch = r.h / R;
        for (let k = 0; k < N; k++) {
          const col = k % C;
          const row = (k / C) | 0;
          const q1 = clamp((t - START[0]! - (col / C) * SWEEP) / 260);
          if (q1 <= 0) continue;
          let rr = s.pix[k * 3]!;
          let gg = s.pix[k * 3 + 1]!;
          let bb = s.pix[k * 3 + 2]!;
          let a = q1;
          const m = ease(clamp((t - START[1]! - rnd(k + si * 997) * 1100) / 420));
          if (m > 0) {
            rr = lerp(rr, s.pca[k * 3]!, m);
            gg = lerp(gg, s.pca[k * 3 + 1]!, m);
            bb = lerp(bb, s.pca[k * 3 + 2]!, m);
          }
          let edge = 0;
          const r3 = ease(clamp((t - START[2]! - s.turn[k]! * TURN) / 340));
          if (r3 > 0) {
            if (s.sim[k]! >= U) {
              a *= 1 - r3;
              edge = r3 * (0.18 + 0.6 * clamp((s.sim[k]! - U) / 0.2));
            } else {
              rr = lerp(rr, DARK[0]!, r3);
              gg = lerp(gg, DARK[1]!, r3);
              bb = lerp(bb, DARK[2]!, r3);
              a = lerp(a, 0.8, r3);
            }
          }
          if (f5 > 0) edge *= 1 - 0.45 * f5;
          const x = r.x + col * cw;
          const y = r.y + row * ch;
          if (a > 0.004) {
            ctx.fillStyle = `rgb(${rr | 0} ${gg | 0} ${bb | 0} / ${a.toFixed(3)})`;
            ctx.fillRect(x + 0.5, y + 0.5, cw - 1, ch - 1);
          }
          if (edge > 0.01) {
            ctx.strokeStyle = `rgb(231 173 69 / ${edge.toFixed(3)})`;
            ctx.lineWidth = 1;
            ctx.strokeRect(x + 1, y + 1, cw - 2, ch - 2);
          }
        }

        // La línea que barre la foto al cortarla en parches.
        const sweep = (t - START[0]!) / SWEEP;
        if (sweep > 0 && sweep < 1.25) {
          const xs = r.x + Math.min(1, sweep) * r.w;
          const fade = sweep > 1 ? 1 - (sweep - 1) / 0.25 : 1;
          const g = ctx.createLinearGradient(xs - 40, 0, xs, 0);
          g.addColorStop(0, "rgb(231 173 69 / 0)");
          g.addColorStop(1, `rgb(231 173 69 / ${(0.45 * fade).toFixed(3)})`);
          ctx.fillStyle = g;
          ctx.fillRect(Math.max(r.x, xs - 40), r.y, Math.min(40, xs - r.x), r.h);
          ctx.fillStyle = `rgb(255 236 200 / ${(0.9 * fade).toFixed(3)})`;
          ctx.fillRect(Math.min(xs, r.x + r.w - 2), r.y, 2, r.h);
        }
      });

      const { a: ra, b: rb } = rects;
      const cwB = rb.w / C;
      const chB = rb.h / R;

      // 3: chispas de cada parche a su pareja mientras se encienden.
      if (t > START[2]! && t < START[3]! + 400) {
        ctx.lineWidth = 1;
        for (let k = 0; k < N; k++) {
          if (prep.a.sim[k]! < U) continue;
          const life = (t - START[2]! - prep.a.turn[k]! * TURN) / 520;
          if (life <= 0 || life >= 1) continue;
          const j = prep.a.part[k]!;
          const p0 = center(ra, k, C, R);
          const p1 = center(rb, j, C, R);
          const al = (1 - life) * 0.55;
          ctx.strokeStyle = `rgb(255 222 160 / ${al.toFixed(3)})`;
          ctx.beginPath();
          ctx.moveTo(p0.x, p0.y);
          ctx.lineTo(lerp(p0.x, p1.x, ease(Math.min(1, life * 2))), lerp(p0.y, p1.y, ease(Math.min(1, life * 2))));
          ctx.stroke();
          ctx.strokeStyle = `rgb(255 236 200 / ${(1 - life).toFixed(3)})`;
          ctx.strokeRect(rb.x + (j % C) * cwB + 0.5, rb.y + Math.floor(j / C) * chB + 0.5, cwB - 1, chB - 1);
        }
      }

      // 4: las parejas mutuas, una curva por pareja.
      const L = prep.lines.length;
      if (t > START[3]! && L) {
        const gap = Math.min(110, (LINES - 500) / L);
        prep.lines.forEach(([i, j, sim], li) => {
          const u = ease(clamp((t - START[3]! - li * gap) / 480));
          if (u <= 0) return;
          const p0 = center(ra, i, C, R);
          const p1 = center(rb, j, C, R);
          const c = curve(p0, p1, rects!.across ? (li % 2 ? 0.08 : -0.08) : li % 2 ? 0.12 : -0.12);
          const s = clamp((sim - U) / 0.25);
          const al = (0.55 + 0.45 * s) * (1 - 0.25 * f5);
          ctx.strokeStyle = `rgb(231 173 69 / ${al.toFixed(3)})`;
          ctx.lineWidth = 1.6;
          strokeCurve(p0, c, p1, u);
          ctx.fillStyle = `rgb(255 236 200 / ${al.toFixed(3)})`;
          ctx.beginPath();
          ctx.arc(p0.x, p0.y, 2.6, 0, Math.PI * 2);
          ctx.fill();
          if (u >= 1) {
            ctx.beginPath();
            ctx.arc(p1.x, p1.y, 2.6, 0, Math.PI * 2);
            ctx.fill();
          }
        });
      }

      // 4: la lupa recorre algunas parejas.
      if (!hover && t > START[3]! + LINES && t < START[4]!) {
        const n = Math.floor((t - START[3]! - LINES) / LOUPE);
        const l = prep.tour[n];
        if (l) {
          const u = (t - START[3]! - LINES - n * LOUPE) / LOUPE;
          loupe(l[0], l[1], l[2], clamp(Math.min(u / 0.15, (1 - u) / 0.15)), C, R, U);
        }
      }

      // 5: Muse Spark mira las dos fotos enteras: una luz que las recorre.
      const look = (t - START[4]!) / 900;
      if (look > 0 && look < 1) {
        for (const r of [ra, rb]) {
          const xs = r.x + ease(look) * (r.w + 120) - 60;
          const g = ctx.createLinearGradient(xs - 60, 0, xs + 60, 0);
          g.addColorStop(0, "rgb(255 255 255 / 0)");
          g.addColorStop(0.5, `rgb(255 255 255 / ${(0.22 * (1 - look)).toFixed(3)})`);
          g.addColorStop(1, "rgb(255 255 255 / 0)");
          ctx.save();
          ctx.beginPath();
          ctx.rect(r.x, r.y, r.w, r.h);
          ctx.clip();
          ctx.fillStyle = g;
          ctx.fillRect(xs - 60, r.y, 120, r.h);
          ctx.restore();
        }
      }

      // El puntero: un parche, su pareja en la otra foto y cuánto se parecen.
      if (hover) {
        const ka = hover.side === "a" ? hover.k : prep.b.part[hover.k]!;
        const kb = hover.side === "a" ? prep.a.part[hover.k]! : hover.k;
        const sim = hover.side === "a" ? prep.a.sim[hover.k]! : prep.b.sim[hover.k]!;
        loupe(ka, kb, sim, 1, C, R, U);
      }
    };

    /** Los pasos, el texto del paso y el contador, según el tiempo. */
    const ui = () => {
      let step = 0;
      START.forEach((s, i) => {
        if (t >= s) step = i;
      });
      steps.forEach((b, i) => {
        b.style.setProperty("--p", String(clamp((t - START[i]!) / DUR[i]!)));
        if (i === step) b.setAttribute("aria-current", "step");
        else b.removeAttribute("aria-current");
      });
      if (step !== lastStep) {
        lastStep = step;
        caps.forEach((c, i) => c.classList.toggle("is-on", i === step));
      }
      const showVerdict = step === 4 && t >= START[4]! + 600;
      verdicts.forEach((v, j) => v.classList.toggle("is-on", showVerdict && j === pair));
      let txt = "";
      if (prep && t >= START[2]!) {
        const n = Math.min(prep.matched, Math.floor(((t - START[2]!) / TURN) * prep.a.sim.length) + 1);
        txt = countTpl.replace("{n}", String(Math.max(0, n)));
      }
      if (txt !== lastCount) {
        lastCount = txt;
        count.textContent = txt;
      }
    };

    const render = () => {
      draw();
      ui();
    };

    let from = 0;
    let to = END;
    let t0 = 0;
    const tick = (now: number) => {
      t = Math.min(to, from + (now - t0));
      render();
      raf = t < to ? requestAnimationFrame(tick) : 0;
    };
    const play = (a: number, b: number) => {
      cancelAnimationFrame(raf);
      if (reduce.matches) {
        t = b;
        render();
        return;
      }
      from = a;
      to = b;
      t0 = performance.now();
      raf = requestAnimationFrame(tick);
    };

    const load = async () => {
      if (data) return;
      data = (await import("../data/fotos-demo.json")).default as unknown as Demo;
      prepare();
      measure();
      render();
    };

    const start = async () => {
      await load();
      shown = true;
      replay.classList.add("is-on");
      hint.hidden = false;
      play(0, END);
    };

    const select = (i: number, focus: boolean) => {
      pair = i;
      tabs.forEach((tab, j) => {
        const on = j === i;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[j]?.classList.toggle("is-active", on);
        figsB[j]?.classList.toggle("is-active", on);
      });
      if (focus) {
        tabs[i]?.focus();
        tabs[i]?.scrollIntoView({ block: "nearest", inline: "nearest" });
      }
      hover = null;
      prepare();
      measure();
      if (shown) play(0, END);
      else render();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i, false));
      tab.addEventListener("keydown", (e) => {
        const last = tabs.length - 1;
        const keys: Record<string, number> = {
          ArrowRight: i === last ? 0 : i + 1,
          ArrowLeft: i === 0 ? last : i - 1,
          Home: 0,
          End: last,
        };
        if (!(e.key in keys)) return;
        e.preventDefault();
        select(keys[e.key]!, true);
      });
    });

    steps.forEach((b, i) =>
      b.addEventListener("click", async () => {
        await load();
        shown = true;
        replay.classList.add("is-on");
        hint.hidden = false;
        play(START[i]!, START[i]! + DUR[i]!);
      }),
    );
    replay.addEventListener("click", () => play(0, END));

    // El puntero sobre un parche de cualquiera de las dos fotos.
    const pick = (e: PointerEvent) => {
      if (!rects || !data) return;
      const box = photos.getBoundingClientRect();
      const x = e.clientX - box.left;
      const y = e.clientY - box.top;
      const C = data.grid.cols;
      const R = data.grid.rows;
      let next: typeof hover = null;
      for (const s of ["a", "b"] as const) {
        const r = rects[s];
        if (x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h) {
          next = { side: s, k: Math.floor(((y - r.y) / r.h) * R) * C + Math.floor(((x - r.x) / r.w) * C) };
        }
      }
      if (next?.k === hover?.k && next?.side === hover?.side) return;
      hover = next;
      if (!raf) draw();
    };
    canvas.addEventListener("pointermove", pick);
    canvas.addEventListener("pointerdown", pick);
    // Con el dedo, la lupa se queda hasta el próximo toque (al levantarlo también llega pointerleave).
    canvas.addEventListener("pointerleave", (e) => {
      if (e.pointerType === "touch") return;
      hover = null;
      if (!raf) draw();
    });

    new ResizeObserver(() => {
      if (!data) return;
      measure();
      render();
    }).observe(photos);

    if (reduce.matches) t = END;
    if (!("IntersectionObserver" in window)) {
      void start();
      continue;
    }
    const near = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          near.disconnect();
          void load();
        }
      },
      { rootMargin: "600px 0px" },
    );
    near.observe(photos);
    const seen = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          seen.disconnect();
          void start();
        }
      },
      { threshold: 0.45 },
    );
    seen.observe(photos);
  }
</script>
