---
/**
 * Otro ángulo, la misma colcha: tres pares de fotos ficticias (Muse Image) comparadas parche por
 * parche con DINOv2 y miradas por Muse Spark. Un <canvas> encima de las fotos dibuja cinco pasos:
 * 1) la foto en 24 × 16 parches (su color promedio), 2) el vector de cada parche como color (PCA
 * conjunta de las tres fotos), 3) cada parche busca pareja en la otra foto y se enciende o se apaga,
 * 4) las parejas mutuas (líneas), 5) Muse Spark mira las dos fotos enteras.
 * Datos: src/data/fotos-demo.json (eval/py/blindaje_eval/fotos_huella.py y eval/src/fotos-colcha.ts).
 * Las cifras del texto se llenan aquí; el dibujo carga el JSON aparte cuando la sección se acerca.
 *
 * Sin JavaScript se ven las cuatro fotos, los pasos y los tres resultados. Con movimiento reducido,
 * el estado final sin animación; los pasos y el puntero siguen funcionando.
 */
import { Image } from "astro:assets";
import type { Dict } from "../i18n";
import demo from "../data/fotos-demo.json";
import Icon from "./Icon.astro";
import colcha1 from "../assets/fotos-huella/colcha-1.jpg";
import colcha2 from "../assets/fotos-huella/colcha-2.jpg";
import otra1 from "../assets/fotos-huella/otra-1.jpg";
import reenviada from "../assets/fotos-huella/colcha-1-reenviada.jpg";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const p = d.lp.photos;
const es = d.lang === "es";

const fotosB = [colcha2, otra1, reenviada];
const total = demo.grid.cols * demo.grid.rows;
const dec = (x: number) => x.toFixed(2);
const fill = (s: string, tokens: Record<string, string | number>) =>
  s.replace(/\{(\w+)\}/g, (m, k: string) => (k in tokens ? String(tokens[k]) : m));

const base = { total, umbral: dec(demo.umbral_pareja) };
const pares = demo.pares.map((par) => {
  const tokens = {
    ...base,
    cos: dec(par.coseno),
    ham: par.hamming,
    n: par.con_pareja,
    p: dec(par.p_imagen),
  };
  const vlm = "vlm" in par ? par.vlm : undefined;
  return { par, tokens, vlm, une: par.p_imagen >= 0.5 };
});
const verdict = (v?: { mismo_lugar: string }) =>
  v ? `${p.vlm}: ${p.verdicts[v.mismo_lugar as keyof typeof p.verdicts]}` : p.noVlm;
const sizes = "(min-width: 1360px) 620px, (min-width: 720px) 46vw, 100vw";
/** Las respuestas de Muse Spark están en español: en la página en inglés se marcan con lang. */
const vlmLang = es ? undefined : "es";
---

<section class="section fotos" id="fotos" aria-labelledby="fotos-title">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <h2 id="fotos-title" class="head">
        {p.title}
      </h2>
      <p class="lead soft">{p.lead}</p>
    </div>

    <div class="fh" data-fotos>
      <div class="fh__tabs" role="tablist" aria-label={p.pairsLabel}>
        {p.pairs.map((label, i) => (
          <button
            type="button"
            class="fh__tab"
            role="tab"
            id={`fh-tab-${i}`}
            aria-controls={`fh-panel-${i}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >
            {label}
          </button>
        ))}
      </div>

      <div class="fh__stage">
        <div class="fh__photos" data-photos>
          <figure class="fh__photo fh__photo--a">
            <Image src={colcha1} alt={p.alt[0]} widths={[480, 720, 960]} sizes={sizes} data-img="a" />
            <figcaption>{p.photoA}</figcaption>
            <p class="fh__count num" aria-hidden="true" data-count data-tpl={fill(p.count, base)}></p>
          </figure>
          {fotosB.map((img, i) => (
            <figure class:list={["fh__photo", "fh__photo--b", i === 0 && "is-active"]} data-b={i}>
              <Image
                src={img}
                alt={p.alt[i + 1]!}
                widths={[480, 720, 960]}
                sizes={sizes}
                loading={i === 0 ? "eager" : "lazy"}
                data-img="b"
              />
              <figcaption>{p.photoB[i]}</figcaption>
            </figure>
          ))}
          <canvas class="fh__canvas" aria-hidden="true" data-canvas></canvas>
        </div>

        <div class="fh__player">
          <ol class="fh__steps" aria-label={p.stepsLabel}>
            {p.steps.map((s, i) => (
              <li class="fh__step-item">
                <button type="button" class="fh__step" data-step={i} disabled>
                  <span class="fh__prog" aria-hidden="true" />
                  <span class="fh__n num">{i + 1}</span>
                  <span class="fh__step-title">{s.title}</span>
                </button>
                <p class="fh__step-text">{fill(s.text, base)}</p>
              </li>
            ))}
          </ol>
          <div class="fh__now">
            <div class="fh__caption" aria-hidden="true">
              {p.steps.map((s, i) => (
                <p class:list={["fh__cap", i === 0 && "is-on"]} data-cap>
                  <strong>{s.title}</strong>
                  {fill(s.text, base)}
                  {i === 4 && (
                    <span class="fh__verdicts">
                      {pares.map(({ vlm }, j) => (
                        <span class="fh__cap-v" data-cap-verdict={j}>
                          <span class="fh__cap-verdict" data-kind={vlm?.mismo_lugar ?? "misma_foto"}>
                            {verdict(vlm)}
                          </span>
                        </span>
                      ))}
                    </span>
                  )}
                </p>
              ))}
            </div>
            <button type="button" class="fh__replay" data-replay>
              <Icon name="restart" />
              {p.replay}
            </button>
          </div>
        </div>
      </div>

      <p class="fh__hint cap" data-hint hidden>
        {p.hover}
      </p>

      {pares.map(({ par, tokens, vlm, une }, i) => (
        <div
          class:list={["fh__panel", i === 0 && "is-active"]}
          role="tabpanel"
          id={`fh-panel-${i}`}
          aria-labelledby={`fh-tab-${i}`}
          tabindex="0"
        >
          <div class="fh__nums">
            <h3 class="fh__panel-title">{p.pairs[i]}</h3>
            <p class="fh__explain">{fill(p.explain[i]!, tokens)}</p>
            <dl class="fh__stats">
              <div>
                <dt>{p.stats.whole}</dt>
                <dd class="num">{dec(par.coseno)}</dd>
              </div>
              <div>
                <dt>{p.stats.hash}</dt>
                <dd>{fill(p.stats.hashBits, { n: par.hamming })}</dd>
              </div>
              <div>
                <dt>{p.stats.partners}</dt>
                <dd>{fill(p.stats.partnersOf, tokens)}</dd>
              </div>
              <div class:list={["fh__sys", une && "is-on"]}>
                <dt>{p.stats.system}</dt>
                <dd>{fill(une ? p.stats.joins : p.stats.notJoins, tokens)}</dd>
              </div>
            </dl>
          </div>

          <div class="fh__vlm">
            {vlm ? (
              <>
                <p class="fh__vlm-head">
                  <span class="fh__vlm-name">{p.vlm}</span>
                  <strong class={`fh__verdict is-${vlm.mismo_lugar}`}>
                    {p.verdicts[vlm.mismo_lugar as keyof typeof p.verdicts]}
                  </strong>
                </p>
                <div class="fh__vlm-cols">
                  <div>
                    <p class="fh__chips-label">{p.common}</p>
                    <ul class="fh__chips" role="list" lang={vlmLang}>
                      {vlm.en_comun.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <p class="fh__chips-label">{p.differences}</p>
                    <ul class="fh__chips fh__chips--diff" role="list" lang={vlmLang}>
                      {vlm.diferencias.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ul>
                  </div>
                </div>
                <p class="fh__quote" lang={vlmLang}>
                  {vlm.explicacion}
                </p>
              </>
            ) : (
              <p class="fh__vlm-head">
                <span class="fh__vlm-name">{p.vlm}</span>
                <span>{p.noVlm}</span>
              </p>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="fh__foot">
      <p class="fh__note">{p.note}</p>
      <p class="cap">{p.source}</p>
    </div>
  </div>
</section>

<style>
  .fh {
    display: grid;
    gap: 16px;
  }

  /* ---------- Pestañas ---------- */

  :global(.js) .fh__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .fh__tabs {
    display: none;
  }

  .fh__tab {
    flex: none;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--rule);
    border-radius: 999px;
