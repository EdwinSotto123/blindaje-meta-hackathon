    outline-offset: 2px;
  }

  @media (max-width: 719px) {
    :global(.js) .fh__tabs {
      flex-wrap: nowrap;
      margin-inline: calc(var(--margin) * -1);
      padding: 2px var(--margin) 6px;
      overflow-x: auto;
      scrollbar-width: none;
    }
  }

  /* ---------- El escenario: las dos fotos y el dibujo encima ---------- */

  .fh__stage {
    padding: 12px 12px 14px;
    border-radius: var(--r-l);
    background: var(--noche);
    color: var(--fondo);
  }

