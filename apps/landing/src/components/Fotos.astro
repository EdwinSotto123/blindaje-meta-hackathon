    font-weight: 700;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .fh__tab:hover {
    border-color: var(--ink-2);
    color: var(--ink);
  }

  .fh__tab[aria-selected="true"] {
    border-color: var(--tinta);
    background: var(--tinta);
    color: var(--fondo);
  }

