---
/**
 * Hecho con Meta AI, en tres pestañas: los modelos de la Meta Model API, los modelos y librerías
 * abiertas de Meta (nombre, id y su trabajo) y los seis agentes con quién aprueba. Debajo, siempre a
 * la vista, lo que no es de Meta. Sin JavaScript, las tres partes se ven una debajo de otra. El
 * recorrido de la evidencia está animado en Cómo funciona.
 */
import type { Dict } from "../i18n";
import Icon from "./Icon.astro";

interface Props {
  dict: Dict;
}

const { dict: d } = Astro.props;
const t = d.page.tech;
const lp = d.lp.tech;
/** Los usos cortos de page.tech con el id del modelo de tech (mismo orden en los dos grupos). */
const groups = [
  { label: lp.apiLabel, short: t.groups[0]?.rows ?? [], full: d.tech.groups[0]?.rows ?? [] },
  { label: lp.openLabel, short: t.groups[1]?.rows ?? [], full: d.tech.groups[1]?.rows ?? [] },
].map((g) => ({
  label: g.label,
  rows: g.short.map((r, i) => ({ name: r.name, use: r.use, id: g.full[i]?.id ?? "" })),
}));
const cols = d.lang === "es" ? { agent: "Agente", what: "Qué hace" } : { agent: "Agent", what: "What it does" };
---

<section class="section on-paper-2" id="tecnologia" aria-labelledby="tecnologia-title">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <h2 id="tecnologia-title" class="head">
        <span class="tech__line">{t.title[0]}</span> <span class="tech__line">{t.title[1]}</span>
      </h2>
      <p class="lead soft">{t.lead}</p>
    </div>

    <div class="tt" data-tabs>
      <div class="tt__tabs" role="tablist" aria-label={lp.tabsLabel}>
        {lp.tabs.map((label, i) => (
          <button
            type="button"
            class="tt__tab"
            role="tab"
            id={`tt-tab-${i}`}
            aria-controls={`tt-panel-${i}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
          >
            {label}
          </button>
        ))}
      </div>

      {groups.map((g, gi) => (
        <div
          class:list={["tt__panel", gi === 0 && "is-active"]}
          role="tabpanel"
          id={`tt-panel-${gi}`}
          aria-labelledby={`tt-tab-${gi}`}
          tabindex="0"
        >
          <div class="mlist">
            <h3 class="stack__title">
              <Icon name={gi === 0 ? "chip" : "file"} />
              {g.label}
            </h3>
            <ul role="list">
              {g.rows.map((m) => (
                <li>
                  <p>
                    <span class="mlist__name">{m.name}</span>{" "}
                    <code class="mlist__id" translate="no">
                      {m.id}
                    </code>
                  </p>
                  <p class="mlist__use soft">{m.use}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}

      <div class="tt__panel" role="tabpanel" id="tt-panel-2" aria-labelledby="tt-tab-2" tabindex="0">
        <div class="agents">
          <h3 class="stack__title">
            <Icon name="user" />
            {lp.agentsTitle}
          </h3>
          <p class="soft small">{lp.agentsLead}</p>
          <table class="agt">
            <thead>
              <tr>
                <th scope="col">{cols.agent}</th>
                <th scope="col">{cols.what}</th>
                <th scope="col">{t.approves}</th>
              </tr>
            </thead>
            <tbody>
              {t.agents.map((a) => (
                <tr>
                  <th scope="row">{a.name}</th>
                  <td class="soft">{a.what}</td>
                  <td class="agt__ok">
                    <Icon name="check" />
                    {a.approves}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="honest" data-reveal>
      <Icon name="alert" />
      <div>
        <p class="honest__title">{d.tech.honestTitle}</p>
        {d.tech.honest.map((h) => (
          <p class="soft small">{h}</p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Pestañas (como las de Producto) ---------- */

  .tt {
    display: grid;
    gap: 28px;
  }

  .tt__tabs {
    display: none;
  }

  /* Sin JavaScript, las tres partes se apilan con aire entre ellas. */
  .tt__panel + .tt__panel {
    margin-top: 48px;
  }

  .tt__panel:focus-visible {
    outline: 3px solid var(--terracota);
    outline-offset: 6px;
    border-radius: 8px;
  }

  :global(.js) .tt__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tt__tab {
    flex: none;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink-2);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .tt__tab:hover {
    border-color: var(--ink-2);
    color: var(--ink);
  }

  .tt__tab[aria-selected="true"] {
    border-color: var(--tinta);
    background: var(--tinta);
    color: var(--fondo);
  }

  .tt__tab:focus-visible {
    outline: 3px solid var(--terracota);
    outline-offset: 2px;
  }

  :global(.js) .tt__panel {
    display: none;
  }

  :global(.js) .tt__panel + .tt__panel {
    margin-top: 0;
  }

  :global(.js) .tt__panel.is-active {
    display: block;
  }

  /* En pantallas anchas, cada lista de modelos en dos columnas: la pestaña no crece hacia abajo. */
  @media (min-width: 900px) {
    .mlist ul {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 48px;
    }
  }

  @media (max-width: 719px) {
    :global(.js) .tt__tabs {
      flex-wrap: nowrap;
      margin-inline: calc(var(--margin) * -1);
      padding: 2px var(--margin) 6px;
      overflow-x: auto;
      scrollbar-width: none;
    }
  }

  .honest {
    margin-top: 40px;
  }

  .tech__line {
    display: block;
  }

  .stack__title,
  .honest__title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--step-lead);
    font-weight: 700;
    line-height: 1.25;
  }

  .stack__title :global(.icon),
  .honest > :global(.icon) {
    flex: none;
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- Modelos: nombre e id en una línea, su trabajo debajo ---------- */

  .mlist {
    display: grid;
    gap: 8px;
  }

  .mlist ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mlist li {
    display: grid;
    gap: 2px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }

  .mlist li:last-child {
    border-bottom: 0;
  }

  .mlist__name {
    font-weight: 700;
  }

  .mlist__id {
    margin-left: 4px;
    color: var(--cuenta-ink);
    font-size: var(--step-small);
    white-space: nowrap;
  }

  /* ---------- Agentes: una tabla real ---------- */

  .agents {
    display: grid;
    gap: 12px;
  }

  .agt {
    width: 100%;
    border-collapse: collapse;
    line-height: 1.35;
  }

  .agt th,
  .agt td {
    padding: 12px 12px 12px 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: baseline;
  }

  .agt tbody tr:last-child > * {
    border-bottom: 0;
  }

  .agt thead th {
    padding-top: 4px;
    border-bottom: 2px solid var(--ink);
    color: var(--ink-2);
    font-size: var(--step-small);
  }

  .agt__ok {
    color: var(--num-ink);
    font-weight: 700;
    white-space: nowrap;
  }

  .agt__ok :global(.icon) {
    display: inline-block;
    width: 16px;
    height: 16px;
    margin-right: 4px;
    vertical-align: -2px;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* En el celular, cada agente es una fila apilada: nombre, qué hace y quién aprueba. */
  @media (max-width: 599px) {
    .agt thead {
      display: none;
    }

    .agt tr {
      display: grid;
      gap: 2px;
      padding: 12px 0;
      border-bottom: 1px solid var(--rule);
    }

    .agt tbody tr:last-child {
      border-bottom: 0;
    }

    .agt th,
    .agt td {
      padding: 0;
      border: 0;
    }
  }

  .honest {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 14px;
    padding: 22px 24px;
    border-radius: var(--radius);
    background: var(--card);
  }

  .honest > div {
    display: grid;
    gap: 8px;
  }

  .honest .small {
    max-width: 36em;
  }

  .honest > :global(.icon) {
    margin-top: 3px;
    color: var(--cuenta-ink);
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-tabs]")) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute("aria-controls") ?? ""));
    const select = (i: number, focus: boolean) => {
      tabs.forEach((t, j) => {
        const on = j === i;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        panels[j]?.classList.toggle("is-active", on);
      });
      if (focus) {
        tabs[i]?.focus();
        tabs[i]?.scrollIntoView({ block: "nearest", inline: "nearest" });
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i, false));
      t.addEventListener("keydown", (e) => {
        const last = tabs.length - 1;
        const next =
          e.key === "ArrowRight"
            ? i === last
              ? 0
              : i + 1
            : e.key === "ArrowLeft"
              ? i === 0
                ? last
                : i - 1
              : e.key === "Home"
                ? 0
                : e.key === "End"
                  ? last
                  : -1;
        if (next < 0) return;
        e.preventDefault();
        select(next, true);
      });
    });
  }
</script>
