{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js", ".prettierrc.json"],
  "envMode": "loose",
  "tasks": {
    "transit": { "dependsOn": ["^transit"] },
    "typecheck": { "dependsOn": ["transit"], "outputs": [] },
    "lint": { "dependsOn": ["transit"], "outputs": [] },
    "test": { "dependsOn": ["transit"], "outputs": [] },
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_*", "PUBLIC_*"],
      "outputs": ["dist/**"]
    }
  }
}
