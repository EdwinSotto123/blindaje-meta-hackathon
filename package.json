{
  "name": "blindaje",
  "private": true,
  "version": "0.1.0",
  "description": "Blindaje: inteligencia comunitaria contra la extorsión. Meta Global AI Developer Hackathon 2026.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "demo:seed": "pnpm --filter @blindaje/eval demo:seed",
    "demo:reset": "pnpm --filter @blindaje/eval demo:reset",
    "eval": "pnpm --filter @blindaje/eval eval",
    "check": "turbo run typecheck lint test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "type": "module"
}
